name: {%.Package%}
description: {%json .Name%}
publish_to: none
version: {%.AppVersion%}

environment:
  sdk: ^3.13.0
  flutter: ">=3.47.0"

dependencies:
  flutter:
    sdk: flutter
{%- if .PluxPath%}
  plux_flutter:
    path: {%.PluxPath%}
{%- else%}
  plux_flutter: {%.RuntimeConstraint%}
{%- end%}
  # The debug overlay and dev-session pairing of debug builds (DEV-040);
  # release builds contain none of it (DEV-050).
{%- if .PluxPath%}
  plux_devtools:
    path: {%.DevtoolsPath%}
{%- else%}
  plux_devtools: {%.DevtoolsConstraint%}
{%- end%}
{%- range .RouterDeps%}
{%- if .Path%}
  {%.Name%}:
    path: {%.Path%}
{%- else%}
  {%.Name%}: {%.Constraint%}
{%- end%}
{%- end%}

dev_dependencies:
  flutter_test:
    sdk: flutter
  integration_test:
    sdk: flutter
{%- if .PluxPath%}

# plux_devtools and the adapters depend on a release of plux_flutter; the
# checkout is the one the app builds against.
dependency_overrides:
  plux_flutter:
    path: {%.PluxPath%}
{%- end%}

flutter:
  uses-material-design: true
  # The release the app starts with, verified before it loads (SYN-007);
  # asset directories are not recursive, so each one is listed.
  assets:
    - assets/plux/
    - assets/plux/bundles/
{%- if .BaselineAssets%}
    - assets/plux/assets/
{%- end%}
