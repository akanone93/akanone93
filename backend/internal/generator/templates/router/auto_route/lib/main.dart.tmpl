import 'package:auto_route/auto_route.dart';
import 'package:flutter/foundation.dart';
import 'package:flutter/material.dart';
import 'package:plux_auto_route/plux_auto_route.dart';
import 'package:plux_devtools/plux_devtools.dart';
import 'package:plux_flutter/plux_flutter.dart';

import 'plux/plux_options.g.dart';

/// {%.Name%}, a Plux app. Its screens, flows and content ship as Plux
/// releases, without a new build (GEN-005); this shell changes only for a
/// new store build.
///
/// The app's RootStackRouter holds the entry page at '/' and the Plux pages
/// at /plux/<route-name>, through which Plux navigates (NAV-006).
Future<void> main() async {
  WidgetsFlutterBinding.ensureInitialized();
  WidgetsBinding.instance.addObserver(_Links());
  final plux = PluxAutoRoutes();
  final router = RootStackRouter.build(
    routes: [
      NamedRouteDef(
        name: 'home',
        path: '/',
        builder: (context, data) => const _Home(),
      ),
      ...plux.routes,
    ],
  );
  await Plux.initialize(
    PluxConfig(
      appId: PluxOptions.appId,
      endpoint: Uri.parse(PluxOptions.endpoint),
      environment: PluxOptions.environment,
      channel: PluxOptions.channel,
      rootKeys: PluxOptions.rootKeys,
      router: PluxAutoRoute(router),
    ),
  );
  // A debug build pairs with a Studio dev session and shows the Plux debug
  // overlay (DEV-040); a release build has neither, nor any code of
  // plux_devtools (DEV-050).
  final devSession = kDebugMode
      ? PluxDevSession(devRootKeys: PluxOptions.devRootKeys)
      : null;
  runApp(
    PluxScope(
      child: MaterialApp.router(
        title: '{%dart .Name%}',
        routerConfig: router.config(),
        debugShowCheckedModeBanner: false,
        // The overlay only in debug builds, so that a release build holds
        // none of plux_devtools (DEV-050).
        builder: kDebugMode
            ? (context, child) =>
                  PluxDevtools(session: devSession, child: child!)
            : null,
      ),
    ),
  );
}

/// The app's entry page: the entry route its release names.
class _Home extends StatelessWidget {
  const _Home();

  @override
  Widget build(BuildContext context) => Scaffold(
    // The entry route the release names (app.json's entryRoute), so the app
    // opens where its project says; the route this shell was generated with
    // only until a release names one.
    body: ValueListenableBuilder<String?>(
      valueListenable: Plux.entryRoute,
      builder: (context, route, _) => PluxView(
        route ?? '{%.Plux.EntryRoute%}',
        loadingBuilder: (_) => const Center(
          key: ValueKey('plux-loading'),
          child: CircularProgressIndicator(),
        ),
        fallbackBuilder: (_, error) => Center(
          key: const ValueKey('plux-unavailable'),
          child: Text('Not available (${error.code.id})'),
        ),
      ),
    ),
  );
}

/// Hands the links the app is opened with to Plux, which maps them to
/// pages through the app's deep links (NAV-008).
final class _Links with WidgetsBindingObserver {
  @override
  Future<bool> didPushRouteInformation(RouteInformation routeInformation) =>
      Plux.handleDeepLink(routeInformation.uri);
}
