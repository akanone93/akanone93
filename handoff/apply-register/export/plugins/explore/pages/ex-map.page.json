{
  "id": "01a2e2cb-f0f7-7ca3-b328-82e35b76968f",
  "key": "ex-map",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "requestPermission",
          "branches": {
            "denied": "no",
            "granted": "loc"
          },
          "id": "ask",
          "input": {
            "permission": "location"
          }
        },
        {
          "action": "getLocation",
          "id": "loc",
          "input": {
            "accuracy": "balanced"
          },
          "next": "here",
          "onError": "lost",
          "retry": {
            "count": 1,
            "on": [
              "timeout"
            ]
          }
        },
        {
          "action": "setState",
          "id": "here",
          "input": {
            "path": "page.lat",
            "value": {
              "$expr": "steps.loc.output?.latitude ?? page.lat"
            }
          },
          "next": "lng"
        },
        {
          "action": "setState",
          "id": "lng",
          "input": {
            "path": "page.lng",
            "value": {
              "$expr": "steps.loc.output?.longitude ?? page.lng"
            }
          },
          "next": "calm"
        },
        {
          "action": "setState",
          "id": "calm",
          "input": {
            "path": "page.locating",
            "value": false
          }
        },
        {
          "action": "showSnackbar",
          "id": "lost",
          "input": {
            "message": {
              "$t": "01a2375a-c699-7ee5-983e-459809db8567"
            }
          },
          "next": "calm"
        },
        {
          "action": "showSnackbar",
          "id": "no",
          "input": {
            "message": {
              "$t": "01a2f1e8-46c4-7535-86a0-9bd0136b312e"
            }
          }
        }
      ]
    }
  },
  "pageKind": "screen",
  "root": {
    "id": "01a256c4-75f2-796b-8e8b-4cc82c00f6d9",
    "slots": {
      "body": {
        "children": [
          {
            "events": {
              "onCameraIdle": {
                "concurrency": "debounce:500",
                "steps": [
                  {
                    "action": "setState",
                    "id": "move",
                    "input": {
                      "path": "page.lat",
                      "value": {
                        "$expr": "event.center.lat"
                      }
                    },
                    "next": "lng"
                  },
                  {
                    "action": "setState",
                    "id": "lng",
                    "input": {
                      "path": "page.lng",
                      "value": {
                        "$expr": "event.center.lng"
                      }
                    },
                    "next": "load"
                  },
                  {
                    "action": "refreshData",
                    "id": "load",
                    "input": {
                      "source": "orgs"
                    }
                  }
                ]
              },
              "onMarkerTap": {
                "steps": [
                  {
                    "action": "openBottomSheet",
                    "id": "peek",
                    "input": {
                      "params": {
                        "slug": {
                          "$expr": "event"
                        }
                      },
                      "route": "ex-peek"
                    },
                    "next": "act"
                  },
                  {
                    "action": "condition",
                    "branches": {
                      "then": "go"
                    },
                    "id": "act",
                    "input": {
                      "when": {
                        "$expr": "steps.peek.output != null"
                      }
                    }
                  },
                  {
                    "action": "navigate",
                    "id": "go",
                    "input": {
                      "params": {
                        "slug": {
                          "$expr": "event"
                        }
                      },
                      "route": "ex-org"
                    }
                  }
                ]
              }
            },
            "id": "01a2f653-82b1-7a34-b08c-8a4763bbcdb9",
            "props": {
              "attribution": {
                "$t": "01a264c2-cc1f-78e8-b26f-fa0bd0ad379a"
              },
              "center": {
                "lat": {
                  "$expr": "page.lat"
                },
                "lng": {
                  "$expr": "page.lng"
                }
              },
              "maxZoom": 18,
              "minZoom": 3,
              "semanticLabel": {
                "$t": "01a2f03e-8c59-7939-a8bb-6c4eca1add86"
              },
              "showUserLocation": true,
              "tileUrlTemplate": {
                "$expr": "env.mapTiles"
