{
  "id": "01a21662-247b-72b1-b3b0-da4acdccc939",
  "key": "ex-scan",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "requestPermission",
          "id": "ask",
          "input": {
            "permission": "camera"
          }
        }
      ]
    }
  },
  "pageKind": "screen",
  "root": {
    "id": "01a249d8-c733-7295-84fc-e95ed980ebba",
    "props": {
      "backgroundColor": {
        "$token": "color.scrim"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a28152-8cd3-75db-bc3f-b900fcc00a62",
        "props": {
          "backgroundColor": {
            "$token": "color.scrim"
          },
          "foregroundColor": {
            "$token": "color.onPrimary"
          }
        },
        "slots": {
          "title": {
            "id": "01a20f86-01af-704a-92c0-ba5e0d4458f2",
            "props": {
              "data": {
                "$t": "01a2ce1e-8820-7d4a-a7bf-b5a2984b369c"
              }
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "children": [
          {
            "events": {
              "onDetected": {
                "concurrency": "drop",
                "steps": [
                  {
                    "action": "condition",
                    "branches": {
                      "else": "buzz",
                      "then": "go"
                    },
                    "id": "ours",
                    "input": {
                      "when": {
                        "$expr": "matches(event.value, \"^https://applyregister\\\\.app/o/[a-z0-9-]{1,40}$\")"
                      }
                    }
                  },
                  {
                    "action": "navigate",
                    "id": "go",
                    "input": {
                      "mode": "replace",
                      "params": {
                        "slug": {
                          "$expr": "substring(event.value, 28)"
                        }
                      },
                      "route": "ex-org"
                    }
                  },
                  {
                    "action": "haptic",
                    "id": "buzz",
                    "input": {
                      "pattern": "vibrate"
                    },
                    "next": "say"
                  },
                  {
                    "action": "showSnackbar",
                    "id": "say",
                    "input": {
                      "message": {
                        "$t": "01a2d2b4-2f89-773c-bc52-96fe2ac117db"
                      }
                    }
                  }
                ]
              },
              "onError": {
                "steps": [
                  {
                    "action": "showSnackbar",
                    "id": "say",
                    "input": {
                      "message": {
                        "$t": "01a2c442-fb6d-702a-a1c8-752b7db0bc33"
                      }
                    }
                  }
                ]
              }
            },
            "id": "01a2735e-ea45-7389-be9b-a70a70e0e188",
            "props": {
              "cameraFacing": "back",
              "continuous": false,
              "overlayHint": {
                "$t": "01a21d56-907d-72d4-9783-33f49e895228"
              },
              "semanticLabel": {
                "$t": "01a2ce1e-8820-7d4a-a7bf-b5a2984b369c"
              },
              "torch": {
                "$expr": "page.torch"
              }
            },
            "testId": "scan-camera",
            "type": "QrScanner"
          },
          {
            "id": "01a26f04-8d51-7517-aca8-15e63d658ceb",
            "props": {
              "alignment": "bottomCenter"
            },
            "slots": {
              "child": {
                "id": "01a20584-133d-7bd5-aedd-a84012bc03d1",
                "slots": {
                  "child": {
                    "id": "01a2e848-1bbe-7817-a173-bbf2f2600a7d",
                    "props": {
                      "padding": {
                        "all": 24
                      }
                    },
                    "slots": {
                      "child": {
                        "children": [
                          {
                            "events": {
                              "onPressed": {
                                "steps": [
                                  {
                                    "action": "setState",
                                    "id": "flip",
                                    "input": {
                                      "path": "page.torch",
                                      "value": {
                                        "$expr": "!page.torch"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a21ea5-2be9-731c-b4ea-2e1e1c2b85f6",
                            "props": {
                              "style": {
                                "backgroundColor": {
                                  "value": {
                                    "$token": "color.surface"
                                  }
                                }
                              },
                              "tooltip": {
                                "$t": "01a23bd9-e475-7750-8a44-2519f5da452a"
                              }
                            },
                            "slots": {
                              "icon": {
                                "id": "01a2d1c9-5c44-7c91-be64-a490e8fe607c",
                                "props": {
                                  "icon": {
                                    "name": "flashlight_on"
                                  }
                                },
                                "semantics": {
                                  "decorative": true
                                },
                                "type": "Icon"
                              }
                            },
                            "testId": "scan-torch",
                            "type": "IconButton"
                          },
                          {
                            "events": {
                              "onPressed": {
                                "concurrency": "drop",
                                "steps": [
                                  {
                                    "action": "scanCode",
                                    "id": "s",
                                    "input": {
                                      "formats": [
                                        "qrCode"
                                      ]
                                    },
                                    "next": "ours"
                                  },
                                  {
                                    "action": "condition",
                                    "branches": {
                                      "else": "buzz",
                                      "then": "go"
                                    },
                                    "id": "ours",
                                    "input": {
                                      "when": {
                                        "$expr": "matches((steps.s.output?.value ?? \"\"), \"^https://applyregister\\\\.app/o/[a-z0-9-]{1,40}$\")"
                                      }
                                    }
                                  },
                                  {
                                    "action": "navigate",
                                    "id": "go",
                                    "input": {
                                      "mode": "replace",
                                      "params": {
                                        "slug": {
                                          "$expr": "substring((steps.s.output?.value ?? \"\"), 28)"
                                        }
                                      },
                                      "route": "ex-org"
                                    }
                                  },
                                  {
                                    "action": "haptic",
                                    "id": "buzz",
                                    "input": {
                                      "pattern": "vibrate"
                                    },
                                    "next": "say"
                                  },
                                  {
                                    "action": "showSnackbar",
                                    "id": "say",
                                    "input": {
                                      "message": {
                                        "$t": "01a2d2b4-2f89-773c-bc52-96fe2ac117db"
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a236d0-f550-7f7a-94b4-27064c4e8557",
                            "slots": {
                              "child": {
                                "id": "01a26d31-8ebe-75f6-b1e9-76fa9122f815",
                                "props": {
                                  "data": {
                                    "$t": "01a22f1b-d818-778b-b623-9b83fa04d9f9"
                                  }
                                },
                                "type": "Text"
                              }
                            },
                            "testId": "scan-system",
                            "type": "FilledButton"
                          }
                        ],
                        "id": "01a2e6ea-edd3-7221-a803-8953f6818285",
                        "props": {
                          "mainAxisAlignment": "center",
                          "spacing": 16
                        },
                        "type": "Row"
                      }
                    },
                    "type": "Padding"
                  }
                },
                "type": "SafeArea"
              }
            },
            "type": "Align"
          }
        ],
        "id": "01a22415-f17a-7397-a63a-6c5f9f968967",
        "props": {
          "fit": "expand"
        },
        "type": "Stack"
      }
    },
    "type": "Scaffold"
  },
  "route": "ex-scan",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": false,
      "id": "01a2fbf0-3161-75f9-93ba-d35ccf3a7dab",
      "name": "torch",
      "type": "bool"
    }
  ],
  "title": {
    "$t": "01a2ce1e-8820-7d4a-a7bf-b5a2984b369c"
  }
}
