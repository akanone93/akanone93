{
  "description": "Whether an e-mail may start a new partner request: null when free, else why not. The field's value arrives as the event.",
  "id": "01a26fd6-912b-78cf-a9b5-9e86327bfaa0",
  "key": "check-email",
  "kind": "actionGraph",
  "output": "string?",
  "schemaVersion": "1.0.0",
  "steps": [
    {
      "action": "apiCall",
      "id": "ask",
      "input": {
        "input": {
          "email": {
            "$expr": "event"
          }
        },
        "operation": "partner.emailFree"
      },
      "next": "free"
    },
    {
      "action": "condition",
      "branches": {
        "else": "no",
        "then": "ok"
      },
      "id": "free",
      "input": {
        "when": {
          "$expr": "steps.ask.output?.free ?? true"
        }
      }
    },
    {
      "action": "stop",
      "id": "ok",
      "input": {}
    },
    {
      "action": "stop",
      "id": "no",
      "input": {
        "result": {
          "$t": "01a27527-cc3a-7470-bc52-d56375124194"
        }
      }
    }
  ]
}
