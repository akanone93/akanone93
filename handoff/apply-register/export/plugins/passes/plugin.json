  "team": "apply-register",
  "triggers": {
    "onAppResume": {
      "concurrency": "queue",
      "steps": [
        {
          "action": "refreshData",
          "id": "load",
          "input": {
            "source": "remote"
          },
          "next": "keep"
        },
        {
          "action": "forEach",
          "branches": {
            "body": "put"
          },
          "id": "keep",
          "input": {
            "items": {
              "$expr": "data.remote.value ?? []"
            }
          }
        },
        {
          "action": "dbUpsert",
          "id": "put",
          "input": {
            "collection": "registrations",
            "key": {
              "$expr": "item.id"
            },
            "record": {
              "$expr": "item"
            }
          }
        }
      ]
    }
  }
