                      "onTap": {
                        "steps": [
                          {
                            "action": "openDialog",
                            "id": "ask",
                            "input": {
                              "params": {
                                "id": {
                                  "$expr": "item.id"
                                }
                              },
                              "route": "ps-draft"
                            },
                            "next": "pick"
                          },
                          {
                            "action": "switch",
                            "branches": {
                              "discard": "discard",
                              "resume": "resume"
                            },
                            "id": "pick",
                            "input": {
                              "cases": [
                                "resume",
                                "discard"
                              ],
                              "value": {
                                "$expr": "steps.ask.output ?? \"\""
                              }
                            }
                          },
                          {
                            "action": "navigate",
                            "id": "resume",
                            "input": {
                              "params": {
                                "slug": {
                                  "$expr": "item.orgSlug"
                                }
                              },
                              "route": "ex-org"
                            }
                          },
                          {
                            "action": "dbDelete",
                            "id": "discard",
                            "input": {
                              "collection": "registrations",
                              "key": {
                                "$expr": "item.id"
                              }
                            }
                          }
                        ]
                      }
