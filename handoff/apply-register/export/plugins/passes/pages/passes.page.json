        "type": "AppBar"
      },
      "body": {
        "children": [
          {
            "events": {
              "onReorder": {
                "steps": [
                  {
                    "action": "dbUpdate",
                    "id": "move",
                    "input": {
                      "collection": "registrations",
                      "key": {
                        "$expr": "at(data.active.value ?? [], event[\"oldIndex\"] ?? 0)?.id ?? \"\""
                      },
                      "patch": {
                        "rank": {
                          "$expr": "event[\"newIndex\"] ?? 0"
                        }
                      }
                    }
                  }
                ]
