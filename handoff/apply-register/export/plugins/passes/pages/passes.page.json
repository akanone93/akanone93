          "actions": [
            {
              "events": {
                "onPressed": {
                  "concurrency": "drop",
                  "steps": [
                    {
                      "action": "refreshData",
                      "id": "load",
                      "input": {
                        "source": "remote"
                      },
                      "next": "keep"
                    },
                    {
                      "action": "forEach",
                      "branches": {
                        "body": "put"
                      },
                      "id": "keep",
                      "input": {
                        "items": {
                          "$expr": "data.remote.value ?? []"
                        }
                      }
                    },
                    {
                      "action": "dbUpsert",
                      "id": "put",
                      "input": {
                        "collection": "registrations",
                        "key": {
                          "$expr": "item.id"
                        },
                        "record": {
                          "$expr": "item"
                        }
                      }
                    }
                  ]
                }
              },
              "id": "01a2dbff-3d18-7edf-8037-12788b3067cd",
              "props": {
                "tooltip": {
                  "$t": "01a2cdb6-0dd7-70c6-815c-707e1c7552de"
