{
  "id": "01a26889-ff1c-74cb-90f2-0eef842b2195",
  "key": "vf-id",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "requestPermission",
          "id": "ask",
          "input": {
            "permission": "camera"
          }
        }
      ]
    }
  },
  "pageKind": "fullscreenDialog",
  "result": "VerifyResult",
  "root": {
    "id": "01a2a198-861c-75e8-b516-602e9f3af91f",
    "props": {
      "backgroundColor": {
        "$token": "color.scrim"
      }
    },
    "slots": {
      "body": {
        "children": [
          {
            "events": {
              "onCaptured": {
                "concurrency": "drop",
                "steps": [
                  {
                    "action": "apiCall",
                    "id": "up",
                    "input": {
                      "input": {
                        "file": {
                          "$expr": "event"
                        }
                      },
                      "operation": "verify.upload"
                    },
                    "next": "ok",
                    "onError": "fail"
                  },
                  {
                    "action": "pop",
                    "id": "ok",
                    "input": {
                      "result": {
                        "value": {
                          "$expr": "steps.up.output?.fileId ?? \"\""
                        },
                        "verified": true
                      }
                    }
                  },
                  {
                    "action": "showSnackbar",
                    "id": "fail",
                    "input": {
                      "message": {
                        "$t": "01a29a30-e26a-7f45-9359-c2c3dddb4b41"
                      }
                    }
                  }
                ]
              }
            },
            "id": "01a209da-4471-7c21-b177-03895a5ae1d9",
            "props": {
              "mode": "document"
            },
            "semantics": {
              "label": {
                "$t": "01a2a996-20d5-7806-b906-04e4960e7c73"
              }
            },
            "testId": "vf-id-camera",
            "type": "KycCameraCapture"
          },
          {
            "id": "01a21576-b14b-76e5-9322-7b3d67e1324d",
            "props": {
              "alignment": "topCenter"
            },
            "slots": {
              "child": {
                "id": "01a27028-f8da-7186-be49-59baf692d9fd",
                "slots": {
                  "child": {
                    "id": "01a2d2dd-8f7b-7002-9863-1f366d0b5cd7",
                    "props": {
                      "decoration": {
                        "borderRadius": {
                          "all": {
                            "$token": "radius.md"
                          }
                        },
                        "color": {
                          "$token": "color.inverseSurface"
                        }
                      },
                      "margin": {
                        "all": 16
                      },
                      "padding": {
                        "all": 8
                      }
                    },
                    "slots": {
                      "child": {
                        "children": [
                          {
                            "events": {
                              "onPressed": {
                                "steps": [
                                  {
                                    "action": "pop",
                                    "id": "no",
                                    "input": {
                                      "result": {
                                        "value": null,
                                        "verified": false
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a248e8-4523-7314-b422-5ae47b40278a",
                            "props": {
                              "color": {
                                "$token": "color.onInverseSurface"
                              }
                            },
                            "semantics": {
                              "label": {
                                "$t": "01a23542-43c9-703c-8d4e-a4320d2855b0"
                              }
                            },
                            "testId": "vf-id-close",
                            "type": "CloseButton"
                          },
                          {
                            "id": "01a2b50d-b4f8-7687-801d-36c027f44867",
                            "slots": {
                              "child": {
                                "id": "01a22c37-4fc8-76ed-924c-81067cf9a4a8",
