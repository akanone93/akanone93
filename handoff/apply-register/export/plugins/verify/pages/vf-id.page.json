                      }
                    },
                    "type": "Container"
                  }
                },
                "type": "SafeArea"
              }
            },
            "type": "Align"
          }
        ],
        "id": "01a23a2d-5134-763b-9ade-f69370c65cbe",
        "props": {
          "fit": "expand"
        },
        "type": "Stack"
      }
    },
    "type": "Scaffold"
  },
  "route": "vf-id",
  "schemaVersion": "1.0.0",
