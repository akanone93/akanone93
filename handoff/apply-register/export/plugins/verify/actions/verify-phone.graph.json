{
  "description": "Sends a code to a phone and returns whether the person entered it.",
  "exported": true,
  "id": "01a22730-2d8c-7136-af60-680ba41bf644",
  "inputs": [
    {
      "id": "01a2192c-652e-796d-ba49-aaa7305e9a83",
      "mock": "+491701234567",
      "name": "phone",
      "required": true,
      "type": "string"
    }
  ],
  "key": "verify-phone",
  "kind": "actionGraph",
  "output": "VerifyResult",
  "schemaVersion": "1.0.0",
  "steps": [
    {
      "action": "apiCall",
      "id": "send",
      "input": {
        "input": {
          "phone": {
            "$expr": "params.phone"
          }
        },
        "operation": "verify.otpStart"
      },
      "next": "ask"
    },
    {
      "action": "openBottomSheet",
      "id": "ask",
      "input": {
        "params": {
          "phone": {
            "$expr": "params.phone"
          }
        },
        "route": "vf-otp"
      },
      "next": "got"
    },
    {
      "action": "condition",
      "branches": {
        "else": "no",
        "then": "yes"
      },
      "id": "got",
      "input": {
        "when": {
          "$expr": "steps.ask.output != null"
        }
      }
    },
    {
      "action": "stop",
      "id": "yes",
      "input": {
        "result": {
          "$expr": "steps.ask.output"
        }
      }
    },
    {
      "action": "stop",
      "id": "no",
      "input": {
        "result": {
          "value": null,
          "verified": false
        }
      }
    }
  ]
}
