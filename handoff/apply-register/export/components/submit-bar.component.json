{
  "description": "A screen's primary action at its foot, busy while it works, with an optional secondary action.",
  "events": [
    {
      "name": "onSubmit"
    },
    {
      "name": "onSecondary"
    }
  ],
  "id": "01a2b909-cbad-77df-b6b6-d36ce2fb1df9",
  "key": "submit-bar",
  "kind": "component",
  "name": "SubmitBar",
  "props": [
    {
      "name": "label",
      "required": true,
      "type": "string"
    },
    {
      "default": false,
      "name": "busy",
      "type": "bool"
    },
    {
      "default": true,
      "name": "enabled",
      "type": "bool"
    },
    {
      "name": "secondaryLabel",
      "type": "string?"
    }
  ],
  "root": {
    "id": "01a2805e-93ae-7df7-a66f-5406174fb105",
    "props": {
      "top": false
    },
    "slots": {
      "child": {
        "id": "01a21ff2-9a60-7e74-8175-f3fc577c3a1e",
        "props": {
          "padding": {
            "all": 16
          }
        },
        "slots": {
          "child": {
            "children": [
              {
                "id": "01a293fc-0c7a-7188-a12d-fe291b3a8d30",
                "props": {
                  "condition": {
                    "$expr": "props.secondaryLabel != null"
                  }
                },
                "slots": {
                  "then": {
                    "events": {
                      "onPressed": {
                        "steps": [
                          {
                            "action": "emitEvent",
                            "id": "emit",
                            "input": {
                              "event": "onSecondary"
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a2c982-7117-7eb2-b3ab-ef0055e1cdc4",
                    "slots": {
                      "child": {
                        "id": "01a25be2-410c-71c7-b815-fc56c8bf1da3",
                        "props": {
                          "data": {
                            "$expr": "props.secondaryLabel ?? \"\""
                          }
                        },
                        "type": "Text"
                      }
                    },
                    "type": "TextButton"
                  }
                },
                "type": "If"
              },
              {
                "id": "01a203c5-b6f2-7106-ab85-681a4643e870",
                "slots": {
                  "child": {
                    "events": {
                      "onPressed": {
                        "concurrency": "drop",
                        "steps": [
                          {
                            "action": "condition",
                            "branches": {
                              "then": "emit"
                            },
                            "id": "when",
                            "input": {
                              "when": {
                                "$expr": "props.enabled && !props.busy"
                              }
                            }
                          },
                          {
                            "action": "emitEvent",
                            "id": "emit",
                            "input": {
                              "event": "onSubmit"
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a25f3d-339f-7482-b426-7d14f8742523",
                    "props": {
                      "style": {
                        "minimumSize": {
                          "value": {
                            "height": 52,
                            "width": 64
                          }
                        }
                      }
                    },
                    "slots": {
                      "child": {
                        "id": "01a2239d-be86-7c3a-8e4c-e7469bfb2371",
                        "props": {
                          "duration": 200
                        },
                        "slots": {
                          "child": {
                            "id": "01a2b6cd-9ec0-71e2-a075-b866b51eeae2",
                            "props": {
                              "condition": {
                                "$expr": "props.busy"
                              }
                            },
                            "slots": {
                              "else": {
                                "id": "01a2104e-5b0d-7cba-9f30-cc15d94e17fb",
                                "props": {
                                  "data": {
                                    "$expr": "props.label"
                                  }
                                },
                                "type": "Text"
                              },
                              "then": {
                                "id": "01a2367f-382a-7e5f-b245-e39783018a36",
                                "props": {
                                  "height": 20,
                                  "width": 20
                                },
                                "slots": {
                                  "child": {
                                    "id": "01a23d50-56d1-7563-adb5-ab116040110a",
                                    "props": {
                                      "color": {
                                        "$token": "color.onPrimary"
                                      },
                                      "strokeWidth": 2
                                    },
                                    "type": "CircularProgressIndicator"
                                  }
                                },
                                "type": "SizedBox"
                              }
                            },
                            "type": "If"
                          }
                        },
                        "type": "AnimatedSwitcher"
                      }
                    },
                    "type": "FilledButton"
                  }
                },
                "type": "Expanded"
              }
            ],
            "id": "01a229c2-6a77-79c7-ab67-4fa952061526",
            "type": "Row"
          }
        },
        "type": "Padding"
      }
    },
    "type": "SafeArea"
  },
  "schemaVersion": "1.0.0",
  "version": 1
}
