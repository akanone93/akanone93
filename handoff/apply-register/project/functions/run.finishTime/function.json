{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bd4b-7025-8a7c-d553c9c50990",
  "name": "run.finishTime",
  "description": "The finish time a pace gives over a distance.",
  "placement": "device",
  "capabilities": {},
  "tests": [
    {
      "name": "10 km at 5 minutes",
      "input": {
        "distanceKm": "10",
        "paceSecPerKm": 300
      },
      "output": {
        "minutes": 50,
        "label": "00:50:00"
      }
    },
    {
      "name": "too fast to be real",
      "input": {
        "distanceKm": "10",
        "paceSecPerKm": 120
      },
      "error": {
        "code": "PACE_UNREALISTIC"
      }
    }
  ]
}
