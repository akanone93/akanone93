{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bdbf-71ad-96e0-200454a39ddf",
  "name": "reminders.daily",
  "description": "Run daily: reads the reminders due today and asks the API to push them.",
  "placement": "server",
  "capabilities": {
    "http": [
      "api.applyregister.app",
      "api.dev.applyregister.app",
      "api.staging.applyregister.app"
    ],
    "secrets": [
      "AR_PARTNER_KEY"
    ]
  },
  "env": [
    "AR_BASE"
  ],
  "limits": {
    "timeoutMs": 10000
  },
  "assurance": "AL0",
  "tests": [
    {
      "name": "a limit of zero is refused",
      "input": {
        "limit": 0
      },
      "error": {
        "code": "LIMIT_INVALID"
      }
    },
    {
      "name": "without the API it is down",
      "input": {
        "limit": 5
      },
      "error": {
        "code": "UPSTREAM_DOWN"
      }
    }
  ]
}
