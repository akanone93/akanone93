{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bd77-74ae-8e94-f6dcd75b2cfe",
  "name": "slots.availability",
  "description": "The clinic's free half-hour slots on a day, 09:00 to 16:30; closed on Sundays.",
  "placement": "server",
  "capabilities": {
    "kv": true
  },
  "tests": [
    {
      "name": "Sunday is closed",
      "input": {
        "clinic": "willow",
        "date": "2000-01-02"
      },
      "error": {
        "code": "CLOSED"
      }
    },
    {
      "name": "a past day is refused",
      "input": {
        "clinic": "willow",
        "date": "2000-01-03"
      },
      "error": {
        "code": "DATE_PAST"
      }
    },
    {
      "name": "a day far ahead is refused",
      "input": {
        "clinic": "willow",
        "date": "2099-01-05"
      },
      "error": {
        "code": "DATE_TOO_FAR"
      }
    }
  ]
}
