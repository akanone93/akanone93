{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bd2c-7239-9527-f11fa3112186",
  "name": "pay.simulate",
  "description": "Simulates a wallet charge for the Pay demo; never moves money.",
  "placement": "device",
  "capabilities": {},
  "tests": [
    {
      "name": "a charge succeeds",
      "input": {
        "amount": "25.00",
        "currency": "EUR",
        "reference": "AR-0002"
      },
      "output": {
        "status": "success",
        "transactionId": "SIM-AR-0002",
        "errorCode": null
      }
    },
    {
      "name": "a zero amount is refused",
      "input": {
        "amount": "0",
        "currency": "EUR",
        "reference": "AR-0002"
      },
      "error": {
        "code": "AMOUNT_INVALID"
      }
    }
  ]
}
