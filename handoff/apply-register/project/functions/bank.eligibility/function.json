{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bd3c-722b-9605-5862d62f3648",
  "name": "bank.eligibility",
  "description": "A first look at whether someone may open a Nordvia account; the bank decides on the server.",
  "placement": "device",
  "capabilities": {},
  "tests": [
    {
      "name": "an employed adult is eligible",
      "input": {
        "monthlyIncome": "2500.00",
        "age": 30,
        "employment": "employed"
      },
      "output": {
        "eligible": true,
        "score": 65,
        "reasons": []
      }
    },
    {
      "name": "under 18 is refused",
      "input": {
        "monthlyIncome": "500.00",
        "age": 16,
        "employment": "student"
      },
      "error": {
        "code": "UNDERAGE"
      }
    }
  ]
}
