{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bdb1-729e-bd3f-385ff486a175",
  "name": "pass.issue",
  "description": "Issues a registration's pass code, bound to its owner with HMAC-SHA-256 under a server-held key.",
  "placement": "server",
  "capabilities": {
    "secrets": [
      "PASS_SIGNING_KEY"
    ],
    "claims": true
  },
  "assurance": "AL1",
  "tests": [
    {
      "name": "someone else's registration is refused",
      "input": {
        "registrationId": "r-001",
        "owner": "u-2"
      },
      "claims": {
        "sub": "u-1"
      },
      "error": {
        "code": "NOT_OWNER"
      }
    },
    {
      "name": "an empty registration is refused",
      "input": {
        "registrationId": "",
        "owner": "u-1"
      },
      "claims": {
        "sub": "u-1"
      },
      "error": {
        "code": "REGISTRATION_INVALID"
      }
    }
  ]
}
