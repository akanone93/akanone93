{
  "schemaVersion": "1.0.0",
  "kind": "function",
  "id": "01a1ed57-bdcd-7710-8842-87c3643750a2",
  "name": "hooks.orgSync",
  "description": "Inbound webhook: keeps an organisation's open state; the platform checks signatures and replays.",
  "placement": "server",
  "capabilities": {
    "kv": true
  },
  "assurance": "AL0",
  "tests": [
    {
      "name": "stores an organisation's state",
      "input": {
        "slug": "campus",
        "open": true,
        "closesAt": null
      },
      "output": {
        "stored": true
      }
    },
    {
      "name": "a bad slug is refused",
      "input": {
        "slug": "Campus!",
        "open": true,
        "closesAt": null
      },
      "error": {
        "code": "SLUG_INVALID"
      }
    }
  ]
}
