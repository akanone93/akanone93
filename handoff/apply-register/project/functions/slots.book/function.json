      },
      "claims": {
        "sub": "u-1"
      },
      "error": {
        "code": "TIME_INVALID"
      }
    },
    {
      "name": "the past cannot be booked",
      "input": {
        "clinic": "willow",
        "date": "2000-01-03",
        "time": "09:30"
      },
      "claims": {
        "sub": "u-1"
      },
      "error": {
        "code": "DATE_PAST"
      }
    }
  ]
