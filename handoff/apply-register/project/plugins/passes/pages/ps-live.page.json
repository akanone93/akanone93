{
  "dataSources": [
    {
      "config": {
        "auth": true,
        "baseUrl": "streamUrl",
        "params": {
          "id": {
            "$expr": "params.id"
          }
        },
        "path": "/sse/registrations/{id}"
      },
      "id": "01a27a33-1115-7ffb-bfea-68162ef8a991",
      "kind": "sse",
      "mock": {
        "note": "Desk 2 is open.",
        "position": 4,
        "status": "waiting",
        "waitMinutes": 12
      },
      "name": "regLive",
      "route": "plux",
      "type": "Queue"
    }
  ],
  "id": "01a24b2d-b159-73ba-9bdf-d16db832f65c",
  "key": "ps-live",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "subscribe",
          "id": "sub",
          "input": {
            "params": {
              "id": {
                "$expr": "params.id"
              }
            },
            "stream": "regLive"
          }
        }
      ]
    },
    "onLeave": {
      "steps": [
        {
          "action": "unsubscribe",
          "id": "unsub",
          "input": {
            "stream": "regLive"
          }
        }
      ]
    }
  },
  "pageKind": "screen",
  "params": [
    {
      "mock": "r-001",
      "name": "id",
      "type": "string"
    }
  ],
  "root": {
    "id": "01a2f2cf-2366-7110-a8e5-173e75d955dc",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a21398-8d1e-7d3c-97b3-a82b9fdfbb02",
        "slots": {
          "title": {
            "id": "01a2c02c-8556-7f11-903d-fda16828c5d6",
            "props": {
              "data": {
                "$t": "01a2160d-3a77-7493-9c56-5e411cd79f86"
              }
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01a2ac72-7e6a-7fdc-856a-ddb7f2c84728",
        "props": {
          "padding": {
            "all": 16
          }
        },
        "slots": {
          "child": {
            "children": [
              {
                "id": "01a28201-fcec-7603-9f2f-9f64dd6d7b44",
                "props": {
                  "condition": {
                    "$expr": "data.regLive.loading"
                  }
                },
                "slots": {
                  "then": {
                    "id": "01a26a3c-e051-7762-9ff8-c5a6c83bcf69",
                    "props": {
                      "semanticsLabel": {
                        "$t": "01a2d623-f023-7721-9861-9bdcc584aad6"
                      }
                    },
                    "type": "LinearProgressIndicator"
                  }
                },
                "type": "If"
              },
              {
                "id": "01a22518-5837-719b-be5b-7af4663cdde0",
                "props": {
                  "etaMinutes": {
                    "$expr": "data.regLive.value?.waitMinutes"
                  },
                  "icon": {
                    "name": "schedule"
                  },
                  "minutesLabel": {
                    "$t": "01a237d9-69ed-75de-84cc-d1d6336a32bb"
                  },
                  "status": {
                    "$expr": "data.regLive.value?.status"
                  },
                  "title": {
                    "$t": "01a2160d-3a77-7493-9c56-5e411cd79f86"
                  }
                },
                "type": "LiveEtaCard"
              },
              {
                "id": "01a2bd1e-9430-74a9-8d89-a04fbf9d6556",
                "props": {
                  "duration": 300
                },
                "slots": {
                  "child": {
                    "id": "01a2f10b-ca92-79a0-b055-69d0cafea477",
                    "props": {
                      "data": {
                        "$expr": "data.regLive.value?.note ?? \"\""
                      },
                      "style": {
                        "$token": "typography.bodyLarge"
                      }
                    },
                    "type": "Text"
                  }
                },
                "type": "AnimatedSwitcher"
              },
              {
                "id": "01a2dd01-9093-715a-925c-6c67f086fcd7",
                "props": {
                  "semanticLabel": {
                    "$t": "01a2031e-a319-711a-a912-c4fe022db940"
                  },
                  "values": {
                    "$expr": "page.history"
                  }
                },
                "type": "Sparkline"
              }
            ],
            "id": "01a22c0a-d8f4-743a-84ae-744fbeaa49b3",
            "props": {
              "crossAxisAlignment": "stretch",
              "spacing": 16
            },
            "type": "Column"
          }
        },
        "type": "Padding"
      }
    },
    "type": "Scaffold"
  },
  "route": "ps-live",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": [],
      "id": "01a2b719-e104-7741-baa6-99b8f87bf401",
      "name": "history",
      "type": "list<double>"
    }
  ],
  "title": {
    "$t": "01a2160d-3a77-7493-9c56-5e411cd79f86"
  },
  "triggers": {
    "dataSources": {
      "regLive": {
        "onMessage": {
          "steps": [
            {
              "action": "setState",
              "id": "add",
              "input": {
                "path": "page.history",
                "value": {
                  "$expr": "size(page.history) < 20 ? page.history + [double(event.waitMinutes)] : slice(page.history, 1, 20) + [double(event.waitMinutes)]"
                }
              }
            }
          ]
        }
      }
    }
  }
}
