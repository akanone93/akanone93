{
  "id": "01a2a0f0-40c5-78d2-a4fc-fd47d54fb511",
  "key": "home",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "emitHostEvent",
          "id": "brand",
          "input": {
            "event": "brandRequested",
            "payload": {
              "brand": null
            }
          },
          "next": "first"
        },
        {
          "action": "condition",
          "branches": {
            "else": "seen",
            "then": "welcome"
          },
          "id": "first",
          "input": {
            "when": {
              "$expr": "!app.onboarded"
            }
          }
        },
        {
          "action": "openDialog",
          "id": "welcome",
          "input": {
            "dismissible": false,
            "route": "ln-welcome"
          },
          "next": "keep"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "app.interests",
            "value": {
              "$expr": "steps.welcome.output ?? app.interests"
            }
          },
          "next": "done"
        },
        {
          "action": "setState",
          "id": "done",
          "input": {
            "path": "app.onboarded",
            "value": true
          }
        },
        {
          "action": "condition",
          "branches": {
            "then": "news"
          },
          "id": "seen",
          "input": {
            "when": {
              "$expr": "plugin.whatsNewSeen != env.termsVersion"
            }
          }
        },
        {
          "action": "openDialog",
          "id": "news",
          "input": {
            "route": "ln-whats-new"
          }
        }
      ]
    },
    "onResume": {
      "steps": [
        {
          "action": "refreshData",
          "id": "load",
          "input": {
            "source": "featured"
          }
        }
      ]
    }
  },
