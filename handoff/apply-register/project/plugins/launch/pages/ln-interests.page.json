{
  "id": "01a27488-eadc-7c92-af58-59f939dd4463",
  "key": "ln-interests",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01a29807-1773-7868-9020-ca1c0e6bbb99",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a22b82-4d9d-71c9-a74c-4b5088ac8a97",
        "slots": {
          "title": {
            "id": "01a2df33-5b10-7def-b80b-fe675edbb022",
            "props": {
              "data": {
                "$t": "01a2ffe1-2ab5-74d9-ac91-c847a53e803a"
              }
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01a22600-083e-7b6d-a225-687f2b6bf42b",
        "props": {
          "padding": {
            "all": 16
          }
        },
        "slots": {
          "child": {
            "children": [
              {
                "id": "01a25146-dc05-7e8d-8335-616c3a7c991f",
                "props": {
                  "data": {
                    "$t": "01a264c4-2cb4-7041-9b0e-63e7c86ab27b"
                  },
                  "style": {
                    "$token": "typography.bodyLarge"
                  }
                },
                "type": "Text"
              },
              {
                "children": [
                  {
                    "id": "01a28889-5b1d-7b99-9dbc-e70273f8fab7",
                    "props": {
                      "items": {
                        "$expr": "data.categories.value ?? []"
                      }
                    },
                    "slots": {
                      "item": {
                        "events": {
                          "onSelected": {
                            "steps": [
                              {
                                "action": "condition",
                                "branches": {
                                  "else": "drop",
                                  "then": "add"
                                },
                                "id": "pick",
                                "input": {
                                  "when": {
                                    "$expr": "event"
                                  }
                                }
                              },
                              {
                                "action": "setState",
                                "id": "add",
                                "input": {
                                  "path": "page.picked",
                                  "value": {
                                    "$expr": "page.picked + [item.key]"
                                  }
                                }
                              },
                              {
                                "action": "setState",
                                "id": "drop",
                                "input": {
                                  "path": "page.picked",
                                  "value": {
                                    "$expr": "page.picked.filter(x, x != item.key)"
                                  }
                                }
                              }
                            ]
                          }
                        },
                        "id": "01a22b1c-ba08-7c7d-9726-8f7c4709bebb",
                        "props": {
                          "selected": {
                            "$expr": "item.key in page.picked"
                          },
                          "showCheckmark": true
                        },
                        "slots": {
                          "avatar": {
                            "id": "01a2a951-5b78-71da-8e22-5a1fd9caaca1",
                            "props": {
                              "icon": {
                                "$expr": "{\"name\": item.icon}"
                              }
                            },
                            "semantics": {
                              "decorative": true
                            },
                            "type": "Icon"
                          },
                          "label": {
                            "id": "01a23dc8-655a-7022-b5a8-dddf9ccc6333",
                            "props": {
                              "data": {
                                "$expr": "item.key == \"education\" ? t(\"01a2948e-880b-7854-a9ec-de669448ce5e\") : item.key == \"finance\" ? t(\"01a23d3d-a72e-7c8c-b3fb-3338a9f21f25\") : item.key == \"sports\" ? t(\"01a28b38-3bbe-719b-b725-793109b4a21f\") : item.key == \"charity\" ? t(\"01a2f4f1-a0a2-70bf-ae0b-d8eb448738b0\") : item.key == \"health\" ? t(\"01a27c20-d5ed-7607-a47e-5869b34b97b3\") : item.key == \"housing\" ? t(\"01a20d93-a324-7d7c-b5c3-9c9fceeadecf\") : item.key == \"events\" ? t(\"01a24d3b-3b4a-738f-a898-a5466d05112f\") : item.key == \"venues\" ? t(\"01a2948d-d706-76cd-b71a-94557dc75644\") : \"\""
                              }
                            },
                            "type": "Text"
                          }
                        },
                        "testId": "interest",
                        "type": "FilterChip"
                      }
                    },
                    "type": "ForEach"
                  }
                ],
                "id": "01a287dd-5534-7731-b5bb-63a3585b5d50",
                "props": {
                  "runSpacing": 8,
                  "spacing": 8
                },
                "type": "Wrap"
              }
            ],
            "id": "01a2d5ec-5001-7b67-8986-82ee7d710af3",
            "props": {
              "crossAxisAlignment": "start",
              "spacing": 16
            },
            "type": "Column"
          }
        },
        "type": "SingleChildScrollView"
      },
      "bottomNavigationBar": {
        "component": {
          "id": "01a2b909-cbad-77df-b6b6-d36ce2fb1df9",
          "version": 1
        },
        "events": {
          "onSubmit": {
            "steps": [
              {
                "action": "setState",
                "id": "keep",
                "input": {
                  "path": "app.interests",
                  "value": {
                    "$expr": "page.picked"
                  }
                },
                "next": "seen"
              },
              {
                "action": "setState",
                "id": "seen",
                "input": {
                  "path": "app.onboarded",
                  "value": true
                },
                "next": "home"
              },
              {
                "action": "navigate",
                "id": "home",
                "input": {
                  "mode": "popUntil",
                  "route": "home",
                  "until": "home"
                }
              }
            ]
          }
        },
        "id": "01a23a19-653f-7761-b172-37ad5ccb2831",
        "props": {
          "enabled": {
            "$expr": "size(page.picked) > 0"
          },
          "label": {
            "$t": "01a2b9b6-0174-77f0-92d8-9c028cbcd491"
          }
        },
        "testId": "interests-done"
      }
    },
    "type": "Scaffold"
  },
  "route": "ln-interests",
  "routeOptions": {
    "transition": "sharedAxis"
  },
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": [],
      "id": "01a2e772-a2bc-78cc-82a0-7cb1c4128812",
      "name": "picked",
      "type": "list<string>"
    }
  ],
  "title": {
    "$t": "01a2ffe1-2ab5-74d9-ac91-c847a53e803a"
  }
}
