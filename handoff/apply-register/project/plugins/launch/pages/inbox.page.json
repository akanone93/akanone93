{
  "id": "01a29841-28a5-79ff-8528-e79ebd3b6c8c",
  "key": "inbox",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01a28a0e-b704-76c8-b481-dcbd35b3f576",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a2f6b7-3799-7e8e-b7d0-3854db395d6c",
        "slots": {
          "actions": [
            {
              "events": {
                "onSelected": {
                  "steps": [
                    {
                      "action": "forEach",
                      "branches": {
                        "body": "one"
                      },
                      "id": "all",
                      "input": {
                        "items": {
                          "$expr": "data.notices.value ?? []"
                        }
                      }
                    },
                    {
                      "action": "dbUpdate",
                      "id": "one",
                      "input": {
                        "collection": "notices",
                        "key": {
                          "$expr": "item.id"
                        },
                        "patch": {
                          "read": true
                        }
                      }
                    }
                  ]
                }
              },
              "id": "01a22ed9-4615-7acb-81aa-7c3b134847f0",
              "props": {
                "items": [
                  {
                    "label": {
                      "$t": "01a297c0-ec28-7245-b91d-f3d304c4ea33"
                    },
                    "value": "read"
                  }
                ],
                "tooltip": {
                  "$t": "01a29892-675a-7b6b-b16e-6de876e02863"
                }
              },
              "testId": "inbox-menu",
              "type": "PopupMenuButton"
            }
          ],
          "title": {
            "id": "01a2d8c3-f4b7-732e-aad2-6438612ac326",
            "props": {
              "data": {
                "$t": "01a22166-7e5f-79a7-b6e1-b0fcec651864"
              }
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "events": {
          "onRefresh": {
            "steps": [
              {
                "action": "refreshData",
                "id": "load",
                "input": {
                  "source": "notices"
                }
              }
            ]
          }
        },
        "id": "01a241e1-982e-7d12-aae1-a4c5fc441351",
        "slots": {
          "child": {
            "id": "01a2265f-90df-78ff-bb08-5d1097cfe8e3",
            "props": {
              "items": {
                "$expr": "data.notices.value ?? []"
              },
              "padding": {
                "vertical": 8
              }
            },
            "slots": {
              "empty": {
                "component": {
                  "id": "01a266bd-c9c7-7bb0-b0ed-64508b5f61cf",
                  "version": 1
                },
                "id": "01a2a46d-2c07-78c2-91a0-5e1daa15416d",
                "props": {
                  "message": {
                    "$t": "01a2f396-e8ec-7621-8afc-64b449d734b5"
                  },
                  "title": {
                    "$t": "01a2cafc-6473-772c-bc19-7786f9909f69"
                  }
                }
              },
              "item": {
                "events": {
                  "onDismissed": {
                    "steps": [
                      {
                        "action": "dbDelete",
                        "id": "drop",
                        "input": {
                          "collection": "notices",
                          "key": {
                            "$expr": "item.id"
                          }
                        },
                        "next": "say"
                      },
                      {
                        "action": "showSnackbar",
                        "id": "say",
                        "input": {
                          "message": {
                            "$t": "01a204e5-ae1a-70be-a6cd-2626f72e6b77"
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01a24381-25e0-7046-8d58-6475845a7dcf",
                "props": {
                  "direction": "endToStart"
                },
                "slots": {
                  "background": {
                    "id": "01a25eac-0ece-76a4-9ef0-30df66da2108",
                    "props": {
                      "alignment": "centerEnd",
                      "color": {
                        "$token": "color.error"
                      },
                      "padding": {
                        "horizontal": 24
                      }
                    },
                    "slots": {
                      "child": {
                        "id": "01a2bc4b-3a3d-76e2-8660-d6cc544ab797",
                        "props": {
                          "color": {
                            "$token": "color.onError"
                          },
                          "icon": {
                            "name": "delete"
                          }
                        },
                        "semantics": {
                          "decorative": true
                        },
                        "type": "Icon"
                      }
                    },
                    "type": "Container"
                  },
                  "child": {
                    "events": {
                      "onTap": {
                        "steps": [
                          {
                            "action": "dbUpdate",
                            "id": "read",
                            "input": {
                              "collection": "notices",
                              "key": {
                                "$expr": "item.id"
                              },
                              "patch": {
                                "read": true
                              }
                            },
                            "next": "where"
                          },
                          {
                            "action": "switch",
                            "branches": {
                              "org": "org",
                              "pass": "pass"
                            },
                            "id": "where",
                            "input": {
                              "cases": [
                                "pass",
                                "org"
                              ],
                              "value": {
                                "$expr": "item.target"
                              }
                            }
                          },
                          {
                            "action": "navigate",
                            "id": "pass",
                            "input": {
                              "params": {
                                "id": {
                                  "$expr": "item.param"
                                }
                              },
                              "route": "pass"
                            }
                          },
                          {
                            "action": "navigate",
                            "id": "org",
                            "input": {
                              "params": {
                                "slug": {
                                  "$expr": "item.param"
                                }
                              },
                              "route": "ex-org"
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a28521-9d91-744b-a667-979564d021f1",
                    "props": {
                      "isThreeLine": false
                    },
                    "slots": {
                      "leading": {
                        "id": "01a23e26-39c1-7abb-ba81-c18dc7ef643e",
                        "props": {
                          "color": {
                            "$token": "color.primary"
                          },
                          "icon": {
                            "name": "circle"
                          },
                          "size": 10
                        },
                        "semantics": {
                          "decorative": true
                        },
                        "type": "Icon",
                        "visible": {
                          "$expr": "!item.read"
                        }
                      },
                      "subtitle": {
                        "id": "01a2a487-6f69-7154-967e-bbe0bbfab223",
                        "props": {
                          "data": {
                            "$expr": "item.body"
                          },
                          "maxLines": 2,
                          "overflow": "ellipsis",
                          "style": {
                            "$token": "typography.bodyMedium"
                          }
                        },
                        "type": "Text"
                      },
                      "title": {
                        "id": "01a2e1be-829a-7773-9ae9-9ef11b450b4b",
                        "props": {
                          "data": {
                            "$expr": "item.title"
                          },
                          "style": {
                            "$token": "typography.titleSmall"
                          }
                        },
                        "type": "Text"
                      },
                      "trailing": {
                        "id": "01a20835-bd9c-7be3-8045-9acc9e11e1dd",
                        "props": {
                          "data": {
                            "$expr": "format.date(item.at)"
                          },
                          "style": {
                            "$token": "typography.labelSmall"
                          }
                        },
                        "type": "Text"
                      }
                    },
                    "testId": "inbox-row",
                    "type": "ListTile"
                  }
                },
                "type": "Dismissible"
              }
            },
            "type": "ListView"
          }
        },
        "type": "RefreshIndicator"
      }
    },
    "type": "Scaffold"
  },
  "route": "inbox",
  "schemaVersion": "1.0.0",
  "title": {
    "$t": "01a22166-7e5f-79a7-b6e1-b0fcec651864"
  }
}
