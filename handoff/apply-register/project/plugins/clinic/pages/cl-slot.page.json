{
  "id": "01a26723-456d-7489-8e11-9c8d730b58f9",
  "key": "cl-slot",
  "kind": "page",
  "pageKind": "bottomSheet",
  "result": "ClinicSlot",
  "root": {
    "id": "01a26b8f-945f-7ab6-866a-7b77b1ab9c14",
    "props": {
      "padding": {
        "all": 16
      }
    },
    "slots": {
      "child": {
        "children": [
          {
            "id": "01a23452-b327-7d8e-8c92-55c311e17e6d",
            "props": {
              "data": {
                "$t": "01a2071c-7815-7c9c-aece-d9b6885b9481"
              },
              "style": {
                "$token": "typography.titleLarge"
              }
            },
            "semantics": {
              "header": true
            },
            "type": "Text"
          },
          {
            "id": "01a26f2f-6b64-7650-8854-88326c5f11c8",
            "props": {
              "height": {
                "$expr": "200.0 * device.textScale"
              }
            },
            "slots": {
              "child": {
                "events": {
                  "onDateTimeChanged": {
                    "concurrency": "debounce:300",
                    "steps": [
                      {
                        "action": "setState",
                        "id": "day",
                        "input": {
                          "path": "page.date",
                          "value": {
                            "$expr": "string(date(event))"
                          }
                        },
                        "next": "busy"
                      },
                      {
                        "action": "setState",
                        "id": "busy",
                        "input": {
                          "path": "page.status",
                          "value": "loading"
                        },
                        "next": "ask"
                      },
                      {
                        "action": "invokeFunction",
                        "id": "ask",
                        "input": {
                          "function": "slots.availability",
                          "input": {
                            "clinic": "willow",
                            "date": {
                              "$expr": "page.date"
                            }
                          }
                        },
                        "next": "keep",
                        "onError": "failed"
                      },
                      {
                        "action": "setState",
                        "id": "keep",
                        "input": {
                          "path": "page.slots",
                          "value": {
                            "$expr": "(steps.ask.output?.slots ?? []).map(s, {\"date\": page.date, \"time\": s.time, \"free\": s.free, \"startsAt\": s.startsAt})"
                          }
                        },
                        "next": "ready"
                      },
                      {
                        "action": "setState",
                        "id": "ready",
                        "input": {
                          "path": "page.status",
                          "value": "ready"
                        }
                      },
                      {
                        "action": "setState",
                        "id": "failed",
                        "input": {
                          "path": "page.reason",
                          "value": {
                            "$expr": "steps.ask.error?.code == \"CLOSED\" ? \"closed\" : steps.ask.error?.code == \"DATE_PAST\" || steps.ask.error?.code == \"DATE_TOO_FAR\" ? \"window\" : \"other\""
                          }
                        },
                        "next": "err"
                      },
                      {
                        "action": "setState",
                        "id": "err",
                        "input": {
                          "path": "page.status",
                          "value": "error"
                        }
                      }
                    ]
                  }
                },
                "id": "01a21ba0-81d5-7eb5-85ea-5720bf3722d2",
                "props": {
                  "itemExtent": {
                    "$expr": "32.0 * device.textScale"
                  },
                  "minimumYear": 2026,
                  "mode": "date",
                  "showDayOfWeek": true,
                  "use24hFormat": true
                },
                "semantics": {
                  "label": {
                    "$t": "01a237ef-1d0d-7141-b903-35d341d2c21f"
                  }
                },
                "testId": "cl-day",
                "type": "CupertinoDatePicker"
              }
            },
            "type": "SizedBox"
          },
          {
            "id": "01a2878f-38de-7df1-aa5a-a34e5d01ea8d",
            "props": {
              "condition": {
                "$expr": "page.date == \"\""
              }
            },
            "slots": {
              "else": {
                "id": "01a2d6f2-07f2-70a9-8085-be68f09ba2af",
                "props": {
                  "isEmpty": {
                    "$expr": "isEmpty(page.slots)"
                  },
                  "status": {
                    "$expr": "page.status == \"loading\" ? \"loading\" : page.status == \"error\" ? \"error\" : \"ready\""
                  }
                },
                "slots": {
                  "empty": {
                    "id": "01a240de-de7a-75d8-b4c7-a766f14cf9a0",
                    "props": {
                      "data": {
                        "$t": "01a295cf-f474-70d3-a92d-7818277884db"
                      },
                      "style": {
                        "$token": "typography.bodyMedium"
                      }
                    },
                    "type": "Text"
                  },
                  "error": {
                    "id": "01a2f556-1df7-7541-95f1-01d148725810",
                    "props": {
                      "cases": [
                        "closed",
                        "window"
                      ],
                      "value": {
                        "$expr": "page.reason"
                      }
                    },
                    "slots": {
                      "branches": [
                        {
                          "id": "01a2d595-a4dc-796a-959f-dd2b7b1646d4",
                          "props": {
                            "data": {
                              "$t": "01a295cf-f474-70d3-a92d-7818277884db"
                            },
                            "style": {
                              "$token": "typography.bodyMedium"
                            }
                          },
                          "type": "Text"
                        },
                        {
                          "id": "01a29d8f-db73-7ebb-ac01-1276579d1948",
                          "props": {
                            "data": {
                              "$t": "01a20e5f-8ef2-7bc0-bfae-ac5258a3b944"
                            },
                            "style": {
                              "$token": "typography.bodyMedium"
                            }
                          },
                          "type": "Text"
                        }
                      ],
                      "otherwise": {
                        "id": "01a209b1-2d0e-70a9-a7cd-c216802e9cb8",
                        "props": {
                          "data": {
                            "$t": "01a2e8f0-1585-7e32-862c-13f9e0654645"
                          },
                          "style": {
                            "$token": "typography.bodyMedium"
                          }
                        },
                        "type": "Text"
                      }
                    },
                    "type": "Match"
                  },
                  "loading": {
                    "id": "01a23135-f9e0-7703-9079-37b4a9c70193",
                    "slots": {
                      "child": {
                        "id": "01a29fe4-961f-75b2-9198-b1cac0b8564c",
                        "props": {
                          "radius": 14
                        },
                        "type": "CupertinoActivityIndicator"
                      }
                    },
                    "type": "Center"
                  },
                  "success": {
                    "children": [
                      {
                        "id": "01a244bb-9cd3-7e88-9902-f4c3742e695f",
                        "props": {
                          "items": {
                            "$expr": "page.slots"
                          }
                        },
                        "slots": {
                          "item": {
                            "id": "01a2b6a4-4276-7a1d-979e-f54bc57b20fe",
                            "props": {
                              "padding": {
                                "all": 4
                              }
                            },
                            "slots": {
                              "child": {
                                "id": "01a28d3b-0c62-7bce-a3da-21a6832ac7d9",
                                "props": {
                                  "condition": {
                                    "$expr": "item.free"
                                  }
                                },
                                "slots": {
                                  "else": {
                                    "id": "01a21e2b-09ba-73d3-bd85-ad1311dca9d4",
                                    "props": {
                                      "borderRadius": {
                                        "all": 10
                                      },
                                      "disabledColor": {
                                        "$token": "color.outlineVariant"
                                      },
                                      "sizeStyle": "medium"
                                    },
                                    "semantics": {
                                      "label": {
                                        "$t": "01a2a301-58f7-7eb6-b504-c231ab7675c1",
                                        "args": {
                                          "time": {
                                            "$expr": "item.time"
                                          }
                                        }
                                      }
                                    },
                                    "slots": {
                                      "child": {
                                        "id": "01a243c0-1fb9-7922-8501-77f5ef1b2fed",
                                        "props": {
                                          "data": {
                                            "$expr": "item.time"
                                          }
                                        },
                                        "type": "Text"
                                      }
                                    },
                                    "testId": "cl-time-taken",
                                    "type": "CupertinoButton"
                                  },
                                  "then": {
                                    "events": {
                                      "onPressed": {
                                        "steps": [
                                          {
                                            "action": "pop",
                                            "id": "pick",
                                            "input": {
                                              "result": {
                                                "$expr": "item"
                                              }
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    "id": "01a206e6-459c-7408-9a0e-084d1d7c8021",
                                    "props": {
                                      "borderRadius": {
                                        "all": 10
                                      },
                                      "color": {
                                        "$token": "color.primary"
                                      },
                                      "foregroundColor": {
                                        "$token": "color.onPrimary"
                                      },
                                      "sizeStyle": "medium"
                                    },
                                    "slots": {
                                      "child": {
                                        "id": "01a2499c-4564-75b3-8b0c-a30348e155ac",
                                        "props": {
                                          "data": {
                                            "$expr": "item.time"
                                          }
                                        },
                                        "type": "Text"
                                      }
                                    },
                                    "testId": "cl-time",
                                    "type": "CupertinoButton"
                                  }
                                },
                                "type": "If"
                              }
                            },
                            "type": "Padding"
                          }
                        },
                        "type": "ForEach"
                      }
                    ],
                    "id": "01a2bcee-711a-7e0a-aac0-611b7497598b",
                    "type": "Wrap"
                  }
                },
                "type": "DataScope"
              },
              "then": {
                "id": "01a28466-20bd-7933-bb73-2c0e43c08234",
                "props": {
                  "data": {
                    "$t": "01a20e5f-8ef2-7bc0-bfae-ac5258a3b944"
                  },
                  "style": {
                    "$token": "typography.bodyMedium"
                  }
                },
                "type": "Text"
              }
            },
            "type": "If"
          }
        ],
        "id": "01a27c54-c909-794a-aa72-f363163b0d1e",
        "props": {
          "crossAxisAlignment": "stretch",
          "mainAxisSize": "min",
          "spacing": 12
        },
        "type": "Column"
      }
    },
    "type": "Padding"
  },
  "route": "cl-slot",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": "",
      "id": "01a212b1-7823-71be-a2ee-53a04c9d25b2",
      "name": "date",
      "type": "string"
    },
    {
      "default": "loading",
      "id": "01a2bdd8-e6b3-7d4e-a046-efc3fbfd1be5",
      "name": "status",
      "type": "string"
    },
    {
      "default": "",
      "id": "01a2ee45-e155-72dc-8f4d-84096ece3101",
      "name": "reason",
      "type": "string"
    },
    {
      "default": [],
      "id": "01a250a4-45ef-7c9e-ba76-9b40815a66bd",
      "name": "slots",
      "type": "list<ClinicSlot>"
    }
  ],
  "title": {
    "$t": "01a2071c-7815-7c9c-aece-d9b6885b9481"
  }
}
