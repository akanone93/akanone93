{
  "id": "01a2da6e-8385-741d-9d4c-9d7fd450c260",
  "key": "cl-confirm",
  "kind": "page",
  "pageKind": "dialog",
  "result": "bool",
  "root": {
    "id": "01a20622-c82f-7c46-b9cd-9e6e76e5dd16",
    "props": {
      "padding": {
        "all": 20
      }
    },
    "slots": {
      "child": {
        "children": [
          {
            "events": {
              "onAction": {
                "steps": [
                  {
                    "action": "switch",
                    "branches": {
                      "cal": "cal",
                      "default": "cancel",
                      "share": "share"
                    },
                    "id": "which",
                    "input": {
                      "cases": [
                        "cal",
                        "share"
                      ],
                      "value": {
                        "$expr": "event == 0 ? \"cal\" : event == 1 ? \"share\" : \"cancel\""
                      }
                    }
                  },
                  {
                    "action": "callNative",
                    "id": "cal",
                    "input": {
                      "action": "addToCalendar",
                      "input": {
                        "location": "Willow Clinic",
                        "minutes": 30,
                        "startsAt": {
                          "$expr": "dateTime(plugin.slot?.startsAt ?? \"2026-01-01T00:00:00Z\")"
                        },
                        "title": {
                          "$t": "01a239fe-6efe-7845-a324-50a53336b323"
                        }
                      }
                    },
                    "next": "added"
                  },
                  {
                    "action": "showToast",
                    "id": "added",
                    "input": {
                      "message": {
                        "$t": "01a29a80-d1f1-74e4-9329-ee7873054f20"
                      }
                    }
                  },
                  {
                    "action": "share",
                    "id": "share",
                    "input": {
                      "text": {
                        "$t": "01a27589-8c31-730d-b9ff-12157fed378c",
                        "args": {
                          "date": {
                            "$expr": "plugin.slot?.date ?? \"\""
                          },
                          "time": {
                            "$expr": "plugin.slot?.time ?? \"\""
                          }
                        }
                      }
                    }
                  },
                  {
                    "action": "pop",
                    "id": "cancel",
                    "input": {
                      "result": false
                    }
                  }
                ]
              }
            },
            "id": "01a2a56b-dfb3-778c-add8-a519b67a3b3f",
            "props": {
              "actions": [
                {
                  "destructive": false,
                  "icon": {
                    "name": "calendar_today"
                  },
                  "label": {
                    "$t": "01a2b003-d725-7d0d-836c-1df8d524da25"
                  }
                },
                {
                  "destructive": false,
                  "icon": {
                    "name": "share"
                  },
                  "label": {
                    "$t": "01a21998-a21f-7c2c-a08a-7038553de0dd"
                  }
                },
                {
                  "destructive": true,
                  "icon": {
                    "name": "close"
                  },
                  "label": {
                    "$t": "01a2353f-5108-71e6-a841-d0a3d3604289"
                  }
                }
              ],
              "enableHapticFeedback": true
            },
            "slots": {
              "child": {
                "id": "01a23e8a-7456-7ad6-855d-827cea13a67f",
                "props": {
                  "color": {
                    "$token": "color.surfaceContainerLow"
                  },
                  "elevation": 0
                },
                "slots": {
                  "child": {
                    "id": "01a28c75-863c-7579-9b50-02228e2ac375",
                    "props": {
                      "padding": {
                        "all": 16
                      }
                    },
                    "slots": {
                      "child": {
                        "children": [
                          {
                            "id": "01a20866-aa36-7f98-9256-690508630d26",
                            "props": {
                              "data": {
                                "$t": "01a2784e-b041-73d1-9292-bc17cdbd426a"
                              },
                              "style": {
                                "$token": "typography.titleMedium"
                              }
                            },
                            "semantics": {
                              "header": true
                            },
                            "type": "Text"
                          },
                          {
                            "component": {
                              "id": "01a2a501-ce23-7395-ba84-b83ff3374807",
                              "version": 1
                            },
                            "id": "01a21924-dac5-77d5-b53a-19fbd06da760",
                            "props": {
                              "label": {
                                "$t": "01a27178-1ede-7372-9724-7afb08d773bf"
                              },
                              "value": {
                                "$expr": "plugin.slot?.date ?? \"\""
                              }
                            }
                          },
                          {
                            "component": {
                              "id": "01a2a501-ce23-7395-ba84-b83ff3374807",
                              "version": 1
                            },
                            "id": "01a2873c-76b4-71e7-ad6a-1aad5e9b591f",
                            "props": {
                              "label": {
                                "$t": "01a22ea9-5080-78eb-ae11-95907a3fbfbe"
                              },
                              "value": {
                                "$expr": "plugin.slot?.time ?? \"\""
                              }
                            }
                          },
                          {
                            "component": {
                              "id": "01a2a501-ce23-7395-ba84-b83ff3374807",
                              "version": 1
                            },
                            "id": "01a260f7-13fd-75de-a83a-62cadad4b338",
                            "props": {
                              "label": {
                                "$t": "01a2ff74-b626-74b3-9ec3-fe50cb0adbff"
                              },
                              "value": "Dr. Amara Okafor"
                            }
                          },
                          {
                            "component": {
                              "id": "01a2a501-ce23-7395-ba84-b83ff3374807",
                              "version": 1
                            },
                            "id": "01a24df3-89b1-7000-b6ed-b3091cd73c81",
                            "props": {
                              "label": {
                                "$t": "01a2acea-3765-76f3-81d4-52f98679b231"
                              },
                              "value": {
                                "$expr": "format.money(money(\"10.00\", \"EUR\"))"
                              }
                            }
                          }
                        ],
                        "id": "01a2accd-537d-7fe0-97a8-5b24beba2bd3",
                        "props": {
                          "crossAxisAlignment": "stretch",
                          "spacing": 4
                        },
                        "type": "Column"
                      }
                    },
                    "type": "Padding"
                  }
                },
                "type": "Card"
              }
            },
            "testId": "cl-summary",
            "type": "CupertinoContextMenu"
          },
          {
            "id": "01a2f24d-96b3-7e2f-907d-d96f954841df",
            "props": {
              "data": {
                "$t": "01a2ca76-e326-795d-bfd1-683c83039ab8"
              },
              "style": {
                "$token": "typography.bodySmall"
              }
            },
            "type": "Text"
          },
          {
            "events": {
              "onPressed": {
                "concurrency": "drop",
                "steps": [
                  {
                    "action": "invokeFunction",
                    "id": "hold",
                    "input": {
                      "function": "slots.book",
                      "input": {
                        "clinic": "willow",
                        "date": {
                          "$expr": "plugin.slot?.date ?? \"\""
                        },
                        "time": {
                          "$expr": "plugin.slot?.time ?? \"\""
                        }
                      }
                    },
                    "next": "ref",
                    "onError": "why"
                  },
                  {
                    "action": "setState",
                    "id": "ref",
                    "input": {
                      "path": "plugin.booking",
                      "value": {
                        "$expr": "steps.hold.output?.reference ?? \"\""
                      }
                    },
                    "next": "pay"
                  },
                  {
                    "action": "callFlow",
                    "id": "pay",
                    "input": {
                      "flow": "pay/pay-with-wallet",
                      "input": {
                        "req": {
                          "amount": {
                            "$expr": "money(\"10.00\", \"EUR\")"
                          },
                          "payee": "Willow Clinic",
                          "purpose": {
                            "$t": "01a2acea-3765-76f3-81d4-52f98679b231"
                          },
                          "reference": {
                            "$expr": "plugin.booking"
                          }
                        }
                      }
                    },
                    "next": "done",
                    "onError": "no"
                  },
                  {
                    "action": "pop",
                    "id": "done",
                    "input": {
                      "result": {
                        "$expr": "steps.pay.output?.status == \"success\""
                      }
                    }
                  },
                  {
                    "action": "condition",
                    "branches": {
                      "else": "no",
                      "then": "taken"
                    },
                    "id": "why",
                    "input": {
                      "when": {
                        "$expr": "steps.hold.error?.code == \"TAKEN\""
                      }
                    }
                  },
                  {
                    "action": "showSnackbar",
                    "id": "taken",
                    "input": {
                      "message": {
                        "$t": "01a20679-c2c3-7a1b-a0fc-4c29f6f77396"
                      }
                    },
                    "next": "no"
                  },
                  {
                    "action": "pop",
                    "id": "no",
                    "input": {
                      "result": false
                    }
                  }
                ]
              }
            },
            "id": "01a2f6e8-017e-7d33-a35a-4fcf270303e5",
            "props": {
              "borderRadius": {
                "all": 12
              },
              "color": {
                "$token": "color.primary"
              },
              "foregroundColor": {
                "$token": "color.onPrimary"
              },
              "minimumSize": {
                "height": 50,
                "width": 44
              },
              "sizeStyle": "large"
            },
            "slots": {
              "child": {
                "id": "01a20ca0-6ee4-779b-bc2e-fca3d6282bb4",
                "props": {
                  "data": {
                    "$t": "01a25951-9263-7868-9abe-fbacb2e06098"
                  }
                },
                "type": "Text"
              }
            },
            "testId": "cl-book",
            "type": "CupertinoButton"
          }
        ],
        "id": "01a20799-5cdc-77a3-ab25-fffdca450fee",
        "props": {
          "crossAxisAlignment": "stretch",
          "mainAxisSize": "min",
          "spacing": 16
        },
        "type": "Column"
      }
    },
    "type": "Padding"
  },
  "route": "cl-confirm",
  "schemaVersion": "1.0.0",
  "security": {
    "secure": true
  },
  "title": {
    "$t": "01a2784e-b041-73d1-9292-bc17cdbd426a"
  }
}
