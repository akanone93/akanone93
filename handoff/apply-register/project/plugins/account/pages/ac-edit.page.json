                    "email": {
                      "$expr": "page.profile.values.email"
                    },
                    "name": {
                      "$expr": "page.profile.values.name"
                    },
                    "phone": {
                      "$expr": "page.profile.values.phone"
                    }
                  },
                  "operation": "me.updateMe"
                },
                "next": "say"
              },
              {
                "action": "showSnackbar",
