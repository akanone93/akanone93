        "events": {
          "onSubmit": {
            "steps": [
              {
                "action": "submitForm",
                "branches": {
                  "invalid": "fix"
                },
                "id": "check",
                "input": {
                  "form": "profile"
                },
                "next": "send"
              },
              {
                "action": "announce",
                "id": "fix",
                "input": {
                  "assertiveness": "assertive",
