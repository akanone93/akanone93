  "id": "01a21c2f-8004-7e41-b95a-a410d03469bb",
  "key": "cp-home",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "emitHostEvent",
          "id": "brand",
          "input": {
            "event": "brandRequested",
            "payload": {
              "brand": "aster"
            }
          },
          "next": "d"
        },
        {
          "action": "dbQuery",
          "id": "d",
          "input": {
            "collection": "drafts",
            "limit": 1
          },
          "next": "has"
        },
        {
          "action": "setState",
          "id": "has",
          "input": {
            "path": "page.hasDraft",
            "value": {
              "$expr": "!isEmpty(steps.d.output ?? []) && plugin.app.step > 0"
            }
          }
        }
      ]
    }
  },
