      "config": {
        "baseUrl": "graphUrl",
        "cache": {
          "policy": "staleWhileRevalidate",
          "ttlSeconds": 300
        },
        "pagination": {
          "cursorParam": "cursor",
          "hasMore": "programmes.more",
          "nextCursor": "programmes.next",
          "pageSize": 20,
          "sizeParam": "first",
          "style": "cursor"
        },
        "params": {
          "q": {
            "$expr": "page.q"
          }
        },
        "query": "query Programmes($q: String, $cursor: String, $first: Int) { programmes(q: $q, cursor: $cursor, first: $first) { items { id name level fee { amount currency } } next more } }",
        "select": "programmes.items"
      },
