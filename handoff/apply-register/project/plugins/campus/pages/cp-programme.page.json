          }
        },
        "query": "query Programme($id: ID!) { programme(id: $id) { id name level overview requirements } }",
        "select": "programme"
      },
      "id": "01a2dbfd-ef63-7b75-afa1-a1ceddaa8e29",
      "kind": "graphql",
      "mock": {
        "id": "p-101",
        "level": "bachelor",
        "name": "Computer Science",
        "overview": "## Computer Science\n\nFour years in Addis Ababa, taught in English and Amharic. Read the [handbook](https://applyregister.app/help).",
        "requirements": [
          "Secondary school certificate",
          "Mathematics grade B or better",
          "An essay of at least 250 words"
        ]
      },
