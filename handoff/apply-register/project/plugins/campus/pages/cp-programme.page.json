  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "invokeFunction",
          "id": "quote",
          "input": {
            "function": "fees.quote",
            "input": {
              "currency": "EUR",
              "org": "campus",
              "quantity": 1,
              "tier": {
                "$expr": "params.level"
              }
            }
          },
          "next": "keep",
          "onError": "noFee"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "page.fee",
            "value": {
              "$expr": "{\"subtotal\": steps.quote.output?.subtotal ?? \"0\", \"tax\": steps.quote.output?.tax ?? \"0\", \"total\": steps.quote.output?.total ?? \"0\", \"currency\": steps.quote.output?.currency ?? \"EUR\"}"
            }
          }
        },
        {
          "action": "setState",
          "id": "noFee",
          "input": {
            "path": "page.feeError",
            "value": true
          }
        }
      ]
    }
  },
