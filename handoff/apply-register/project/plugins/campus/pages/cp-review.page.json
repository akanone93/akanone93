        "type": "SafeArea"
      },
      "bottomNavigationBar": {
        "component": {
          "id": "01a2b909-cbad-77df-b6b6-d36ce2fb1df9",
          "version": 1
        },
        "events": {
          "onSubmit": {
            "concurrency": "drop",
            "steps": [
              {
                "action": "setState",
                "id": "busy",
                "input": {
                  "path": "page.submitting",
                  "value": true
                },
                "next": "pay"
              },
              {
                "action": "callFlow",
                "id": "pay",
                "input": {
                  "flow": "pay/pay-with-wallet",
                  "input": {
                    "req": {
                      "amount": {
                        "$expr": "money(page.fee?.total ?? \"0\", \"EUR\")"
                      },
                      "payee": "Aster University",
                      "purpose": {
                        "$t": "01a2122e-38ac-771a-88ff-19d93e05faec"
                      },
                      "reference": {
                        "$expr": "\"AU-\" + plugin.app.programmeId"
                      }
                    }
                  }
                },
                "next": "how",
                "onError": "failed"
              },
              {
                "action": "switch",
                "branches": {
                  "default": "idle",
                  "error": "failed",
                  "success": "id"
                },
                "id": "how",
                "input": {
                  "cases": [
                    "success",
                    "error"
                  ],
                  "value": {
                    "$expr": "steps.pay.output?.status ?? \"cancelled\""
                  }
                }
              },
              {
                "action": "setState",
                "id": "id",
                "input": {
                  "path": "plugin.pendingId",
                  "value": {
                    "$expr": "\"AU-\" + plugin.app.programmeId"
                  }
                },
                "next": "send"
              },
              {
                "action": "apiCall",
                "id": "send",
                "input": {
                  "input": {
                    "choices": {
                      "$expr": "plugin.choices"
                    },
                    "documents": {
                      "$expr": "plugin.docs.map(d, d.name)"
                    },
                    "essay": {
                      "$expr": "plugin.essay"
                    },
                    "level": {
                      "$expr": "plugin.app.level"
                    },
                    "paymentId": {
                      "$expr": "steps.pay.output?.transactionId ?? \"\""
                    },
                    "personal": {
                      "$expr": "plugin.personal"
                    },
                    "programmeId": {
                      "$expr": "plugin.app.programmeId"
                    },
                    "schools": {
                      "$expr": "plugin.schools"
                    }
                  },
                  "operation": "api.register"
                },
                "next": "drop"
              },
              {
                "action": "dbDelete",
                "id": "drop",
                "input": {
                  "collection": "drafts",
                  "key": {
                    "$expr": "plugin.app.programmeId"
                  }
                },
                "next": "forget"
              },
              {
                "action": "setState",
                "id": "forget",
                "input": {
                  "path": "plugin.personal",
                  "value": {
                    "$expr": "null"
                  }
                },
                "next": "clear1"
              },
              {
                "action": "setState",
                "id": "clear1",
                "input": {
                  "path": "plugin.schools",
                  "value": {
                    "$expr": "[]"
                  }
                },
                "next": "clear2"
              },
              {
                "action": "setState",
                "id": "clear2",
                "input": {
                  "path": "plugin.docs",
                  "value": {
                    "$expr": "[]"
                  }
                },
                "next": "clear3"
              },
              {
                "action": "setState",
                "id": "clear3",
                "input": {
                  "path": "plugin.essay",
                  "value": ""
                },
                "next": "reset"
              },
              {
                "action": "patchState",
                "id": "reset",
                "input": {
                  "patch": {
                    "step": 0
                  },
                  "path": "plugin.app"
                },
                "next": "tell"
              },
              {
                "action": "announce",
                "id": "tell",
                "input": {
                  "message": {
                    "$t": "01a2a852-7b7b-7ca9-8a98-bf2417a648d4"
                  }
                },
                "next": "home"
              },
              {
                "action": "navigate",
                "id": "home",
                "input": {
                  "mode": "popUntil",
                  "route": "cp-home",
                  "until": "cp-home"
                }
              },
              {
                "action": "showSnackbar",
                "id": "failed",
                "input": {
                  "message": {
                    "$t": "01a20e8b-8c43-77d5-b69e-b3adfe43e769"
                  }
                },
                "next": "idle"
              },
              {
                "action": "setState",
                "id": "idle",
                "input": {
                  "path": "page.submitting",
                  "value": false
                }
              }
            ]
          }
        },
        "id": "01a2f8a9-19c1-7112-b3e0-13885f215459",
        "props": {
          "busy": {
            "$expr": "page.submitting"
          },
          "enabled": {
            "$expr": "page.consent && page.fee != null && plugin.personal != null && !isEmpty(plugin.schools) && !isEmpty(plugin.docs) && len(plugin.essay) > 0"
          },
          "label": {
            "$t": "01a288a7-a7e9-784e-9b7a-3b0e9b763edf"
          }
        },
        "testId": "cp-submit"
      }
    },
    "type": "Scaffold"
  },
  "route": "cp-review",
  "schemaVersion": "1.0.0",
  "security": {
    "secure": true
  },
