                    "type": "Card"
                  },
                  {
                    "events": {
                      "onChanged": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "set",
                            "input": {
                              "path": "page.consent",
                              "value": {
                                "$expr": "event ?? false"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a26e6e-e7e0-7873-ab6e-62152ff46583",
