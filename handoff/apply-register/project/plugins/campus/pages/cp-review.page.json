{
  "id": "01a23063-f84f-733c-98ce-8a638e5d8585",
  "key": "cp-review",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "invokeFunction",
          "id": "quote",
          "input": {
            "function": "fees.quote",
            "input": {
              "currency": "EUR",
              "org": "campus",
              "quantity": 1,
              "tier": {
                "$expr": "plugin.app.level"
              }
            }
          },
          "next": "keep",
          "onError": "noFee"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "page.fee",
            "value": {
              "$expr": "{\"subtotal\": steps.quote.output?.subtotal ?? \"0\", \"tax\": steps.quote.output?.tax ?? \"0\", \"total\": steps.quote.output?.total ?? \"0\", \"currency\": steps.quote.output?.currency ?? \"EUR\"}"
            }
          }
        },
        {
          "action": "setState",
          "id": "noFee",
          "input": {
            "path": "page.feeError",
            "value": true
          }
        }
      ]
    }
  },
