      "type": "FeeQuote?"
    },
    {
      "default": false,
      "id": "01a2b13a-7fdc-7744-a7ea-086fadd803e5",
      "name": "feeError",
      "type": "bool"
    },
    {
      "default": false,
      "id": "01a2aad4-8bea-731b-80b1-d16b68fcd884",
      "name": "consent",
      "type": "bool"
    },
    {
      "default": false,
      "id": "01a29c40-d372-7d7a-85b8-8a3c1cfd30a9",
      "name": "submitting",
      "type": "bool"
    }
  ],
  "title": {
    "$t": "01a27742-aae5-7657-9b79-d3c827dda303"
  }
}
