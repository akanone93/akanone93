{
  "id": "01a23bc1-366f-7d18-b44e-1fa302d75a60",
  "key": "cp-documents",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01a2bc43-a314-77b1-b152-6f7bfae72fce",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a208d5-fe2d-715d-896c-f72803a52085",
        "props": {
          "backgroundColor": {
            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "actions": [
            {
              "events": {
                "onPressed": {
                  "concurrency": "drop",
                  "steps": [
                    {
                      "action": "dbUpsert",
                      "id": "keep",
                      "input": {
                        "collection": "drafts",
                        "key": {
                          "$expr": "plugin.app.programmeId"
                        },
                        "record": {
                          "$expr": "plugin.app"
                        }
                      },
                      "next": "ask"
                    },
                    {
                      "action": "openDialog",
                      "id": "ask",
                      "input": {
                        "route": "cp-saved"
                      },
                      "next": "pick"
                    },
                    {
                      "action": "switch",
                      "branches": {
                        "exit": "out"
                      },
                      "id": "pick",
                      "input": {
                        "cases": [
                          "exit"
                        ],
                        "value": {
                          "$expr": "steps.ask.output ?? \"stay\""
                        }
                      }
                    },
                    {
                      "action": "navigate",
                      "id": "out",
                      "input": {
                        "mode": "popUntil",
                        "route": "cp-home",
                        "until": "cp-home"
                      }
                    }
                  ]
                }
              },
              "id": "01a281f6-04ca-77ae-88f9-2f300c818839",
              "slots": {
                "child": {
                  "id": "01a2028e-349f-7a47-b8c8-faf6335c677a",
                  "props": {
                    "data": {
                      "$t": "01a21b73-bca3-719b-b245-6317c2c02d05"
                    }
                  },
                  "type": "Text"
                }
              },
              "testId": "cp-save-3",
              "type": "TextButton"
            }
          ],
          "title": {
            "id": "01a2d7a2-04c5-7cde-8423-7b3591c824bc",
            "props": {
              "data": {
                "$t": "01a29e76-d76e-7198-955f-d84585078a12"
              },
              "maxLines": 1,
              "overflow": "ellipsis"
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01a21839-c55e-7db3-ac53-678476567ff7",
        "slots": {
          "child": {
            "id": "01a25f3b-924e-737c-89c2-0ede5110a94d",
            "props": {
              "padding": {
                "all": 16
              }
            },
            "slots": {
              "child": {
                "children": [
                  {
                    "children": [
                      {
                        "id": "01a26658-0524-7bf3-ac31-4ef482d113cc",
                        "props": {
                          "borderRadius": {
                            "all": {
                              "$token": "radius.pill"
                            }
                          },
                          "minHeight": 4,
                          "semanticsLabel": {
                            "$t": "01a233a0-9ca2-7fa8-86cf-b33f1131294c",
                            "args": {
                              "n": {
                                "$expr": "string(3)"
                              }
                            }
                          },
                          "value": 0.75
                        },
                        "type": "LinearProgressIndicator"
                      },
                      {
                        "id": "01a2d23a-36f7-728b-920a-4a57cae5d55d",
                        "props": {
                          "data": {
                            "$t": "01a233a0-9ca2-7fa8-86cf-b33f1131294c",
                            "args": {
                              "n": {
                                "$expr": "string(3)"
                              }
                            }
                          },
                          "style": {
                            "$token": "typography.labelMedium"
                          }
                        },
                        "type": "Text"
                      },
                      {
                        "id": "01a25dcc-d71c-713c-b811-8bdfe7415c68",
                        "props": {
                          "data": {
                            "$t": "01a29bf4-86a6-7554-b122-6e54e5b31735"
                          },
                          "style": {
                            "$token": "typography.headlineSmall"
                          }
                        },
                        "semantics": {
                          "header": true
                        },
                        "type": "Text"
                      }
                    ],
                    "id": "01a2d795-300d-73ce-9281-857e4ae3a5cc",
                    "props": {
                      "crossAxisAlignment": "start",
                      "spacing": 4
                    },
                    "type": "Column"
                  },
                  {
                    "id": "01a2db96-de09-776a-8b74-2aeb65666e97",
                    "props": {
                      "height": 8
                    },
                    "type": "SizedBox"
                  },
                  {
                    "events": {
                      "onFailed": {
                        "steps": [
                          {
                            "action": "showSnackbar",
                            "id": "say",
                            "input": {
                              "message": {
                                "$expr": "event.message"
                              }
                            }
                          }
                        ]
                      },
                      "onUploaded": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "keep",
                            "input": {
                              "path": "plugin.docs",
                              "value": {
                                "$expr": "plugin.docs + [{\"name\": event.name, \"mimeType\": event.mimeType, \"sizeBytes\": event.sizeBytes}]"
                              }
                            },
                            "next": "done"
                          },
                          {
                            "action": "setState",
                            "id": "done",
                            "input": {
                              "path": "page.progress",
                              "value": 0.0
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a2403e-b900-703e-b9fd-ddaf3b980d7a",
                    "props": {
                      "accept": [
                        "application/pdf",
                        "image/jpeg",
                        "image/png"
                      ],
                      "dataSource": "api",
                      "label": {
                        "$t": "01a254f0-e734-7a39-8cdd-6432f40e2c92"
                      },
                      "maxBytes": 10485760,
                      "operation": "upload",
                      "uploadLabel": {
                        "$t": "01a2f674-7a87-71a1-b568-67868552ed60"
                      }
                    },
                    "testId": "cp-uploader",
                    "type": "FileUploader"
                  },
                  {
                    "id": "01a2c80a-8a34-7731-b34b-149df5f8f21e",
                    "props": {
                      "height": 12
                    },
                    "type": "SizedBox"
                  },
                  {
                    "events": {
                      "onPressed": {
                        "concurrency": "drop",
                        "steps": [
                          {
                            "action": "pickFile",
                            "branches": {
                              "cancelled": "none"
                            },
                            "id": "pick",
                            "input": {
                              "mimeTypes": [
                                "application/pdf"
                              ],
                              "multiple": true
                            },
                            "next": "each"
                          },
                          {
                            "action": "forEach",
                            "branches": {
                              "body": "fits"
                            },
                            "id": "each",
                            "input": {
                              "items": {
                                "$expr": "steps.pick.output ?? []"
                              }
                            }
                          },
                          {
                            "action": "condition",
                            "branches": {
                              "else": "big",
                              "then": "send"
                            },
                            "id": "fits",
                            "input": {
                              "when": {
                                "$expr": "item.sizeBytes <= 10485760"
                              }
                            }
                          },
                          {
                            "action": "apiCall",
                            "id": "send",
                            "input": {
                              "input": {
                                "file": {
                                  "$expr": "item.handle"
                                },
                                "kind": "supporting"
                              },
                              "operation": "api.upload"
                            },
                            "next": "kept"
                          },
                          {
                            "action": "setState",
                            "id": "kept",
                            "input": {
                              "path": "plugin.docs",
                              "value": {
                                "$expr": "plugin.docs + [{\"name\": item.name, \"mimeType\": item.mimeType, \"sizeBytes\": item.sizeBytes}]"
                              }
                            }
                          },
                          {
                            "action": "showSnackbar",
                            "id": "big",
                            "input": {
                              "message": {
                                "$t": "01a2a473-e673-72fc-8024-0a401036437c",
                                "args": {
                                  "name": {
                                    "$expr": "item.name"
                                  }
                                }
                              }
                            }
                          },
                          {
                            "action": "stop",
                            "id": "none"
                          }
                        ]
                      }
                    },
                    "id": "01a279ff-2711-7f59-be25-4b2c08c26825",
                    "slots": {
                      "child": {
                        "children": [
                          {
                            "id": "01a283a2-4aca-7eaa-b478-e538251b6111",
                            "props": {
                              "icon": {
                                "name": "library_add"
                              }
                            },
                            "semantics": {
                              "decorative": true
                            },
                            "type": "Icon"
                          },
                          {
                            "id": "01a261fd-62d0-733c-ba92-b9d694e62f53",
                            "props": {
                              "data": {
                                "$t": "01a245cf-356a-7992-b1c5-35318547c791"
                              }
                            },
                            "type": "Text"
                          }
                        ],
                        "id": "01a2cb3b-7c56-7ad2-b8a9-94f6d9bcde3e",
                        "props": {
                          "mainAxisSize": "min",
                          "spacing": 8
                        },
                        "type": "Row"
                      }
                    },
                    "testId": "cp-pick-many",
                    "type": "OutlinedButton"
                  },
                  {
                    "id": "01a26d57-cdf3-7aa2-8e34-08be8dfa2967",
                    "props": {
                      "height": 12
                    },
                    "type": "SizedBox"
                  },
                  {
                    "id": "01a21c31-fcb1-7b32-af3e-875a5196d7b5",
                    "props": {
                      "borderRadius": {
                        "all": 4
                      },
                      "minHeight": 6,
                      "semanticsLabel": {
                        "$t": "01a2cf86-6d02-7ec6-9002-bc7854f9a61b"
                      },
                      "value": {
                        "$expr": "page.progress"
                      }
                    },
                    "type": "LinearProgressIndicator"
                  },
                  {
                    "id": "01a2b0a6-27a1-7da7-ad21-a461ebe60a3c",
                    "props": {
                      "height": 12
                    },
                    "type": "SizedBox"
                  },
                  {
                    "id": "01a215d6-08f0-7724-bee4-9512d47f673b",
                    "props": {
                      "items": {
                        "$expr": "plugin.docs"
                      },
                      "physics": "never",
                      "shrinkWrap": true
                    },
                    "slots": {
                      "empty": {
                        "id": "01a28cec-c19c-72fd-b2ff-7b5d07b4faed",
                        "props": {
                          "data": {
                            "$t": "01a27cab-6103-7dcc-854a-1c75c092f022"
                          },
                          "style": {
                            "$token": "typography.bodyMedium"
                          }
                        },
                        "type": "Text"
                      },
                      "item": {
                        "id": "01a239a9-fa61-7e7f-ab6d-5c3fd049a0c1",
                        "slots": {
                          "leading": {
                            "id": "01a2b389-edbc-74c0-8c7b-506615f03777",
                            "props": {
                              "condition": {
                                "$expr": "item.mimeType == \"application/pdf\""
                              }
                            },
                            "slots": {
                              "else": {
                                "id": "01a26260-04ae-7302-adb2-ecbcba93897e",
                                "props": {
                                  "color": {
                                    "$token": "color.primary"
                                  },
                                  "icon": {
                                    "name": "image"
                                  }
                                },
                                "semantics": {
                                  "decorative": true
                                },
                                "type": "Icon"
                              },
                              "then": {
                                "id": "01a2a208-ebf1-755d-90ce-84ecf51ffab0",
                                "props": {
                                  "color": {
                                    "$token": "color.primary"
                                  },
                                  "icon": {
                                    "name": "picture_as_pdf"
                                  }
                                },
                                "semantics": {
                                  "decorative": true
                                },
                                "type": "Icon"
                              }
                            },
                            "type": "If"
                          },
                          "subtitle": {
                            "id": "01a26a74-e1bc-7560-82f0-8a30cb4d2fb4",
                            "props": {
                              "data": {
                                "$expr": "format.compact(item.sizeBytes) + \" B\""
                              },
                              "style": {
                                "$token": "typography.bodySmall"
                              }
                            },
                            "type": "Text"
                          },
                          "title": {
                            "id": "01a2dd28-50d5-78df-9e6c-70e792eb330c",
                            "props": {
                              "data": {
                                "$expr": "item.name"
                              },
                              "maxLines": 1,
                              "overflow": "ellipsis",
                              "style": {
                                "$token": "typography.bodyLarge"
                              }
                            },
                            "type": "Text"
                          }
                        },
                        "type": "ListTile"
                      }
                    },
                    "testId": "cp-docs",
                    "type": "ListView"
                  }
                ],
                "id": "01a2e8db-db6d-7d59-9ad9-502e17b3a518",
                "props": {
                  "crossAxisAlignment": "stretch"
                },
                "type": "Column"
              }
            },
            "type": "SingleChildScrollView"
          }
        },
        "type": "SafeArea"
      },
      "bottomNavigationBar": {
        "component": {
          "id": "01a2b909-cbad-77df-b6b6-d36ce2fb1df9",
          "version": 1
        },
        "events": {
          "onSubmit": {
            "concurrency": "drop",
            "steps": [
              {
                "action": "patchState",
                "id": "step",
                "input": {
                  "patch": {
                    "step": 4
                  },
                  "path": "plugin.app"
                },
                "next": "go"
              },
              {
                "action": "navigate",
                "id": "go",
                "input": {
                  "route": "cp-essay"
                }
              }
            ]
          }
        },
        "id": "01a2efe1-9fa9-7b80-8bcc-77e220804787",
        "props": {
          "enabled": {
            "$expr": "!isEmpty(plugin.docs)"
          },
          "label": {
            "$t": "01a2cae3-6a94-71e6-ac01-6c2f09ad3f1d"
          }
        },
        "testId": "cp-documents-next"
      }
    },
    "type": "Scaffold"
  },
  "route": "cp-documents",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": 0.0,
      "id": "01a21788-1d46-7b3c-9aa4-e20707919945",
      "name": "progress",
      "type": "double"
    }
  ],
  "title": {
    "$t": "01a29bf4-86a6-7554-b122-6e54e5b31735"
  },
  "triggers": {
    "dataSources": {
      "api": {
        "onProgress": {
          "steps": [
            {
              "action": "setState",
              "id": "move",
              "input": {
                "path": "page.progress",
                "value": {
                  "$expr": "double(event.sent) / double(max(event.total, 1))"
                }
              }
            }
          ]
        }
      }
    }
  }
}
