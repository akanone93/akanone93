            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "actions": [
            {
              "events": {
                "onPressed": {
                  "concurrency": "drop",
                  "steps": [
                    {
                      "action": "dbUpsert",
                      "id": "keep",
                      "input": {
                        "collection": "drafts",
                        "key": {
                          "$expr": "plugin.app.programmeId"
                        },
                        "record": {
                          "$expr": "plugin.app"
                        }
                      },
                      "next": "ask"
                    },
                    {
                      "action": "openDialog",
                      "id": "ask",
                      "input": {
                        "route": "cp-saved"
                      },
                      "next": "pick"
                    },
                    {
                      "action": "switch",
                      "branches": {
                        "exit": "out"
                      },
                      "id": "pick",
                      "input": {
                        "cases": [
                          "exit"
                        ],
                        "value": {
                          "$expr": "steps.ask.output ?? \"stay\""
                        }
                      }
                    },
                    {
                      "action": "navigate",
                      "id": "out",
                      "input": {
                        "mode": "popUntil",
                        "route": "cp-home",
                        "until": "cp-home"
                      }
                    }
                  ]
                }
