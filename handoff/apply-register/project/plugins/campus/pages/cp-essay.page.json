{
  "id": "01a2ab8c-9067-7738-ad14-9aca007571da",
  "key": "cp-essay",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "setState",
          "id": "put",
          "input": {
            "path": "page.text",
            "value": {
              "$expr": "plugin.essay"
            }
          },
          "next": "any"
        },
        {
          "action": "condition",
          "branches": {
            "then": "count"
          },
          "id": "any",
          "input": {
            "when": {
              "$expr": "len(page.text) > 0"
            }
          }
        },
        {
          "action": "invokeFunction",
          "id": "count",
          "input": {
            "function": "essay.stats",
            "input": {
              "text": {
                "$expr": "page.text"
              }
            }
          },
          "next": "keep",
          "onError": "long"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "page.stats",
            "value": {
              "$expr": "{\"words\": steps.count.output?.words ?? 0, \"sentences\": steps.count.output?.sentences ?? 0, \"readingMinutes\": steps.count.output?.readingMinutes ?? 0, \"longWords\": steps.count.output?.longWords ?? 0}"
            }
          }
        },
        {
          "action": "showSnackbar",
          "id": "long",
          "input": {
            "message": {
              "$t": "01a25b74-f2bc-7595-a50d-b005ab9e609d"
            }
          }
        }
      ]
    }
  },
  "pageKind": "screen",
