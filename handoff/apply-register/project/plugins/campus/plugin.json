  "tags": [
    "education"
  ],
  "team": "apply-register",
  "triggers": {
    "dataSources": {
      "api": {
        "onConflict": {
          "steps": [
            {
              "action": "openDialog",
              "id": "ask",
              "input": {
                "params": {
                  "title": {
                    "$t": "01a21e2a-3218-7a5c-bcd2-e971d09d56fe"
                  }
                },
                "route": "ps-confirm"
              }
            }
          ]
        },
        "onSyncFailed": {
          "steps": [
            {
              "action": "showSnackbar",
              "id": "say",
              "input": {
                "message": {
                  "$t": "01a2c446-8380-72d2-8315-7247eb91638a"
                }
              }
            }
          ]
        },
        "onSynced": {
          "steps": [
            {
              "action": "showToast",
              "id": "say",
              "input": {
                "message": {
                  "$t": "01a289d4-630a-7c52-bc17-b18a99040cfc"
                }
              },
              "next": "tell"
            },
            {
              "action": "emitHostEvent",
              "id": "tell",
              "input": {
                "event": "registrationSubmitted",
                "payload": {
                  "orgSlug": "campus",
                  "registrationId": {
                    "$expr": "plugin.pendingId"
                  }
                }
              }
            }
          ]
        }
      }
    },
    "onAppPause": {
      "detached": true,
      "steps": [
        {
          "action": "condition",
          "branches": {
            "then": "keep"
          },
          "id": "when",
          "input": {
            "when": {
              "$expr": "plugin.app.step > 0"
            }
          }
        },
        {
          "action": "dbUpsert",
          "id": "keep",
          "input": {
            "collection": "drafts",
            "key": {
              "$expr": "plugin.app.programmeId"
            },
            "record": {
              "$expr": "plugin.app"
            }
          }
        }
      ]
    }
  }
}
