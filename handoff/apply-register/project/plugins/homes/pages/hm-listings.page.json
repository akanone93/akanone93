                                                "action": "condition",
                                                "branches": {
                                                  "else": "add",
                                                  "then": "drop"
                                                },
                                                "id": "has",
                                                "input": {
                                                  "when": {
                                                    "$expr": "item.id in plugin.saved"
                                                  }
                                                }
                                              },
                                              {
                                                "action": "setState",
                                                "id": "drop",
                                                "input": {
                                                  "path": "plugin.saved",
                                                  "value": {
                                                    "$expr": "plugin.saved.filter(s, s != item.id)"
                                                  }
                                                }
                                              },
                                              {
                                                "action": "setState",
                                                "id": "add",
                                                "input": {
                                                  "path": "plugin.saved",
                                                  "value": {
                                                    "$expr": "plugin.saved + [item.id]"
                                                  }
                                                }
                                              }
                                            ]
                                          }
                                        },
                                        "id": "01a225b5-ad2c-7be0-9465-bb075d6bdafc",
                                        "props": {
                                          "isSelected": {
                                            "$expr": "item.id in plugin.saved"
                                          },
                                          "style": {
