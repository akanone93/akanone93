                                "$t": "01a2b455-f0f1-71d0-bb32-9bdadbf7ed72"
                              }
                            },
                            "type": "Text"
                          }
                        },
                        "testId": "nb-id-next",
                        "type": "FilledButton"
                      }
                    },
                    "type": "If"
                  }
                },
                "type": "Padding"
              }
            ],
            "id": "01a23c92-79c3-72a3-baa8-575537458416",
