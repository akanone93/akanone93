                      }
                    ],
                    "id": "01a21d81-f8c9-75b6-89bc-af794890ea40",
                    "props": {
                      "crossAxisAlignment": "start",
                      "spacing": 4
                    },
                    "type": "Column"
                  }
                },
                "type": "Padding"
              },
              {
                "id": "01a2edd2-9c80-7f31-ad45-2cab31385438",
                "slots": {
                  "child": {
                    "events": {
                      "onStepCancel": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "back",
                            "input": {
                              "path": "page.step",
                              "value": {
                                "$expr": "max(0, page.step - 1)"
                              }
                            }
                          }
                        ]
                      },
                      "onStepContinue": {
                        "concurrency": "drop",
                        "steps": [
                          {
                            "action": "switch",
                            "branches": {
                              "doc": "doc",
                              "phone": "phone",
                              "where": "where"
                            },
                            "id": "which",
                            "input": {
                              "cases": [
                                "phone",
                                "doc",
                                "where"
                              ],
                              "value": {
                                "$expr": "page.step == 0 ? \"phone\" : page.step == 1 ? \"doc\" : \"where\""
                              }
                            }
                          },
                          {
                            "action": "callFlow",
                            "id": "phone",
                            "input": {
                              "flow": "verify/verify-phone",
                              "input": {
                                "phone": {
                                  "$expr": "data.me.value?.phone ?? \"\""
                                }
                              }
                            },
                            "next": "phoneOk"
                          },
                          {
                            "action": "setState",
                            "id": "phoneOk",
                            "input": {
                              "path": "page.phoneOk",
                              "value": {
                                "$expr": "steps.phone.output?.verified ?? false"
                              }
                            },
                            "next": "phoneNext"
                          },
                          {
                            "action": "condition",
                            "branches": {
                              "then": "toDoc"
                            },
                            "id": "phoneNext",
                            "input": {
                              "when": {
                                "$expr": "page.phoneOk"
                              }
                            }
                          },
                          {
                            "action": "setState",
                            "id": "toDoc",
                            "input": {
                              "path": "page.step",
                              "value": 1
                            }
                          },
                          {
                            "action": "callFlow",
                            "id": "doc",
                            "input": {
                              "flow": "verify/capture-identity"
                            },
                            "next": "docOk",
                            "onError": "docFailed"
                          },
                          {
                            "action": "setState",
                            "id": "docOk",
                            "input": {
                              "path": "page.idOk",
                              "value": true
                            },
                            "next": "docClear"
                          },
                          {
                            "action": "setState",
                            "id": "docClear",
                            "input": {
                              "path": "page.idError",
                              "value": false
                            },
                            "next": "toAddr"
                          },
                          {
                            "action": "setState",
                            "id": "toAddr",
                            "input": {
                              "path": "page.step",
                              "value": 2
                            }
                          },
                          {
                            "action": "setState",
                            "id": "docFailed",
                            "input": {
                              "path": "page.idError",
                              "value": true
                            },
                            "next": "docSay"
                          },
                          {
                            "action": "showSnackbar",
                            "id": "docSay",
                            "input": {
                              "message": {
                                "$t": "01a2b339-d2f0-7b27-aaff-67956f33ee87"
                              }
                            }
                          },
                          {
                            "action": "openDialog",
                            "id": "where",
                            "input": {
                              "route": "vf-address"
                            },
                            "next": "keep"
                          },
                          {
                            "action": "setState",
                            "id": "keep",
                            "input": {
                              "path": "page.addr",
                              "value": {
                                "$expr": "steps.where.output"
                              }
                            }
                          }
                        ]
                      },
                      "onStepTapped": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "go",
                            "input": {
                              "path": "page.step",
                              "value": {
                                "$expr": "event"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a2ab9f-bfae-7d31-9369-a0fcfdb5c06f",
                    "props": {
                      "connectorColor": {
                        "$token": "color.primary"
                      },
                      "currentStep": {
                        "$expr": "page.step"
                      },
                      "steps": {
                        "$expr": "[{\"title\": t(\"01a2ebf7-3493-7970-bccf-4c3316cc10d8\"), \"state\": page.phoneOk ? \"complete\" : \"editing\", \"isActive\": page.step == 0}, {\"title\": t(\"01a2762c-30a3-74b9-884b-c869dbac5331\"), \"state\": page.idError ? \"error\" : page.idOk ? \"complete\" : page.step >= 1 ? \"indexed\" : \"disabled\", \"isActive\": page.step == 1}, {\"title\": t(\"01a2b0ea-7c9b-7188-9425-8dfee27b7709\"), \"state\": page.addr != null ? \"complete\" : \"indexed\", \"isActive\": page.step == 2}]"
                      },
                      "type": "horizontal"
                    },
                    "semantics": {
                      "label": {
                        "$t": "01a22af4-4301-7764-ba97-d00218bbd211"
                      }
                    },
                    "testId": "nb-stepper",
                    "type": "Stepper"
                  }
                },
                "type": "Expanded"
              },
              {
                "id": "01a253d5-fedb-7f4c-862e-11c2b89fe671",
                "props": {
                  "padding": {
                    "all": 16
                  }
                },
                "slots": {
                  "child": {
                    "id": "01a26d23-1f19-7594-9581-e8eb373391bc",
                    "props": {
                      "condition": {
                        "$expr": "page.phoneOk && page.idOk && page.addr != null"
                      }
                    },
                    "slots": {
