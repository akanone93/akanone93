          "version": 1
        },
        "events": {
          "onSubmit": {
            "concurrency": "drop",
            "steps": [
              {
                "action": "submitForm",
                "branches": {
                  "invalid": "fix"
                },
                "id": "check",
                "input": {
                  "form": "elig"
                },
                "next": "young"
              },
              {
                "action": "announce",
                "id": "fix",
                "input": {
                  "assertiveness": "assertive",
                  "message": {
                    "$t": "01a2c3dd-6ebd-7df9-96b1-f1a13795033f"
                  }
                }
              },
              {
                "action": "condition",
                "branches": {
                  "else": "ask",
                  "then": "under"
                },
                "id": "young",
                "input": {
                  "when": {
                    "$expr": "page.elig.values.age < 18"
                  }
                }
              },
              {
                "action": "setState",
                "id": "under",
                "input": {
                  "path": "page.underage",
                  "value": true
                }
              },
              {
                "action": "apiCall",
                "id": "ask",
                "input": {
                  "input": {
                    "age": {
                      "$expr": "page.elig.values.age"
                    },
                    "currency": "EUR",
                    "employment": {
                      "$expr": "page.elig.values.employment"
                    },
                    "monthlyIncome": {
                      "$expr": "amount(page.elig.values.income ?? money(\"0\", \"EUR\"))"
                    }
                  },
                  "operation": "eligibility.check"
                },
                "next": "ok"
              },
              {
                "action": "condition",
                "branches": {
                  "else": "why",
                  "then": "keep"
                },
                "id": "ok",
                "input": {
                  "when": {
                    "$expr": "steps.ask.output?.eligible ?? false"
                  }
                }
              },
              {
                "action": "setState",
                "id": "keep",
                "input": {
                  "path": "plugin.application",
                  "value": {
                    "$expr": "{\"product\": plugin.application.product, \"eligible\": true, \"detailsSent\": plugin.application.detailsSent, \"marketing\": plugin.application.marketing}"
                  }
                },
                "next": "go"
              },
              {
                "action": "navigate",
                "id": "go",
                "input": {
                  "route": "nb-identity"
                }
              },
              {
                "action": "setState",
                "id": "why",
                "input": {
                  "path": "page.reasons",
                  "value": {
                    "$expr": "steps.ask.output?.reasons ?? []"
                  }
                }
              }
            ]
          }
        },
        "id": "01a2f703-1078-7ac4-9a02-fc5acc128f3e",
        "props": {
          "busy": {
            "$expr": "page.elig.status == \"submitting\""
          },
