{
  "id": "01a2e5cf-1a52-7ea1-bf43-9e9b0ba73c3b",
  "key": "dc-checkout",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "setState",
          "id": "lines",
          "input": {
            "path": "page.lines",
            "value": {
              "$expr": "(data.cartLines.value ?? []).map(l, {\"sku\": l.sku, \"qty\": l.qty})"
            }
          },
          "next": "q"
        },
        {
          "action": "apiCall",
          "id": "q",
          "input": {
            "input": {
              "lines": {
                "$expr": "page.lines"
              },
              "promo": {
                "$expr": "plugin.promo"
              }
            },
            "operation": "api.price"
          },
          "next": "keep",
          "onError": "none"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "page.quote",
            "value": {
              "$expr": "steps.q.output"
            }
          }
        },
        {
          "action": "setState",
          "id": "none",
          "input": {
            "path": "page.quoteError",
            "value": true
          }
        }
      ]
    }
  },
  "pageKind": "screen",
  "root": {
    "id": "01a26686-5b8f-7ee0-810e-e767f3edb100",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a2eeec-c805-7b42-975a-c93d6dd5584b",
        "props": {
          "backgroundColor": {
            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "title": {
            "id": "01a2cd65-6b8e-77a2-85b5-c8b8e29b1071",
            "props": {
              "data": {
                "$t": "01a24b14-db17-7785-822e-b48bf8c61ed3"
              },
              "maxLines": 1,
              "overflow": "ellipsis"
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01a26d31-1a92-71a3-892f-ddd90af004c0",
        "slots": {
          "child": {
            "id": "01a20a00-09bc-7bbd-b037-e6a039619c23",
            "props": {
              "padding": {
                "all": 16
              }
            },
            "slots": {
              "child": {
                "children": [
                  {
                    "id": "01a299dc-9d7c-7abd-85f5-3bb3fb7774e4",
                    "props": {
                      "data": {
                        "$t": "01a2f37d-b8f0-71d6-9aae-d0e30c1a5298"
                      },
                      "style": {
                        "$token": "typography.titleMedium"
                      }
                    },
                    "semantics": {
                      "header": true
                    },
                    "type": "Text"
                  },
                  {
                    "events": {
                      "onChanged": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "m",
                            "input": {
                              "path": "page.method",
                              "value": {
                                "$expr": "event ?? \"wallet\""
                              }
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a2385c-5a20-7922-8df3-bd2281a40522",
                    "props": {
                      "groupValue": {
                        "$expr": "page.method"
                      },
                      "value": "wallet"
                    },
                    "slots": {
                      "title": {
                        "id": "01a22767-5e7e-7b92-9db7-38f1126023a0",
                        "props": {
                          "data": {
                            "$t": "01a2d556-98a5-7acb-8f1c-9017ff6916ae"
                          }
                        },
                        "type": "Text"
                      }
                    },
                    "testId": "dc-method-wallet",
                    "type": "RadioListTile"
                  },
                  {
                    "events": {
                      "onChanged": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "m",
                            "input": {
                              "path": "page.method",
                              "value": {
                                "$expr": "event ?? \"wallet\""
                              }
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a22102-3fe8-72d3-a3b9-9dcac753b954",
                    "props": {
                      "groupValue": {
                        "$expr": "page.method"
                      },
                      "value": "invoice"
                    },
                    "slots": {
                      "title": {
                        "id": "01a2bcc4-cb8c-740b-bf34-08faa71fd189",
                        "props": {
                          "data": {
                            "$t": "01a2a402-d224-77f4-8e31-ee8a8abb7ed0"
                          }
                        },
                        "type": "Text"
                      }
                    },
                    "testId": "dc-method-invoice",
                    "type": "RadioListTile"
                  },
                  {
                    "id": "01a24a05-de8d-7c76-a541-eaaadb9b6286",
                    "props": {
                      "condition": {
                        "$expr": "page.quote != null"
                      }
                    },
                    "slots": {
                      "else": {
                        "id": "01a2590b-af3b-77d4-ba10-de18a67aa5b1",
                        "props": {
                          "condition": {
                            "$expr": "page.quoteError"
                          }
                        },
                        "slots": {
                          "else": {
                            "id": "01a21b92-af03-71ae-ad16-dbba60c16f53",
                            "props": {
                              "semanticsLabel": {
                                "$t": "01a2833e-7d8a-7653-90fe-ccc7c3978440"
                              }
                            },
                            "type": "LinearProgressIndicator"
                          },
                          "then": {
                            "id": "01a20dc7-e05f-7d4f-ab18-5b8da548e055",
                            "props": {
                              "data": {
                                "$t": "01a264c2-9df9-73a6-9bdb-ac2eea31ba9f"
                              },
                              "style": {
                                "$token": "typography.bodyMedium"
                              }
                            },
                            "type": "Text"
                          }
                        },
                        "type": "If"
                      },
                      "then": {
                        "children": [
                          {
                            "component": {
                              "id": "01a23d46-d5ff-73db-81e5-ad37733808a6",
                              "version": 1
                            },
                            "id": "01a217de-4f68-7ea4-9914-a2e5b68f894d",
                            "props": {
                              "amount": {
                                "$expr": "page.quote?.subtotal ?? money(\"0\", \"EUR\")"
                              },
                              "label": {
                                "$t": "01a2a54f-9ff0-7819-90f8-e8f8e609ade9"
                              }
                            }
                          },
                          {
                            "component": {
                              "id": "01a23d46-d5ff-73db-81e5-ad37733808a6",
                              "version": 1
                            },
                            "id": "01a2d0f9-f70d-7a24-bf3b-6f7de294f732",
                            "props": {
                              "amount": {
                                "$expr": "page.quote?.tax ?? money(\"0\", \"EUR\")"
                              },
                              "label": {
                                "$t": "01a224de-fffc-793d-ba35-520a0940ecbb"
                              }
                            }
                          },
                          {
                            "id": "01a283ce-2685-7997-81ed-29cd7b0eb65c",
                            "type": "Divider"
                          },
                          {
                            "component": {
                              "id": "01a23d46-d5ff-73db-81e5-ad37733808a6",
                              "version": 1
                            },
                            "id": "01a278b1-5214-7957-9fe4-3e9b094ab566",
                            "props": {
                              "amount": {
                                "$expr": "page.quote?.total ?? money(\"0\", \"EUR\")"
                              },
                              "label": {
                                "$t": "01a2b5c9-c30c-7945-8b8f-eb5c86c99fce"
                              }
                            }
                          }
                        ],
                        "id": "01a2d799-00ee-7d5d-ae9d-17222bd54b9b",
                        "props": {
                          "crossAxisAlignment": "stretch"
                        },
                        "type": "Column"
                      }
                    },
                    "type": "If"
                  }
                ],
                "id": "01a26f07-0aef-7e8e-bf01-44af5fe7045d",
                "props": {
                  "crossAxisAlignment": "stretch",
                  "spacing": 12
                },
                "type": "Column"
              }
            },
            "type": "SingleChildScrollView"
          }
        },
        "type": "SafeArea"
      },
      "bottomNavigationBar": {
        "component": {
          "id": "01a2b909-cbad-77df-b6b6-d36ce2fb1df9",
          "version": 1
        },
        "events": {
          "onSubmit": {
            "concurrency": "drop",
            "steps": [
              {
                "action": "setState",
                "id": "busy",
                "input": {
                  "path": "page.submitting",
                  "value": true
                },
                "next": "how"
              },
              {
                "action": "switch",
                "branches": {
                  "default": "order",
                  "wallet": "pay"
                },
                "id": "how",
                "input": {
                  "cases": [
                    "wallet"
                  ],
                  "value": {
                    "$expr": "page.method"
                  }
                }
              },
              {
                "action": "callFlow",
                "id": "pay",
                "input": {
                  "flow": "pay/pay-with-wallet",
                  "input": {
                    "req": {
                      "amount": {
                        "$expr": "page.quote?.total ?? money(\"0\", \"EUR\")"
                      },
                      "payee": "DevHarbor Conf",
                      "purpose": {
                        "$t": "01a24b14-db17-7785-822e-b48bf8c61ed3"
                      },
                      "reference": {
                        "$expr": "\"DH-\" + (page.quote?.quoteId ?? \"\")"
                      }
                    }
                  }
                },
                "next": "paid",
                "onError": "failed"
              },
              {
                "action": "condition",
                "branches": {
                  "else": "idle",
                  "then": "order"
                },
                "id": "paid",
                "input": {
                  "when": {
                    "$expr": "steps.pay.output?.status == \"success\""
                  }
                }
              },
              {
                "action": "apiCall",
                "id": "order",
                "input": {
                  "input": {
                    "method": {
                      "$expr": "page.method"
                    },
                    "paymentId": {
                      "$expr": "steps.pay.output?.transactionId ?? \"\""
                    },
                    "quoteId": {
                      "$expr": "page.quote?.quoteId ?? \"\""
                    }
                  },
                  "operation": "api.order"
                },
                "next": "empty",
                "onError": "failed"
              },
              {
                "action": "forEach",
                "branches": {
                  "body": "drop"
                },
                "id": "empty",
                "input": {
                  "items": {
                    "$expr": "(data.cartLines.value ?? [])"
                  }
                },
                "next": "reload"
              },
              {
                "action": "dbDelete",
                "id": "drop",
                "input": {
                  "collection": "cart",
                  "key": {
                    "$expr": "item.sku"
                  }
                }
              },
              {
                "action": "refreshData",
                "id": "reload",
                "input": {
                  "source": "cartLines"
                },
                "next": "badge"
              },
              {
                "action": "navigate",
                "id": "badge",
                "input": {
                  "mode": "replace",
                  "route": "dc-badge"
                }
              },
              {
                "action": "showSnackbar",
                "id": "failed",
                "input": {
                  "message": {
                    "$t": "01a282d4-a829-7430-9793-5016293966ec"
                  }
                },
                "next": "idle"
              },
              {
                "action": "setState",
                "id": "idle",
                "input": {
                  "path": "page.submitting",
                  "value": false
                }
              }
            ]
          }
        },
        "id": "01a26eed-ac43-76b3-b326-1240c4052289",
        "props": {
          "busy": {
            "$expr": "page.submitting"
          },
          "enabled": {
            "$expr": "page.quote != null"
          },
          "label": {
            "$t": "01a2c02c-3e01-7da3-a660-0951a18aa58c"
          }
        },
        "testId": "dc-place"
      }
    },
    "type": "Scaffold"
  },
  "route": "dc-checkout",
  "schemaVersion": "1.0.0",
  "security": {
    "secure": true
  },
  "state": [
    {
      "default": "wallet",
      "id": "01a28517-4813-705e-92c2-8b9613007b47",
      "name": "method",
      "type": "string"
    },
    {
      "default": [],
      "id": "01a260d3-0926-7f94-bd6b-4b4bbbe7ce65",
      "name": "lines",
      "type": "list<OrderLine>"
    },
    {
      "default": null,
      "id": "01a26a43-6b2f-7acc-8f04-be70fb5403e9",
      "name": "quote",
      "type": "OrderQuote?"
    },
    {
      "default": false,
      "id": "01a22bb2-ae45-79fa-aac1-59d28b0b7e9c",
      "name": "quoteError",
      "type": "bool"
    },
    {
      "default": false,
      "id": "01a2518a-5710-7f33-9958-bdd1f13f2f13",
      "name": "submitting",
      "type": "bool"
    }
  ],
  "title": {
    "$t": "01a24b14-db17-7785-822e-b48bf8c61ed3"
  }
}
