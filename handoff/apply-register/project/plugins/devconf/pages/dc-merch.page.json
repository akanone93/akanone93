{
  "id": "01a2abe9-0409-7d0d-a463-0c0b4dfa1dce",
  "key": "dc-merch",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01a2d294-f1b5-7d30-a085-98dde0e079f2",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a2be5d-0e86-7ff5-bc22-b2b5ceffaee9",
        "props": {
          "backgroundColor": {
            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "actions": [
            {
              "events": {
                "onPressed": {
                  "steps": [
                    {
                      "action": "navigate",
                      "id": "go",
                      "input": {
                        "route": "dc-cart"
                      }
                    }
                  ]
                }
              },
              "id": "01a2f0bf-215d-74d1-b810-2b3b41aaa50a",
              "props": {
                "tooltip": {
                  "$t": "01a22e36-c48a-73ad-a71d-d6c6efe3f6b8"
                }
              },
              "slots": {
                "icon": {
                  "id": "01a22a45-e3e1-713a-b906-69f0e2284eca",
                  "props": {
                    "isLabelVisible": {
                      "$expr": "size(data.cartLines.value ?? []) > 0"
                    }
                  },
                  "slots": {
                    "child": {
                      "id": "01a2dca0-d560-7768-b9a4-66977f517091",
                      "props": {
                        "icon": {
                          "name": "shopping_cart"
                        }
                      },
                      "semantics": {
                        "decorative": true
                      },
                      "type": "Icon"
                    },
                    "label": {
                      "id": "01a2cea7-3185-7566-bf99-77bbe637d1ad",
                      "props": {
                        "data": {
                          "$expr": "string(size(data.cartLines.value ?? []))"
                        }
                      },
                      "type": "Text"
                    }
                  },
                  "type": "Badge"
                }
              },
              "testId": "dc-cart-go",
              "type": "IconButton"
            }
          ],
          "title": {
            "id": "01a20a27-b565-76c5-8da2-9792fa896e9f",
            "props": {
              "data": {
                "$t": "01a2291b-d2bb-7a6c-96b6-b0851e075b42"
              },
              "maxLines": 1,
              "overflow": "ellipsis"
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01a2144e-0213-7666-b630-0357c9bd3654",
        "props": {
          "padding": {
            "all": 16
          }
        },
        "slots": {
          "child": {
            "children": [
              {
                "events": {
                  "onSelected": {
                    "steps": [
                      {
                        "action": "setState",
                        "id": "s",
                        "input": {
                          "path": "page.sort",
                          "value": {
                            "$expr": "event"
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01a2afbf-b025-77d0-b94b-0bf494cfdd9f",
                "props": {
                  "options": [
                    {
                      "id": "price-asc",
                      "label": {
                        "$t": "01a26462-04e4-75a0-9f74-0413c64b7d30"
                      },
                      "selected": false
                    },
                    {
                      "id": "price-desc",
                      "label": {
                        "$t": "01a247c6-025b-7df5-84d5-dee20e1fdc6c"
                      },
                      "selected": false
                    },
                    {
                      "id": "new",
                      "label": {
                        "$t": "01a21057-f53e-72ac-998c-3b0e33e40925"
                      },
                      "selected": false
                    }
                  ],
                  "selected": {
                    "$expr": "page.sort"
                  },
                  "title": {
                    "$t": "01a2b719-264b-7775-8181-cf56bba44308"
                  }
                },
                "testId": "dc-sort",
                "type": "SortSheet"
              },
              {
                "id": "01a28afa-6ae2-7424-a9c4-897724638e03",
                "props": {
                  "duration": 300
                },
                "slots": {
                  "child": {
                    "id": "01a23cb3-25b6-7cb4-9f25-475b701a95e9",
                    "props": {
                      "condition": {
                        "$expr": "page.open != null"
                      }
                    },
                    "slots": {
                      "then": {
                        "id": "01a26d81-40e4-7758-8ee9-83c17889ce72",
                        "props": {
                          "images": {
                            "$expr": "(first((data.products.value ?? []).filter(p, p.sku == page.open))?.images ?? []).map(u, {\"url\": u})"
                          },
                          "indicators": true,
                          "initialPage": 0,
                          "semanticLabel": {
                            "$t": "01a23a3c-dabd-70a3-aeb1-f6a0b5dce133"
                          }
                        },
                        "testId": "dc-gallery",
                        "type": "ImageGallery"
                      }
                    },
                    "type": "If"
                  }
                },
                "type": "AnimatedSize"
              },
              {
                "id": "01a2c4cd-cf91-74bd-ae78-e7e8662bb618",
                "props": {
                  "crossAxisCount": 2,
                  "crossAxisSpacing": 12,
                  "items": {
                    "$expr": "page.sort == \"price-asc\" ? (data.products.value ?? []).sortBy(p, amount(p.price)) : page.sort == \"price-desc\" ? (data.products.value ?? []).sortBy(p, sub(decimal(\"0\"), amount(p.price))) : (data.products.value ?? []).sortBy(p, 0 - p.rank)"
                  },
                  "mainAxisExtent": 280,
                  "mainAxisSpacing": 12,
                  "physics": "never",
                  "shrinkWrap": true
                },
                "responsive": {
                  "expanded": {
                    "crossAxisCount": 4
                  },
                  "medium": {
                    "crossAxisCount": 3
                  }
                },
                "slots": {
                  "item": {
                    "events": {
                      "onAddToCart": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "line",
                            "input": {
                              "path": "plugin.line",
                              "value": {
                                "$expr": "{\"sku\": item.sku, \"title\": item.title, \"unitAmount\": amount(item.price), \"currency\": currency(item.price), \"qty\": 1, \"kind\": \"merch\"}"
                              }
                            },
                            "next": "put"
                          },
                          {
                            "action": "dbUpsert",
                            "id": "put",
                            "input": {
                              "collection": "cart",
                              "key": {
                                "$expr": "item.sku"
                              },
                              "record": {
                                "$expr": "plugin.line"
                              }
                            },
                            "next": "reload"
                          },
                          {
                            "action": "refreshData",
                            "id": "reload",
                            "input": {
                              "source": "cartLines"
                            },
                            "next": "say"
                          },
                          {
                            "action": "showToast",
                            "id": "say",
                            "input": {
                              "message": {
                                "$t": "01a2befe-4a47-7789-b56b-aa687381b7e4"
                              }
                            }
                          }
                        ]
                      },
                      "onTap": {
                        "steps": [
                          {
                            "action": "setState",
                            "id": "open",
                            "input": {
                              "path": "page.open",
                              "value": {
                                "$expr": "item.sku"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a2b8b0-2c63-758d-b700-c21b38dd5ad3",
                    "props": {
                      "addToCartLabel": {
                        "$t": "01a2af24-d2df-7a19-bda8-280620746684"
                      },
                      "image": {
                        "$expr": "isEmpty(item.images) ? null : {\"url\": first(item.images) ?? \"\"}"
                      },
                      "price": {
                        "$expr": "format.money(item.price)"
                      },
                      "title": {
                        "$expr": "item.title"
                      }
                    },
                    "type": "ProductCard"
                  }
                },
                "testId": "dc-products",
                "type": "GridView"
              }
            ],
            "id": "01a21e74-3deb-712a-8581-302c7d910541",
            "props": {
              "crossAxisAlignment": "stretch",
              "spacing": 12
            },
            "type": "Column"
          }
        },
        "type": "SingleChildScrollView"
      }
    },
    "type": "Scaffold"
  },
  "route": "dc-merch",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": "price-asc",
      "id": "01a2681e-432a-7b69-b491-1ed5df570051",
      "name": "sort",
      "type": "string"
    },
    {
      "default": null,
      "id": "01a2ab72-8574-7aa3-9b92-619a26f794f2",
      "name": "open",
      "type": "string?"
    }
  ],
  "title": {
    "$t": "01a2291b-d2bb-7a6c-96b6-b0851e075b42"
  }
}
