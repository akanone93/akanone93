{
  "id": "01a25b12-7009-7f6a-82fd-c40da5912069",
  "key": "dc-cart",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01a207c4-9820-70f9-a13c-f19ec6f3c9da",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a23109-ef6e-7d57-a77c-ee0be25540f0",
        "props": {
          "backgroundColor": {
            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "title": {
            "id": "01a2e41c-fd38-713f-b157-2a3b0f20809d",
            "props": {
              "data": {
                "$t": "01a22e36-c48a-73ad-a71d-d6c6efe3f6b8"
              },
              "maxLines": 1,
              "overflow": "ellipsis"
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "children": [
          {
            "id": "01a2f1bc-0ff0-7a39-9616-6e98cfd97cc9",
            "slots": {
              "child": {
                "id": "01a27bc6-ac3b-77a0-ab3a-e6c5d7203882",
                "props": {
                  "items": {
                    "$expr": "(data.cartLines.value ?? [])"
                  },
                  "status": {
                    "$expr": "data.cartLines.status"
                  }
                },
                "slots": {
                  "empty": {
                    "component": {
                      "id": "01a266bd-c9c7-7bb0-b0ed-64508b5f61cf",
                      "version": 1
                    },
                    "id": "01a2c3b6-1d6b-7d86-a991-08ad4ec8a2cb",
                    "props": {
                      "title": {
                        "$t": "01a2f5c0-e626-7ed7-b3ce-efb7e7a69522"
                      }
                    }
                  },
                  "item": {
                    "events": {
                      "onDismissed": {
                        "steps": [
                          {
                            "action": "dbDelete",
                            "id": "drop",
                            "input": {
                              "collection": "cart",
                              "key": {
                                "$expr": "item.sku"
                              }
                            },
                            "next": "reload"
                          },
                          {
                            "action": "refreshData",
                            "id": "reload",
                            "input": {
                              "source": "cartLines"
                            },
                            "next": "say"
                          },
                          {
                            "action": "announce",
                            "id": "say",
                            "input": {
                              "message": {
                                "$t": "01a26540-4ba4-72a3-9fe4-df39bf393853"
                              }
                            }
                          }
                        ]
                      }
                    },
                    "id": "01a20c42-0f61-7830-855c-c3c1670edbfb",
                    "props": {
                      "direction": "endToStart"
                    },
                    "slots": {
                      "background": {
                        "id": "01a2ddf1-2f96-77f2-843a-efe37af06300",
                        "props": {
                          "alignment": "centerEnd",
                          "color": {
                            "$token": "color.errorContainer"
                          },
                          "padding": {
                            "horizontal": 24
                          }
                        },
                        "slots": {
                          "child": {
                            "id": "01a22281-13f5-7de4-a50a-7d7602590be2",
                            "props": {
                              "color": {
                                "$token": "color.onErrorContainer"
                              },
                              "icon": {
                                "name": "delete"
                              }
                            },
                            "semantics": {
                              "decorative": true
                            },
                            "type": "Icon"
                          }
                        },
                        "type": "Container"
                      },
                      "child": {
                        "id": "01a259b9-b31a-7a54-9277-02cf8267e527",
                        "slots": {
                          "subtitle": {
                            "id": "01a2fae7-2849-7282-928a-7f77f32d8f47",
                            "props": {
                              "data": {
                                "$expr": "format.money(money(mul(item.unitAmount, decimal(item.qty)), item.currency))"
                              },
                              "style": {
                                "$token": "typography.bodySmall"
                              }
                            },
                            "type": "Text"
                          },
                          "title": {
                            "id": "01a20890-5166-7341-8c4e-ec2ae66d1e33",
                            "props": {
                              "data": {
                                "$expr": "item.title"
                              },
                              "style": {
                                "$token": "typography.titleSmall"
                              }
                            },
                            "type": "Text"
                          },
                          "trailing": {
                            "events": {
                              "onChanged": {
                                "steps": [
                                  {
                                    "action": "condition",
                                    "branches": {
                                      "else": "set",
                                      "then": "drop"
                                    },
                                    "id": "zero",
                                    "input": {
                                      "when": {
                                        "$expr": "event == 0"
                                      }
                                    }
                                  },
                                  {
                                    "action": "dbDelete",
                                    "id": "drop",
                                    "input": {
                                      "collection": "cart",
                                      "key": {
                                        "$expr": "item.sku"
                                      }
                                    },
                                    "next": "reload"
                                  },
                                  {
                                    "action": "dbUpdate",
                                    "id": "set",
                                    "input": {
                                      "collection": "cart",
                                      "key": {
                                        "$expr": "item.sku"
                                      },
                                      "patch": {
                                        "qty": {
                                          "$expr": "event"
                                        }
                                      }
                                    },
                                    "next": "reload"
                                  },
                                  {
                                    "action": "refreshData",
                                    "id": "reload",
                                    "input": {
                                      "source": "cartLines"
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a2727a-4081-7817-8f8f-b2f408c242ba",
                            "props": {
                              "decreaseLabel": {
                                "$t": "01a2a927-8aef-718b-b57d-4fa4869f5ee2"
                              },
                              "increaseLabel": {
                                "$t": "01a22eff-ed63-73db-9f5a-03e699b344ef"
                              },
                              "max": 10,
                              "min": 0,
                              "step": 1,
                              "value": {
                                "$expr": "item.qty"
                              }
                            },
                            "semantics": {
                              "label": {
                                "$t": "01a2ee70-318e-7c0c-b9c9-f41ab9d88bf7"
                              }
                            },
                            "testId": "dc-line-qty",
                            "type": "QuantityStepper"
                          }
                        },
                        "type": "ListTile"
                      }
                    },
                    "testId": "dc-line",
                    "type": "Dismissible"
                  }
                },
                "testId": "dc-lines",
                "type": "ListView"
              }
            },
            "type": "Expanded"
          },
          {
            "id": "01a2ec13-9787-7a14-9760-bcd957c94d23",
            "props": {
              "condition": {
                "$expr": "!isEmpty((data.cartLines.value ?? []))"
              }
            },
            "slots": {
              "then": {
                "id": "01a2d94d-3833-7fbe-ada9-1c341aeb7000",
                "props": {
                  "top": false
                },
                "slots": {
                  "child": {
                    "id": "01a2261d-37c9-7447-9a05-b46b3109c22c",
                    "props": {
                      "padding": {
                        "all": 16
                      }
                    },
                    "slots": {
                      "child": {
                        "id": "01a2e7f9-ab19-7f7a-8240-796b6c1802a0",
                        "props": {
                          "duration": 200
                        },
                        "slots": {
                          "child": {
                            "events": {
                              "onCheckout": {
                                "steps": [
                                  {
                                    "action": "navigate",
                                    "id": "go",
                                    "input": {
                                      "route": "dc-checkout"
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a2cfc9-ac46-757d-96e7-4f6a7b223f46",
                            "props": {
                              "checkoutLabel": {
                                "$t": "01a24b14-db17-7785-822e-b48bf8c61ed3"
                              },
                              "lines": {
                                "$expr": "(data.cartLines.value ?? []).map(l, {\"label\": l.title + \" ×\" + string(l.qty), \"amount\": money(mul(l.unitAmount, decimal(l.qty)), l.currency)})"
                              },
                              "subtotal": {
                                "$expr": "money(sum((data.cartLines.value ?? []).map(l, mul(l.unitAmount, decimal(l.qty)))), \"EUR\")"
                              },
                              "subtotalLabel": {
                                "$t": "01a2a54f-9ff0-7819-90f8-e8f8e609ade9"
                              },
                              "total": {
                                "$expr": "money(sum((data.cartLines.value ?? []).map(l, mul(l.unitAmount, decimal(l.qty)))), \"EUR\")"
                              },
                              "totalLabel": {
                                "$t": "01a230ff-86cc-70a7-8d4d-0d1b58aca411"
                              }
                            },
                            "testId": "dc-summary",
                            "type": "CartSummary"
                          }
                        },
                        "type": "AnimatedSwitcher"
                      }
                    },
                    "type": "Padding"
                  }
                },
                "type": "SafeArea"
              }
            },
            "type": "If"
          }
        ],
        "id": "01a2906c-2d5b-7c32-9964-9b22040f3aaf",
        "props": {
          "crossAxisAlignment": "stretch"
        },
        "type": "Column"
      }
    },
    "type": "Scaffold"
  },
  "route": "dc-cart",
  "schemaVersion": "1.0.0",
  "title": {
    "$t": "01a22e36-c48a-73ad-a71d-d6c6efe3f6b8"
  }
}
