{
  "forms": [
    {
      "fields": [
        {
          "initial": "",
          "name": "code",
          "type": "string",
          "validators": [
            {
              "kind": "length",
              "max": 20
            },
            {
              "$graph": "01a2c238-ba9f-7447-b1fa-89ca52c34719",
              "debounceMs": 500,
              "kind": "async"
            }
          ]
        }
      ],
      "id": "01a28309-8a13-78c9-8a8c-64df60e190be",
      "name": "promo"
    }
  ],
  "id": "01a26dcc-c8f1-70ee-891b-86cbc672bcb7",
  "key": "dc-tickets",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "invokeFunction",
          "id": "quote",
          "input": {
            "function": "fees.quote",
            "input": {
              "currency": "EUR",
              "org": "devconf",
              "quantity": {
                "$expr": "plugin.qty"
              },
              "tier": {
                "$expr": "page.sel"
              }
            }
          },
          "next": "keep",
          "onError": "unknown"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "page.fee",
            "value": {
              "$expr": "{\"subtotal\": steps.quote.output?.subtotal ?? \"0\", \"tax\": steps.quote.output?.tax ?? \"0\", \"total\": steps.quote.output?.total ?? \"0\", \"currency\": steps.quote.output?.currency ?? \"EUR\"}"
            }
          }
        },
        {
          "action": "setState",
          "id": "unknown",
          "input": {
            "path": "page.fee",
            "value": {
              "$expr": "null"
            }
          }
        }
      ]
    }
  },
  "pageKind": "screen",
  "root": {
    "id": "01a2acb5-93bc-719e-baf0-4cf602b44866",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a27840-1f64-779d-a2b8-c0992c70d3d2",
        "props": {
          "backgroundColor": {
            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "actions": [
            {
              "events": {
                "onPressed": {
                  "steps": [
                    {
                      "action": "navigate",
                      "id": "go",
                      "input": {
                        "route": "dc-cart"
                      }
                    }
                  ]
                }
              },
              "id": "01a2d742-fcb1-7024-8e64-b064d681b8e8",
              "props": {
                "tooltip": {
                  "$t": "01a22e36-c48a-73ad-a71d-d6c6efe3f6b8"
                }
              },
              "slots": {
                "icon": {
                  "id": "01a23332-d67e-740b-8c96-7657f172ff21",
                  "props": {
                    "isLabelVisible": {
                      "$expr": "size(data.cartLines.value ?? []) > 0"
                    }
                  },
                  "slots": {
                    "child": {
                      "id": "01a275a0-201b-7ddf-9f91-5dc8d924e1a7",
                      "props": {
                        "icon": {
                          "name": "shopping_cart"
                        }
                      },
                      "semantics": {
                        "decorative": true
                      },
                      "type": "Icon"
                    },
                    "label": {
                      "id": "01a285c0-4d02-7202-91a5-6266dc311b8e",
                      "props": {
                        "data": {
                          "$expr": "string(size(data.cartLines.value ?? []))"
                        }
                      },
                      "type": "Text"
                    }
                  },
                  "type": "Badge"
                }
              },
              "testId": "dc-cart-go",
              "type": "IconButton"
            }
          ],
          "title": {
            "id": "01a22786-b02f-7acd-a63c-e63cc89861c1",
            "props": {
              "data": {
                "$t": "01a23248-394c-77ba-963a-49d01ad30b2b"
              },
              "maxLines": 1,
              "overflow": "ellipsis"
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01a25d06-aa5f-7f92-bcc4-d5ad5840208e",
        "slots": {
          "child": {
            "id": "01a2b651-1859-7cbf-8975-53dcd3b078d3",
            "props": {
              "form": "promo"
            },
            "slots": {
              "child": {
                "id": "01a2a209-cf08-711f-8673-19724cdf8e80",
                "props": {
                  "padding": {
                    "vertical": 16
                  }
                },
                "slots": {
                  "child": {
                    "children": [
                      {
                        "id": "01a2ee92-e10c-7660-8931-3b395a1f49d3",
                        "props": {
                          "items": {
                            "$expr": "data.tickets.value ?? []"
                          }
                        },
                        "slots": {
                          "item": {
                            "id": "01a2904e-c484-7257-8088-34e2aa7c4641",
                            "props": {
                              "padding": {
                                "horizontal": 16,
                                "vertical": 6
                              }
                            },
                            "slots": {
                              "child": {
                                "id": "01a25ad0-2de9-7d2c-92ef-1e44d05868c3",
                                "props": {
                                  "decoration": {
                                    "border": {
                                      "all": {
                                        "color": {
                                          "$token": "color.primary"
                                        },
                                        "width": {
                                          "$expr": "page.sel == item.sku ? 2.0 : 0.0"
                                        }
                                      }
                                    },
                                    "borderRadius": {
                                      "all": {
                                        "$token": "radius.lg"
                                      }
                                    }
                                  },
                                  "duration": 200
                                },
                                "slots": {
                                  "child": {
                                    "events": {
                                      "onAddToCart": {
                                        "steps": [
                                          {
                                            "action": "setState",
                                            "id": "line",
                                            "input": {
                                              "path": "plugin.line",
                                              "value": {
                                                "$expr": "{\"sku\": item.sku, \"title\": item.title, \"unitAmount\": amount(item.price), \"currency\": currency(item.price), \"qty\": plugin.qty, \"kind\": \"ticket\"}"
                                              }
                                            },
                                            "next": "put"
                                          },
                                          {
                                            "action": "dbUpsert",
                                            "id": "put",
                                            "input": {
                                              "collection": "cart",
                                              "key": {
                                                "$expr": "item.sku"
                                              },
                                              "record": {
                                                "$expr": "plugin.line"
                                              }
                                            },
                                            "next": "reload"
                                          },
                                          {
                                            "action": "refreshData",
                                            "id": "reload",
                                            "input": {
                                              "source": "cartLines"
                                            },
                                            "next": "say"
                                          },
                                          {
                                            "action": "showSnackbar",
                                            "branches": {
                                              "action": "cart"
                                            },
                                            "id": "say",
                                            "input": {
                                              "actionLabel": {
                                                "$t": "01a2ad78-9484-7e0a-b2b7-bc4cd7dc0b2d"
                                              },
                                              "message": {
                                                "$t": "01a2befe-4a47-7789-b56b-aa687381b7e4"
                                              }
                                            }
                                          },
                                          {
                                            "action": "navigate",
                                            "id": "cart",
                                            "input": {
                                              "route": "dc-cart"
                                            }
                                          }
                                        ]
                                      },
                                      "onTap": {
                                        "steps": [
                                          {
                                            "action": "setState",
                                            "id": "sel",
                                            "input": {
                                              "path": "page.sel",
                                              "value": {
                                                "$expr": "item.sku"
                                              }
                                            },
                                            "next": "quote"
                                          },
                                          {
                                            "action": "invokeFunction",
                                            "id": "quote",
                                            "input": {
                                              "function": "fees.quote",
                                              "input": {
                                                "currency": "EUR",
                                                "org": "devconf",
                                                "quantity": {
                                                  "$expr": "plugin.qty"
                                                },
                                                "tier": {
                                                  "$expr": "item.sku"
                                                }
                                              }
                                            },
                                            "next": "keep",
                                            "onError": "unknown"
                                          },
                                          {
                                            "action": "setState",
                                            "id": "keep",
                                            "input": {
                                              "path": "page.fee",
                                              "value": {
                                                "$expr": "{\"subtotal\": steps.quote.output?.subtotal ?? \"0\", \"tax\": steps.quote.output?.tax ?? \"0\", \"total\": steps.quote.output?.total ?? \"0\", \"currency\": steps.quote.output?.currency ?? \"EUR\"}"
                                              }
                                            }
                                          },
                                          {
                                            "action": "setState",
                                            "id": "unknown",
                                            "input": {
                                              "path": "page.fee",
                                              "value": {
                                                "$expr": "null"
                                              }
                                            }
                                          }
                                        ]
                                      }
                                    },
                                    "id": "01a20e06-cf01-7434-b6c2-94fa6b1f834a",
                                    "props": {
                                      "addToCartLabel": {
                                        "$t": "01a2af24-d2df-7a19-bda8-280620746684"
                                      },
                                      "badge": {
                                        "$expr": "item.badge == \"popular\" ? t(\"01a2a593-dfa6-729b-b813-14b3af980bbf\") : null"
                                      },
                                      "originalPrice": {
                                        "$expr": "item.originalPrice == null ? null : format.money(item.originalPrice ?? item.price)"
                                      },
                                      "price": {
                                        "$expr": "format.money(item.price)"
                                      },
                                      "title": {
                                        "$expr": "item.title"
                                      }
                                    },
                                    "testId": "dc-ticket",
                                    "type": "ProductCard"
                                  }
                                },
                                "type": "AnimatedContainer"
                              }
                            },
                            "type": "Padding"
                          }
                        },
                        "type": "ForEach"
                      },
                      {
                        "id": "01a22440-bc47-7314-96f8-2ca4fcd50022",
                        "props": {
                          "padding": {
                            "horizontal": 16
                          }
                        },
                        "slots": {
                          "child": {
                            "children": [
                              {
                                "id": "01a2aeb4-20ca-7648-8f00-edc0bebd9c7a",
                                "props": {
                                  "condition": {
                                    "$expr": "page.fee != null"
                                  }
                                },
                                "slots": {
                                  "else": {
                                    "id": "01a2647e-51b2-7d6d-81b8-b214f7e57e2c",
                                    "props": {
                                      "data": {
                                        "$t": "01a22e05-cd8c-732f-950a-a9a6f30c5342"
                                      },
                                      "style": {
                                        "$token": "typography.bodyMedium"
                                      }
                                    },
                                    "type": "Text"
                                  },
                                  "then": {
                                    "id": "01a22f89-cb45-7968-a366-ef6cad83f0c8",
                                    "props": {
                                      "price": {
                                        "$expr": "money(page.fee?.total ?? \"0\", \"EUR\")"
                                      },
                                      "wasLabel": {
                                        "$t": "01a20d62-f038-7f36-9ad2-6b6d4a19ce32"
                                      }
                                    },
                                    "type": "PriceTag"
                                  }
                                },
                                "type": "If"
                              },
                              {
                                "events": {
                                  "onChanged": {
                                    "steps": [
                                      {
                                        "action": "setState",
                                        "id": "q",
                                        "input": {
                                          "path": "plugin.qty",
                                          "value": {
                                            "$expr": "event"
                                          }
                                        },
                                        "next": "quote"
                                      },
                                      {
                                        "action": "invokeFunction",
                                        "id": "quote",
                                        "input": {
                                          "function": "fees.quote",
                                          "input": {
                                            "currency": "EUR",
                                            "org": "devconf",
                                            "quantity": {
                                              "$expr": "plugin.qty"
                                            },
                                            "tier": {
                                              "$expr": "page.sel"
                                            }
                                          }
                                        },
                                        "next": "keep",
                                        "onError": "unknown"
                                      },
                                      {
                                        "action": "setState",
                                        "id": "keep",
                                        "input": {
                                          "path": "page.fee",
                                          "value": {
                                            "$expr": "{\"subtotal\": steps.quote.output?.subtotal ?? \"0\", \"tax\": steps.quote.output?.tax ?? \"0\", \"total\": steps.quote.output?.total ?? \"0\", \"currency\": steps.quote.output?.currency ?? \"EUR\"}"
                                          }
                                        }
                                      },
                                      {
                                        "action": "setState",
                                        "id": "unknown",
                                        "input": {
                                          "path": "page.fee",
                                          "value": {
                                            "$expr": "null"
                                          }
                                        }
                                      }
                                    ]
                                  }
                                },
                                "id": "01a2fa2a-fa1b-7e85-be55-cbb6a57e3d8d",
                                "props": {
                                  "decreaseLabel": {
                                    "$t": "01a2246a-b24a-7109-b492-7c681e197d0b"
                                  },
                                  "increaseLabel": {
                                    "$t": "01a2a85f-62c3-7c98-bc52-df7d6ee5afff"
                                  },
                                  "max": 10,
                                  "min": 1,
                                  "step": 1,
                                  "value": {
                                    "$expr": "plugin.qty"
                                  }
                                },
                                "semantics": {
                                  "label": {
                                    "$t": "01a246de-9614-76a8-bd29-052cacfe49ca"
                                  }
                                },
                                "testId": "dc-qty",
                                "type": "QuantityStepper"
                              }
                            ],
                            "id": "01a2683d-82f1-72db-a1a3-a900fe71de30",
                            "props": {
                              "mainAxisAlignment": "spaceBetween"
                            },
                            "type": "Row"
                          }
                        },
                        "type": "Padding"
                      },
                      {
                        "id": "01a20d54-e3e4-76d6-acb9-9869ea3d3de3",
                        "props": {
                          "padding": {
                            "horizontal": 16
                          }
                        },
                        "slots": {
                          "child": {
                            "events": {
                              "onChanged": {
                                "steps": [
                                  {
                                    "action": "setState",
                                    "id": "set",
                                    "input": {
                                      "path": "page.promo.values.code",
                                      "value": {
                                        "$expr": "event"
                                      }
                                    },
                                    "next": "touch"
                                  },
                                  {
                                    "action": "setState",
                                    "id": "touch",
                                    "input": {
                                      "path": "page.promo.touched.code",
                                      "value": true
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a2bec6-ea3d-7207-bfc5-1f5557b30786",
                            "props": {
                              "decoration": {
                                "filled": true,
                                "labelText": {
                                  "$t": "01a2a231-0f70-739a-b510-7c6fe3bd6fad"
                                },
                                "prefixIcon": {
                                  "name": "sell"
                                }
                              },
                              "forceErrorText": {
                                "$expr": "page.promo.touched.code ? page.promo.errors.code : null"
                              },
                              "textCapitalization": "characters",
                              "value": {
                                "$expr": "form.values.code"
                              }
                            },
                            "testId": "dc-promo-code",
                            "type": "TextFormField"
                          }
                        },
                        "type": "Padding"
                      },
                      {
                        "id": "01a2ff69-e006-750c-acca-a5556ba98600",
                        "props": {
                          "condition": {
                            "$expr": "page.promo.validating"
                          }
                        },
                        "slots": {
                          "then": {
                            "id": "01a2ad94-5dfb-79fa-933f-728c682bc905",
                            "props": {
                              "padding": {
                                "horizontal": 16
                              }
                            },
                            "slots": {
                              "child": {
                                "id": "01a235ca-2506-777c-ad3d-c1a62af1507f",
                                "props": {
                                  "minHeight": 2,
                                  "semanticsLabel": {
                                    "$t": "01a2862b-62fe-783c-a3a6-fecd4da8b8f4"
                                  }
                                },
                                "type": "LinearProgressIndicator"
                              }
                            },
                            "type": "Padding"
                          }
                        },
                        "type": "If"
                      }
                    ],
                    "id": "01a2e24a-925f-7a82-80e4-e7049a9d9e6c",
                    "props": {
                      "crossAxisAlignment": "stretch",
                      "spacing": 12
                    },
                    "type": "Column"
                  }
                },
                "type": "SingleChildScrollView"
              }
            },
            "type": "FormScope"
          }
        },
        "type": "SafeArea"
      }
    },
    "type": "Scaffold"
  },
  "route": "dc-tickets",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": "standard",
      "id": "01a2d017-2f6c-73a4-a92d-fb6855b68f1d",
      "name": "sel",
      "type": "string"
    },
    {
      "default": null,
      "id": "01a29fd6-9298-73ae-abca-59e6d479e3de",
      "name": "fee",
      "type": "FeeQuote?"
