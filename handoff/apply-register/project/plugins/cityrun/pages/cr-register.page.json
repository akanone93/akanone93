        "type": "SafeArea"
      },
      "bottomNavigationBar": {
        "component": {
          "id": "01a2b909-cbad-77df-b6b6-d36ce2fb1df9",
          "version": 1
        },
        "events": {
          "onSubmit": {
            "concurrency": "drop",
            "steps": [
              {
                "action": "submitForm",
                "branches": {
                  "invalid": "fix"
                },
                "id": "check",
                "input": {
                  "form": "runner"
                },
                "next": "busy"
              },
              {
                "action": "announce",
                "id": "fix",
                "input": {
                  "assertiveness": "assertive",
                  "message": {
                    "$t": "01a2c3dd-6ebd-7df9-96b1-f1a13795033f"
                  }
                }
              },
              {
                "action": "setState",
                "id": "busy",
                "input": {
                  "path": "page.submitting",
                  "value": true
                },
                "next": "pay"
              },
              {
                "action": "callFlow",
                "id": "pay",
                "input": {
                  "flow": "pay/pay-with-wallet",
                  "input": {
                    "req": {
                      "amount": {
                        "$expr": "money(page.fee?.total ?? \"0\", \"EUR\")"
                      },
                      "payee": "Riverton City Run",
                      "purpose": {
                        "$t": "01a2a9e1-143f-785b-a77a-52940392ab7b"
                      },
                      "reference": {
                        "$expr": "\"CR-\" + string(int(page.runner.values.distance * 10.0)) + \"-\" + string(plugin.wave + 1)"
                      }
                    }
                  }
                },
                "next": "paid",
                "onError": "failed"
              },
              {
                "action": "condition",
                "branches": {
                  "else": "idle",
                  "then": "reg"
                },
                "id": "paid",
                "input": {
                  "when": {
                    "$expr": "steps.pay.output?.status == \"success\""
                  }
                }
              },
              {
                "action": "apiCall",
                "id": "reg",
                "input": {
                  "input": {
                    "distance": {
                      "$expr": "page.runner.values.distance"
                    },
                    "emergency": {
                      "$expr": "page.runner.values.emergency"
                    },
                    "medical": {
                      "$expr": "page.runner.values.medical"
                    },
                    "pace": {
                      "$expr": "page.runner.values.pace"
                    },
                    "paymentId": {
                      "$expr": "steps.pay.output?.transactionId ?? \"\""
                    },
                    "shirt": {
                      "$expr": "page.runner.values.shirt"
                    },
                    "wave": {
                      "$expr": "plugin.wave"
                    }
                  },
                  "operation": "api.register"
                },
                "next": "bib",
                "onError": "idle"
              },
              {
                "action": "setState",
                "id": "bib",
                "input": {
                  "path": "plugin.bib",
                  "value": {
                    "$expr": "steps.reg.output?.bib ?? \"\""
                  }
                },
                "next": "go"
              },
              {
                "action": "navigate",
                "id": "go",
                "input": {
                  "mode": "replace",
                  "route": "cr-bib"
                }
              },
              {
                "action": "showSnackbar",
                "id": "failed",
                "input": {
                  "message": {
                    "$t": "01a20873-6230-7dcb-8232-8cee864645b5"
                  }
                },
                "next": "idle"
              },
              {
                "action": "setState",
                "id": "idle",
                "input": {
                  "path": "page.submitting",
                  "value": false
                }
              }
            ]
          }
        },
        "id": "01a24527-9b1a-753a-9c1b-a67597fc0c3d",
        "props": {
          "busy": {
            "$expr": "page.submitting"
          },
          "enabled": {
            "$expr": "page.fee != null"
          },
          "label": {
            "$t": "01a244bf-62d1-7ee5-945a-66f196bd0da4"
          }
        },
        "testId": "cr-submit"
      }
    },
    "type": "Scaffold"
  },
