  "id": "01a2d0f2-b5f1-7071-8128-5d7cb73fc0c9",
  "key": "cr-register",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "setState",
          "id": "dist",
          "input": {
            "path": "page.runner.values.distance",
            "value": {
              "$expr": "plugin.distance"
            }
          },
          "next": "quote"
        },
        {
          "action": "invokeFunction",
          "id": "quote",
          "input": {
            "function": "fees.quote",
            "input": {
              "currency": "EUR",
              "org": "cityrun",
              "quantity": 1,
              "tier": {
                "$expr": "plugin.distance <= 5.0 ? \"5k\" : plugin.distance <= 10.0 ? \"10k\" : plugin.distance <= 21.1 ? \"half\" : \"full\""
              }
            }
          },
          "next": "keep",
          "onError": "noFee"
        },
        {
          "action": "setState",
          "id": "keep",
          "input": {
            "path": "page.fee",
            "value": {
              "$expr": "{\"subtotal\": steps.quote.output?.subtotal ?? \"0\", \"tax\": steps.quote.output?.tax ?? \"0\", \"total\": steps.quote.output?.total ?? \"0\", \"currency\": steps.quote.output?.currency ?? \"EUR\"}"
            }
          },
          "next": "ok"
        },
        {
          "action": "setState",
          "id": "ok",
          "input": {
            "path": "page.feeError",
            "value": false
          },
          "next": "f"
        },
        {
          "action": "setState",
          "id": "noFee",
          "input": {
            "path": "page.feeError",
            "value": true
          },
          "next": "f"
        },
        {
          "action": "invokeFunction",
          "id": "f",
          "input": {
            "function": "run.finishTime",
            "input": {
              "distanceKm": {
                "$expr": "string(plugin.distance)"
              },
              "paceSecPerKm": {
                "$expr": "page.runner.values.pace"
              }
            }
          },
          "next": "show",
          "onError": "bad"
        },
        {
          "action": "setState",
          "id": "show",
          "input": {
            "path": "page.finish",
            "value": {
              "$expr": "steps.f.output?.label ?? \"\""
            }
          }
        },
        {
          "action": "showToast",
          "id": "bad",
          "input": {
            "message": {
              "$t": "01a24fae-ff92-7eff-bf32-030687c7524a"
            }
          }
        }
      ]
    }
  },
