{
  "id": "01a2dc52-7fea-7f02-ad7e-3a7fb3c65f97",
  "key": "rl-history",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01a2ead8-2c72-781b-bf53-0d20c8f47418",
    "props": {
      "backgroundColor": {
        "$token": "color.surface"
      }
    },
    "slots": {
      "appBar": {
        "id": "01a289e1-0657-71f4-a29a-c997e666086d",
        "props": {
          "backgroundColor": {
            "$token": "color.surface"
          },
          "centerTitle": false,
          "elevation": 0,
          "foregroundColor": {
            "$token": "color.onSurface"
          },
          "scrolledUnderElevation": 2
        },
        "slots": {
          "title": {
            "id": "01a29afb-708a-7ae5-9aca-f4be05075978",
            "props": {
              "data": {
                "$t": "01a2a3eb-fd0e-72e1-aba9-b6d8eb449c4d"
              },
              "maxLines": 1,
              "overflow": "ellipsis"
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "children": [
          {
            "id": "01a25131-499f-7ef8-8974-0d778436b62f",
            "props": {
              "padding": {
                "all": 16
              }
            },
            "slots": {
              "child": {
                "children": [
                  {
                    "id": "01a2c333-67fb-75c5-85b4-64378ab255b5",
                    "props": {
                      "data": {
                        "$t": "01a2e23e-8e7c-7e7d-8987-02ba8d0b5438"
                      },
                      "style": {
                        "$token": "typography.titleSmall"
                      }
                    },
                    "type": "Text"
                  },
                  {
                    "id": "01a23064-894e-70fe-a135-5bc6d47c2fba",
                    "props": {
                      "signDisplay": "always",
                      "style": {
                        "$token": "typography.titleMedium"
                      },
                      "value": {
                        "$expr": "money(sum((data.donations.value ?? []).filter(d, d.status == \"completed\" && currency(d.amount) == \"EUR\").map(d, amount(d.amount))), \"EUR\")"
                      }
                    },
                    "type": "MoneyText"
                  }
                ],
                "id": "01a2bd7b-77aa-7024-b5ea-24a38162d76e",
                "props": {
                  "mainAxisAlignment": "spaceBetween"
                },
                "type": "Row"
              }
            },
            "type": "Padding"
          },
          {
            "id": "01a23669-58f6-70af-b5f4-335d91526d64",
            "slots": {
              "child": {
                "events": {
                  "onRefresh": {
                    "steps": [
                      {
                        "action": "refreshData",
                        "id": "again",
                        "input": {
                          "source": "donations"
                        }
                      }
                    ]
                  }
                },
                "id": "01a2328f-a091-7c99-969d-60b579402243",
                "props": {
                  "semanticsLabel": {
                    "$t": "01a25b7c-0709-7485-ac9f-fe79aa694f6a"
                  }
                },
                "slots": {
                  "child": {
                    "id": "01a2364c-bc2d-7196-9e5e-cf98ce789e07",
                    "props": {
                      "items": {
                        "$expr": "data.donations.value ?? []"
                      },
                      "padding": {
                        "vertical": 8
                      },
                      "status": {
                        "$expr": "data.donations.status"
                      }
                    },
                    "slots": {
                      "item": {
                        "events": {
                          "onTap": {
                            "steps": [
                              {
                                "action": "navigate",
                                "id": "go",
                                "input": {
                                  "params": {
                                    "id": {
                                      "$expr": "item.receiptId"
                                    }
                                  },
                                  "route": "ps-receipt"
                                }
                              }
                            ]
                          }
                        },
                        "id": "01a2aadb-d548-7b35-a234-9418e037f1da",
                        "props": {
                          "amount": {
                            "$expr": "item.amount"
                          },
                          "date": {
                            "$expr": "item.at"
                          },
                          "status": {
                            "$expr": "item.status == \"pending\" ? \"pending\" : item.status == \"failed\" ? \"failed\" : item.status == \"reversed\" ? \"reversed\" : \"completed\""
                          },
                          "statusLabel": {
                            "$expr": "item.status == \"pending\" ? t(\"01a279d9-893c-75dc-90e5-7f7041127498\") : item.status == \"failed\" ? t(\"01a2de08-2011-7dc4-9302-7e29cc584b2d\") : item.status == \"reversed\" ? t(\"01a2ee7c-9208-7346-b124-ff9ad7850b80\") : t(\"01a28e3c-b707-76be-a1c6-97e1c251eb41\")"
                          },
                          "subtitle": {
                            "$expr": "item.subtitle"
                          },
                          "title": {
                            "$expr": "item.title"
                          }
                        },
                        "testId": "rl-donation",
                        "type": "TransactionListItem"
                      }
                    },
                    "testId": "rl-donations",
                    "type": "ListView"
                  }
                },
                "testId": "rl-refresh",
                "type": "RefreshIndicator"
              }
            },
            "type": "Expanded"
          }
        ],
        "id": "01a26599-b6a5-7317-8b13-6c5b20a895f3",
        "props": {
          "crossAxisAlignment": "stretch"
        },
        "type": "Column"
      }
    },
    "type": "Scaffold"
  },
  "route": "rl-history",
  "schemaVersion": "1.0.0",
  "security": {
    "secure": true
  },
  "title": {
    "$t": "01a2a3eb-fd0e-72e1-aba9-b6d8eb449c4d"
  }
}
