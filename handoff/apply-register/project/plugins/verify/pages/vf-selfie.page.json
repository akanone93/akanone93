{
  "id": "01a2c946-813a-7550-a168-91a1965eb5e7",
  "key": "vf-selfie",
  "kind": "page",
  "lifecycle": {
    "onEnter": {
      "steps": [
        {
          "action": "requestPermission",
          "id": "ask",
          "input": {
            "permission": "camera"
          }
        }
      ]
    }
  },
  "pageKind": "fullscreenDialog",
  "result": "VerifyResult",
  "root": {
    "id": "01a21808-7ce5-7a23-a3b5-50203aee9f9e",
    "props": {
      "backgroundColor": {
        "$token": "color.scrim"
      }
    },
    "slots": {
      "body": {
        "children": [
          {
            "events": {
              "onCaptured": {
                "concurrency": "drop",
                "steps": [
                  {
                    "action": "apiCall",
                    "id": "up",
                    "input": {
                      "input": {
                        "file": {
                          "$expr": "event"
                        }
                      },
                      "operation": "verify.upload"
                    },
                    "next": "ok",
                    "onError": "fail"
                  },
                  {
                    "action": "pop",
                    "id": "ok",
                    "input": {
                      "result": {
                        "value": {
                          "$expr": "steps.up.output?.fileId ?? \"\""
                        },
                        "verified": true
                      }
                    }
                  },
                  {
                    "action": "showSnackbar",
                    "id": "fail",
                    "input": {
                      "message": {
                        "$t": "01a29a30-e26a-7f45-9359-c2c3dddb4b41"
                      }
                    }
                  }
                ]
              }
            },
            "id": "01a2287a-7972-7c3c-aed6-cf244fcc56d2",
            "props": {
              "mode": "selfie"
            },
            "semantics": {
              "label": {
                "$t": "01a2c5ff-bd76-7d4d-ab66-aa1d4efce9bd"
              }
            },
            "testId": "vf-selfie-camera",
            "type": "KycCameraCapture"
          },
          {
            "id": "01a2fa9f-9f3b-7ac3-a488-abb4a74b2505",
            "props": {
              "alignment": "topCenter"
            },
            "slots": {
              "child": {
                "id": "01a2efd4-f0ba-7c2b-a0a6-4e3af7b724cf",
                "slots": {
                  "child": {
                    "id": "01a25239-4cac-7a79-afeb-02c63a5fcccb",
                    "props": {
                      "decoration": {
                        "borderRadius": {
                          "all": {
                            "$token": "radius.md"
                          }
                        },
                        "color": {
                          "$token": "color.inverseSurface"
                        }
                      },
                      "margin": {
                        "all": 16
                      },
                      "padding": {
                        "all": 8
                      }
                    },
                    "slots": {
                      "child": {
                        "children": [
                          {
                            "events": {
                              "onPressed": {
                                "steps": [
                                  {
                                    "action": "pop",
                                    "id": "no",
                                    "input": {
                                      "result": {
                                        "value": null,
                                        "verified": false
                                      }
                                    }
                                  }
                                ]
                              }
                            },
                            "id": "01a272ae-6fae-74a8-813d-99d82b8bb46f",
                            "props": {
                              "color": {
                                "$token": "color.onInverseSurface"
                              }
                            },
                            "semantics": {
                              "label": {
                                "$t": "01a23542-43c9-703c-8d4e-a4320d2855b0"
                              }
                            },
                            "testId": "vf-selfie-close",
                            "type": "CloseButton"
                          },
                          {
                            "id": "01a29ec4-39a5-7bbf-9e08-9f04603d0c8a",
                            "slots": {
                              "child": {
                                "id": "01a283da-5cdc-74ec-b545-a4591431e223",
                                "props": {
                                  "data": {
                                    "$t": "01a298ae-3e98-7869-bd97-28d1f68160dd"
                                  },
                                  "style": {
                                    "base": {
                                      "$token": "typography.titleMedium"
                                    },
                                    "color": {
                                      "$token": "color.onInverseSurface"
                                    }
                                  }
                                },
                                "type": "Text"
                              }
                            },
                            "type": "Expanded"
                          }
                        ],
                        "id": "01a204e5-7d1d-70e9-a193-ed46b9bac192",
                        "props": {
                          "spacing": 8
                        },
                        "type": "Row"
                      }
                    },
                    "type": "Container"
                  }
                },
                "type": "SafeArea"
              }
            },
            "type": "Align"
          }
        ],
        "id": "01a2b155-96e6-7cdf-845e-133c58aa4a75",
        "props": {
          "fit": "expand"
        },
        "type": "Stack"
      }
    },
    "type": "Scaffold"
  },
  "route": "vf-selfie",
  "schemaVersion": "1.0.0",
  "security": {
    "secure": true
  },
  "title": {
    "$t": "01a2c5ff-bd76-7d4d-ab66-aa1d4efce9bd"
  }
}
