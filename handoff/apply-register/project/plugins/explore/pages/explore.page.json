                        "next": "keep"
                      },
                      {
                        "action": "setState",
                        "id": "keep",
                        "input": {
                          "path": "app.recentSearches",
                          "value": {
                            "$expr": "slice(distinct([event] + app.recentSearches), 0, min(8, size(distinct([event] + app.recentSearches))))"
                          }
                        },
                        "next": "load"
                      },
                      {
                        "action": "refreshData",
                        "id": "load",
                        "input": {
                          "source": "orgs"
                        }
                      }
                    ]
                  }
                },
                "id": "01a222a3-74c1-777c-aa3a-ba9080ec735f",
