{
  "description": "Lets staff and maintainers in; everyone else gets the fallback.",
  "id": "01a28c0a-756e-7399-b9fb-8f610a8db201",
  "key": "staff-only",
  "kind": "actionGraph",
  "output": "GuardResult",
  "schemaVersion": "1.0.0",
  "steps": [
    {
      "action": "condition",
      "branches": {
        "else": "no",
        "then": "yes"
      },
      "id": "gate",
      "input": {
        "when": {
          "$expr": "user.role == \"staff\" || user.role == \"maintainer\""
        }
      }
    },
    {
      "action": "stop",
      "id": "yes",
      "input": {
        "result": "allow"
      }
    },
    {
      "action": "stop",
      "id": "no",
      "input": {
        "result": {
          "decision": "fallback"
        }
      }
    }
  ]
}
