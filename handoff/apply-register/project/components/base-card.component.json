{
  "description": "The only card style: flat, raised or outlined, optionally tappable and selected.",
  "events": [
    {
      "name": "onTap"
    }
  ],
  "id": "01a21f96-bfbe-7fa2-a198-5345d15df796",
  "key": "base-card",
  "kind": "component",
  "name": "BaseCard",
  "props": [
    {
      "default": "raised",
      "name": "variant",
      "type": "string"
    },
    {
      "default": false,
      "name": "tappable",
      "type": "bool"
    },
    {
      "default": false,
      "name": "selected",
      "type": "bool"
    },
    {
      "default": false,
      "name": "dense",
      "type": "bool"
    },
    {
      "name": "semanticLabel",
      "type": "string?"
    }
  ],
  "root": {
    "id": "01a2882f-ead6-7b18-8405-f649cd32c205",
    "props": {
      "clipBehavior": "antiAlias",
      "color": {
        "$token": "color.surfaceContainerLow"
      },
      "elevation": {
        "$expr": "props.variant == \"raised\" ? 2.0 : 0.0"
      },
      "margin": {
        "all": 0
      },
      "shape": {
        "borderRadius": {
          "all": {
            "$token": "radius.card"
          }
        },
        "kind": "roundedRectangle",
        "side": {
          "color": {
            "$token": "color.outlineVariant"
          },
          "width": {
            "$expr": "props.selected ? 2.0 : props.variant == \"outlined\" ? 1.0 : 0.0"
          }
        }
      }
    },
    "semantics": {
      "group": true
    },
    "slots": {
      "child": {
        "events": {
          "onHighlightChanged": {
            "steps": [
              {
                "action": "setState",
                "id": "press",
                "input": {
                  "path": "component.pressed",
                  "value": {
                    "$expr": "event"
                  }
                }
              }
            ]
          },
          "onTap": {
            "steps": [
              {
                "action": "condition",
                "branches": {
                  "then": "emit"
                },
                "id": "when",
                "input": {
                  "when": {
                    "$expr": "props.tappable"
                  }
                }
              },
              {
                "action": "emitEvent",
                "id": "emit",
                "input": {
                  "event": "onTap"
                }
              }
            ]
          }
        },
        "id": "01a27835-2bb0-7b0b-89d7-4c77353efa06",
        "props": {
          "borderRadius": {
            "all": {
              "$token": "radius.card"
            }
          }
        },
        "semantics": {
          "button": true,
          "label": {
            "$expr": "props.semanticLabel ?? \"\""
          }
        },
        "slots": {
          "child": {
            "id": "01a2c91f-dd5f-7052-87c4-e2324293b035",
            "props": {
              "duration": 120,
              "scale": {
                "$expr": "component.pressed && props.tappable ? 0.98 : 1.0"
              }
            },
            "slots": {
              "child": {
                "children": [
                  {
                    "id": "01a2f23f-844e-723b-b954-e8a916b32de3",
                    "props": {
                      "name": "media"
                    },
                    "type": "Slot"
                  },
                  {
                    "id": "01a277c7-4f9a-7526-a688-0745f6a4de86",
                    "props": {
                      "padding": {
                        "all": {
                          "$expr": "props.dense ? 12.0 : 16.0"
                        }
                      }
                    },
                    "slots": {
                      "child": {
                        "id": "01a267fc-0126-72b3-b8d8-20ef4f8ca1ca",
                        "props": {
                          "name": "content"
                        },
                        "type": "Slot"
                      }
                    },
                    "type": "Padding"
                  },
                  {
                    "id": "01a259b2-18f9-716c-aedd-88d31d7c477b",
                    "props": {
                      "padding": {
                        "bottom": 8,
                        "left": 8,
                        "right": 8
                      }
                    },
                    "slots": {
                      "child": {
                        "children": [
                          {
                            "id": "01a2bd82-0766-7616-a5e3-99c69a9d24e4",
                            "props": {
                              "name": "actions"
                            },
                            "type": "Slot"
                          }
                        ],
                        "id": "01a2f13e-58d5-7106-ae06-71bfe39b1bb1",
                        "props": {
                          "mainAxisAlignment": "end"
                        },
                        "type": "Row"
                      }
                    },
                    "type": "Padding"
                  }
                ],
                "id": "01a23454-2d18-70af-8ad0-79dd36dde276",
                "props": {
                  "crossAxisAlignment": "stretch",
                  "mainAxisSize": "min"
                },
                "type": "Column"
              }
            },
            "type": "AnimatedScale"
          }
        },
        "type": "InkWell"
      }
    },
    "type": "Card"
  },
  "schemaVersion": "1.0.0",
  "slots": [
    {
      "name": "media"
    },
    {
      "name": "content"
    },
    {
      "name": "actions"
    }
  ],
  "state": [
    {
      "default": false,
      "id": "01a2cb48-02e1-701d-990b-a516b4bbbe11",
      "name": "pressed",
      "type": "bool"
    }
  ],
  "version": 1
}
