{
  "description": "What a list says when it has nothing, with an optional call to action.",
  "events": [
    {
      "name": "onCta"
    }
  ],
  "id": "01a266bd-c9c7-7bb0-b0ed-64508b5f61cf",
  "key": "empty-hint",
  "kind": "component",
  "name": "EmptyHint",
  "props": [
    {
      "name": "title",
      "required": true,
      "type": "string"
    },
    {
      "name": "message",
      "type": "string?"
    },
    {
      "name": "cta",
      "type": "string?"
    }
  ],
  "root": {
    "id": "01a20f86-751e-715d-8884-5ad9621e642b",
    "props": {
      "message": {
        "$expr": "props.message"
      },
      "title": {
        "$expr": "props.title"
      }
    },
    "slots": {
      "action": {
        "id": "01a25fc2-594e-7ea9-b283-e10e98b602a0",
        "props": {
          "condition": {
            "$expr": "props.cta != null"
          }
        },
        "slots": {
          "then": {
            "events": {
              "onPressed": {
                "steps": [
                  {
                    "action": "emitEvent",
                    "id": "emit",
                    "input": {
                      "event": "onCta"
                    }
                  }
                ]
              }
            },
            "id": "01a22c28-3461-78f2-bf2a-433533892ad3",
            "slots": {
              "child": {
                "id": "01a2354c-fdb6-7d31-9aea-a074f7bdea1d",
                "props": {
                  "data": {
                    "$expr": "props.cta ?? \"\""
                  }
                },
                "type": "Text"
              }
            },
            "type": "FilledButton"
          }
        },
        "type": "If"
      }
    },
    "type": "EmptyState"
  },
  "schemaVersion": "1.0.0",
  "version": 1
}
