          {
            "id": "wf3",
            "type": "SizedBox",
            "props": {
              "width": 300
            },
            "children": [
              {
                "id": "f3",
                "type": "TextField",
                "props": {
                  "suffixText": "kg",
                  "isDense": true,
                  "filled": true,
                  "text": "9"
