                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "id": "d",
            "type": "SizedBox",
            "props": {
              "width": 360,
              "height": 300
            },
            "children": [
              {
                "id": "dr",
                "type": "Row",
