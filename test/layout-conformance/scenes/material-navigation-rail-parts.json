                          }
                        ]
                      },
                      {
                        "id": "r3d1",
                        "type": "NavigationRailDestination",
                        "props": {
                          "label": "Search"
                        },
                        "children": [
                          {
                            "id": "r3d1-icon",
                            "type": "Icon",
                            "props": {
                              "size": 24
                            },
                            "slot": "icon"
                          }
                        ]
                      },
                      {
                        "id": "r3lead",
