            "props": {
              "width": 360,
              "height": 420
            },
            "children": [
              {
                "id": "cr",
                "type": "Row",
                "props": {
                  "crossAxisAlignment": "stretch"
                },
                "children": [
                  {
                    "id": "r2",
                    "type": "NavigationRail",
                    "props": {
                      "labelType": "all"
                    },
                    "children": [
                      {
                        "id": "r2d0",
