{
  "name": "material-scaffold-fab-starttop",
  "root": {
    "id": "frame",
    "type": "Align",
    "props": {
      "alignment": {
        "start": -1,
        "y": -1
      }
    },
    "children": [
      {
        "id": "size",
        "type": "SizedBox",
        "props": {
          "width": 320,
          "height": 560
        },
        "children": [
          {
            "id": "sc",
            "type": "Scaffold",
            "props": {
              "floatingActionButtonLocation": "startTop"
            },
            "children": [
              {
                "id": "bar",
                "type": "AppBar",
                "props": {},
                "children": [
                  {
                    "id": "lead",
                    "type": "IconButton",
                    "props": {},
                    "children": [
                      {
                        "id": "leadi",
                        "type": "Icon",
                        "props": {}
                      }
                    ],
                    "slot": "leading"
                  },
                  {
                    "id": "title",
                    "type": "Text",
                    "props": {
                      "text": "Inbox"
                    },
                    "slot": "title"
                  }
                ],
                "slot": "appBar"
              },
              {
                "id": "body",
                "type": "Text",
                "props": {
                  "text": "Body text"
                }
              },
              {
                "id": "fab",
                "type": "FloatingActionButton",
                "props": {},
                "children": [
                  {
                    "id": "fabi",
                    "type": "Icon",
                    "props": {}
                  }
                ],
                "slot": "floatingActionButton"
              },
              {
                "id": "nav",
                "type": "SizedBox",
                "props": {
                  "height": 80
                },
                "slot": "bottomNavigationBar"
              }
            ]
          }
        ]
      }
    ]
  }
}
