{
  "name": "cupertino-action-sheet-title-only",
  "root": {
    "id": "sheet",
    "type": "CupertinoActionSheet",
    "props": {},
    "children": [
      {
        "id": "sheet-title",
        "type": "CupertinoSlot",
        "props": {
          "slot": "title"
        },
        "children": [
          {
            "id": "sheet-title-text",
            "type": "Text",
            "props": {
              "text": "Photo"
            }
          }
        ]
      },
      {
        "id": "sheet-a0",
        "type": "CupertinoActionSheetAction",
        "props": {},
        "children": [
          {
            "id": "sheet-a0-text",
            "type": "Text",
            "props": {
              "text": "Take photo"
            }
          }
        ]
      },
      {
        "id": "sheet-cancel",
        "type": "CupertinoSlot",
        "props": {
          "slot": "cancelButton"
        },
        "children": [
          {
            "id": "sheet-cancel-action",
            "type": "CupertinoActionSheetAction",
            "props": {
              "isDefaultAction": true
