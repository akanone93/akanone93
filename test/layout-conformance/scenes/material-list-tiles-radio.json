{
  "name": "material-list-tiles-radio",
  "root": {
    "id": "frame",
    "type": "Align",
    "props": {
      "alignment": {
        "start": -1,
        "y": -1
      }
    },
    "children": [
      {
        "id": "col",
        "type": "Column",
        "props": {
          "crossAxisAlignment": "start",
          "mainAxisSize": "min"
        },
        "children": [
          {
            "id": "radio",
            "type": "RadioListTile",
            "props": {
              "selected": true
            },
            "children": [
              {
                "id": "radio-t",
                "type": "Text",
                "props": {
                  "text": "Notifications"
                },
                "slot": "title"
              },
              {
                "id": "radio-s",
                "type": "Text",
                "props": {
                  "text": "Receive alerts and a weekly summary"
                },
                "slot": "subtitle"
              }
            ]
          },
          {
            "id": "radio-plain",
            "type": "RadioListTile",
            "props": {},
            "children": [
              {
                "id": "radio-plain-t",
                "type": "Text",
                "props": {
                  "text": "Notifications"
                },
                "slot": "title"
              }
            ]
          },
          {
            "id": "radio-three",
            "type": "RadioListTile",
            "props": {
              "isThreeLine": true
            },
            "children": [
              {
                "id": "radio-three-t",
                "type": "Text",
                "props": {
                  "text": "Notifications"
                },
                "slot": "title"
              },
              {
                "id": "radio-three-s",
                "type": "Text",
                "props": {
                  "text": "Receive alerts and a weekly summary"
                },
                "slot": "subtitle"
              }
            ]
          }
        ]
      }
    ]
  }
}
