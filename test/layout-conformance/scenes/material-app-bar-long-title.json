{
  "name": "material-app-bar-long-title",
  "root": {
    "id": "frame",
    "type": "Align",
    "props": {
      "alignment": {
        "start": -1,
        "y": -1
      }
    },
    "children": [
      {
        "id": "size",
        "type": "SizedBox",
        "props": {
          "width": 320,
          "height": 560
        },
        "children": [
          {
            "id": "sc",
            "type": "Scaffold",
            "props": {},
            "children": [
              {
                "id": "bar",
                "type": "AppBar",
                "props": {},
                "children": [
                  {
                    "id": "lead",
                    "type": "IconButton",
                    "props": {},
                    "children": [
                      {
                        "id": "leadi",
                        "type": "Icon",
                        "props": {}
                      }
                    ],
                    "slot": "leading"
                  },
                  {
                    "id": "title",
                    "type": "Text",
                    "props": {
                      "text": "A very long title that cannot fit in the toolbar of this narrow screen"
                    },
                    "slot": "title"
                  },
                  {
                    "id": "act1",
                    "type": "IconButton",
                    "props": {},
                    "children": [
                      {
                        "id": "act1i",
                        "type": "Icon",
                        "props": {}
                      }
                    ],
                    "slot": "actions"
                  },
                  {
                    "id": "act2",
                    "type": "IconButton",
                    "props": {},
                    "children": [
                      {
                        "id": "act2i",
                        "type": "Icon",
                        "props": {}
                      }
                    ],
                    "slot": "actions"
                  }
                ],
                "slot": "appBar"
              },
              {
                "id": "body",
                "type": "Text",
                "props": {
                  "text": "Body text"
                }
              }
            ]
          }
        ]
      }
    ]
  }
}
