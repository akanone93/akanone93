{
  "dataSources": [
    {
      "config": {
        "baseUrl": "apiBaseUrl",
        "params": {
          "id": {
            "$expr": "params.id"
          }
        },
        "path": "/products/{id}"
      },
      "id": "01d0c450-6c00-7000-8000-000000000324",
      "kind": "rest",
      "mock": {
        "category": "Fruit",
        "id": "p-001",
        "name": "Product 01",
        "priceCents": 199
      },
      "name": "product",
      "type": "Product"
    }
  ],
  "id": "01d0c450-6c00-7000-8000-000000000311",
  "key": "product",
  "kind": "page",
  "pageKind": "screen",
  "params": [
    {
      "mock": "p-001",
      "name": "id",
      "required": true,
      "type": "string"
    }
  ],
  "root": {
    "id": "01d0c450-6c00-7000-8000-00000000301e",
    "slots": {
      "appBar": {
        "id": "01d0c450-6c00-7000-8000-00000000301d",
        "slots": {
          "actions": [
            {
              "events": {
                "onPressed": {
                  "steps": [
                    {
                      "action": "navigate",
                      "id": "go",
                      "input": {
                        "route": "cart"
                      }
                    }
                  ]
                }
              },
              "id": "01d0c450-6c00-7000-8000-000000003019",
              "slots": {
                "child": {
                  "id": "01d0c450-6c00-7000-8000-000000003018",
                  "props": {
                    "data": {
                      "$expr": "\"Cart (\" + string(size(plugin.cartIds)) + \")\""
                    }
                  },
                  "type": "Text"
                }
              },
              "testId": "open-cart",
              "type": "TextButton"
            },
            {
              "events": {
                "onPressed": {
                  "steps": [
                    {
                      "action": "navigate",
                      "id": "go",
                      "input": {
                        "route": "courier"
                      }
                    }
                  ]
                }
              },
              "id": "01d0c450-6c00-7000-8000-00000000301b",
              "slots": {
                "child": {
                  "id": "01d0c450-6c00-7000-8000-00000000301a",
                  "props": {
                    "data": {
                      "$t": "01a14cd1-ca0f-72e8-b478-3f9258d8f480"
                    }
                  },
                  "type": "Text"
                }
              },
              "testId": "open-courier",
              "type": "TextButton"
            }
          ],
          "title": {
            "id": "01d0c450-6c00-7000-8000-00000000301c",
            "props": {
              "data": {
                "$t": "01a14cd1-ca0f-707c-9f55-7bc395344043"
              }
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01d0c450-6c00-7000-8000-000000003017",
        "props": {
          "padding": {
            "all": 24.0
          }
        },
        "slots": {
          "child": {
            "children": [
              {
                "id": "01d0c450-6c00-7000-8000-00000000300f",
                "props": {
                  "data": {
                    "$expr": "data.product.value?.name ?? \"Loading\""
                  }
                },
                "testId": "product-name",
                "type": "Text"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000003010",
                "props": {
                  "data": {
                    "$expr": "data.product.value?.category ?? \"\""
                  }
                },
                "type": "Text"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000005008",
                "props": {
                  "price": {
                    "$expr": "money(string(div(decimal(data.product.value?.priceCents ?? 0), 100d, 2)), \"EUR\")"
                  }
                },
                "testId": "product-price",
                "type": "PriceTag"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000003012",
                "props": {
                  "height": 12.0
                },
                "type": "SizedBox"
              },
              {
                "events": {
                  "onChanged": {
                    "steps": [
                      {
                        "action": "setState",
                        "id": "write",
                        "input": {
                          "path": "page.quantity",
                          "value": {
                            "$expr": "event"
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01d0c450-6c00-7000-8000-000000005009",
                "props": {
                  "decreaseLabel": {
                    "$t": "01d0c450-6c00-7000-8000-000000009004"
                  },
                  "increaseLabel": {
                    "$t": "01d0c450-6c00-7000-8000-000000009005"
                  },
                  "max": 9,
                  "min": 1,
                  "value": {
                    "$expr": "page.quantity"
                  }
                },
                "semantics": {
                  "label": {
                    "$t": "01d0c450-6c00-7000-8000-000000009006"
                  }
                },
                "testId": "quantity",
                "type": "QuantityStepper"
              },
              {
                "events": {
                  "onPressed": {
                    "steps": [
                      {
                        "action": "forEach",
                        "branches": {
                          "body": "ids"
                        },
                        "id": "each",
                        "input": {
                          "items": {
                            "$expr": "slice([\"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\", \"\"], 0, page.quantity)"
                          }
                        }
                      },
                      {
                        "action": "setState",
                        "id": "ids",
                        "input": {
                          "path": "plugin.cartIds",
                          "value": {
                            "$expr": "plugin.cartIds + [params.id]"
                          }
                        },
                        "next": "names"
                      },
                      {
                        "action": "setState",
                        "id": "names",
                        "input": {
                          "path": "plugin.cartNames",
                          "value": {
                            "$expr": "plugin.cartNames + [data.product.value?.name ?? params.id]"
                          }
                        },
                        "next": "prices"
                      },
                      {
                        "action": "setState",
                        "id": "prices",
                        "input": {
                          "path": "plugin.cartPrices",
                          "value": {
                            "$expr": "plugin.cartPrices + [data.product.value?.priceCents ?? 0]"
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01d0c450-6c00-7000-8000-000000003014",
                "slots": {
                  "child": {
                    "id": "01d0c450-6c00-7000-8000-000000003013",
                    "props": {
                      "data": {
                        "$t": "01a14cd1-ca0f-7227-a2d6-8e227e3f845a"
                      }
                    },
                    "type": "Text"
                  }
                },
                "testId": "add-to-cart",
                "type": "FilledButton"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000003015",
                "props": {
                  "data": {
                    "$expr": "\"In cart: \" + string(size(plugin.cartIds))"
                  }
                },
                "testId": "in-cart",
                "type": "Text"
              }
            ],
            "id": "01d0c450-6c00-7000-8000-000000003016",
            "props": {
              "crossAxisAlignment": "stretch"
            },
            "type": "Column"
          }
        },
        "type": "Padding"
      }
    },
    "type": "Scaffold"
  },
  "route": "product",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": 1,
      "id": "01d0c450-6c00-7000-8000-00000000500a",
      "name": "quantity",
      "type": "int"
    }
  ],
  "title": {
    "$t": "01a14cd1-ca0f-77ba-b173-6385523045e3"
  }
}
