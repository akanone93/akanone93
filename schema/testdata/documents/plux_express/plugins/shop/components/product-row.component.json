{
  "id": "01d0c450-6c00-7000-8000-000000000350",
  "key": "product-row",
  "kind": "component",
  "name": "Product row",
  "props": [
    {
      "name": "item",
      "required": true,
      "type": "Product"
    }
  ],
  "root": {
    "events": {
      "onAddToCart": {
        "steps": [
          {
            "action": "navigate",
            "id": "go",
            "input": {
              "params": {
                "id": {
                  "$expr": "props.item.id"
                }
              },
              "route": "product"
            }
          }
        ]
      },
      "onTap": {
        "steps": [
          {
            "action": "navigate",
            "id": "go",
            "input": {
              "params": {
                "id": {
                  "$expr": "props.item.id"
                }
              },
              "route": "product"
            }
          }
        ]
      }
    },
    "id": "01d0c450-6c00-7000-8000-000000005001",
    "props": {
      "addToCartLabel": {
        "$t": "01a14cd1-ca0f-7227-a2d6-8e227e3f845a"
      },
      "badge": {
        "$expr": "props.item.category"
      },
      "price": {
        "$expr": "string(div(decimal(props.item.priceCents), 100d, 2)) + \" EUR\""
      },
      "title": {
        "$expr": "props.item.name"
      }
    },
    "type": "ProductCard"
  },
  "schemaVersion": "1.0.0",
  "version": 1
}
