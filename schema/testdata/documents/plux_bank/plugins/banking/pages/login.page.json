{
  "forms": [
    {
      "fields": [
        {
          "initial": "",
          "name": "username",
          "type": "string",
          "validators": [
            {
              "kind": "required",
              "message": "Enter your username"
            }
          ]
        },
        {
          "initial": "",
          "name": "pin",
          "type": "string",
          "validators": [
            {
              "kind": "required",
              "message": "Enter your PIN"
            }
          ]
        },
        {
          "initial": "",
          "name": "otp",
          "type": "string",
          "validators": [
            {
              "kind": "required",
              "message": "Enter the code"
            }
          ]
        }
      ],
      "id": "01d0c450-6c00-7000-8000-000000000230",
      "name": "login"
    }
  ],
  "id": "01d0c450-6c00-7000-8000-000000000210",
  "key": "login",
  "kind": "page",
  "pageKind": "screen",
  "root": {
    "id": "01d0c450-6c00-7000-8000-00000000200e",
    "slots": {
      "appBar": {
        "id": "01d0c450-6c00-7000-8000-00000000200d",
        "slots": {
          "title": {
            "id": "01d0c450-6c00-7000-8000-00000000200c",
            "props": {
              "data": {
                "$t": "01d0c450-6c00-7000-8000-000000000284"
              }
            },
            "type": "Text"
          }
        },
        "type": "AppBar"
      },
      "body": {
        "id": "01d0c450-6c00-7000-8000-00000000200b",
        "props": {
          "padding": {
            "all": 24.0
          }
        },
        "slots": {
          "child": {
            "children": [
              {
                "id": "01d0c450-6c00-7000-8000-000000002000",
                "props": {
                  "data": {
                    "$t": "01d0c450-6c00-7000-8000-000000000280"
                  }
                },
                "testId": "login-title",
                "type": "Text"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002001",
                "props": {
                  "height": 12.0
                },
                "type": "SizedBox"
              },
              {
                "events": {
                  "onChanged": {
                    "steps": [
                      {
                        "action": "setState",
                        "id": "write",
                        "input": {
                          "path": "page.login.values.username",
                          "value": {
                            "$expr": "event"
                          }
                        }
                      }
                    ]
                  },
                  "onEditingComplete": {
                    "steps": [
                      {
                        "action": "setState",
                        "id": "touch",
                        "input": {
                          "path": "page.login.touched.username",
                          "value": true
                        }
                      }
                    ]
                  }
                },
                "id": "01d0c450-6c00-7000-8000-000000002002",
                "props": {
                  "decoration": {
                    "labelText": {
                      "$t": "01d0c450-6c00-7000-8000-000000000281"
                    }
                  },
                  "value": {
                    "$expr": "page.login.values.username"
                  }
                },
                "testId": "username",
                "type": "TextFormField"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002003",
                "props": {
                  "height": 8.0
                },
                "type": "SizedBox"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002100",
                "props": {
                  "data": {
                    "$t": "01d0c450-6c00-7000-8000-000000000298"
                  }
                },
                "testId": "pin-caption",
                "type": "Text"
              },
              {
                "events": {
                  "onCompleted": {
                    "steps": [
                      {
                        "action": "setState",
                        "id": "write",
                        "input": {
                          "path": "page.login.values.pin",
                          "value": {
                            "$expr": "event"
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01d0c450-6c00-7000-8000-000000002101",
                "props": {
                  "length": 6
                },
                "testId": "pin",
                "type": "SecurePinPad",
                "semantics": {
                  "label": {
                    "$t": "01d0c450-6c00-7000-8000-000000000298"
                  }
                }
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002102",
                "props": {
                  "height": 8.0
                },
                "type": "SizedBox"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002103",
                "props": {
                  "data": {
                    "$t": "01d0c450-6c00-7000-8000-000000000299"
                  }
                },
                "testId": "otp-caption",
                "type": "Text"
              },
              {
                "events": {
                  "onCompleted": {
                    "steps": [
                      {
                        "action": "setState",
                        "id": "write",
                        "input": {
                          "path": "page.login.values.otp",
                          "value": {
                            "$expr": "event"
                          }
                        }
                      }
                    ]
                  }
                },
                "id": "01d0c450-6c00-7000-8000-000000002104",
                "props": {
                  "length": 6
                },
                "testId": "otp",
                "type": "OtpInput",
                "semantics": {
                  "label": {
                    "$t": "01d0c450-6c00-7000-8000-000000000299"
                  }
                }
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002005",
                "props": {
                  "height": 12.0
                },
                "type": "SizedBox"
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002006",
                "props": {
                  "data": {
                    "$expr": "page.error"
                  }
                },
                "testId": "login-error",
                "type": "Text",
                "visible": {
                  "$expr": "page.error != \"\""
                }
              },
              {
                "id": "01d0c450-6c00-7000-8000-000000002007",
                "props": {
                  "height": 12.0
                },
                "type": "SizedBox"
              },
              {
                "events": {
                  "onPressed": {
                    "steps": [
                      {
                        "action": "submitForm",
                        "id": "submit",
                        "input": {
                          "form": "login"
                        },
                        "onError": "invalid",
                        "onSuccess": "call"
                      },
                      {
                        "action": "apiCall",
                        "id": "call",
                        "input": {
                          "input": {
                            "otp": {
                              "$expr": "steps.submit.output.otp"
                            },
                            "pin": {
                              "$expr": "steps.submit.output.pin"
                            },
                            "username": {
                              "$expr": "steps.submit.output.username"
                            }
                          },
                          "operation": "api.login"
                        },
                        "onError": "failed",
                        "onSuccess": "hand"
                      },
                      {
                        "action": "bankSignIn",
                        "id": "hand",
                        "input": {
                          "token": {
                            "$expr": "steps.call.output.token"
                          }
                        },
                        "next": "go"
                      },
                      {
                        "action": "navigate",
                        "id": "go",
                        "input": {
                          "mode": "replace",
                          "route": "dashboard"
                        }
                      },
                      {
                        "action": "setState",
                        "id": "failed",
                        "input": {
                          "path": "page.error",
                          "value": {
                            "$expr": "steps.call.error.status == 401 ? \"Wrong username or password.\" : \"Sign-in failed. Try again.\""
                          }
                        }
                      },
                      {
                        "action": "setState",
                        "id": "invalid",
                        "input": {
                          "path": "page.error",
                          "value": "Enter your username, PIN and code."
                        }
                      }
                    ]
                  }
                },
                "id": "01d0c450-6c00-7000-8000-000000002009",
                "slots": {
                  "child": {
                    "id": "01d0c450-6c00-7000-8000-000000002008",
                    "props": {
                      "data": {
                        "$t": "01d0c450-6c00-7000-8000-000000000283"
                      }
                    },
                    "type": "Text"
                  }
                },
                "testId": "sign-in",
                "type": "FilledButton"
              }
            ],
            "id": "01d0c450-6c00-7000-8000-00000000200a",
            "props": {
              "crossAxisAlignment": "stretch"
            },
            "type": "Column"
          }
        },
        "type": "Padding"
      }
    },
    "type": "Scaffold"
  },
  "route": "login",
  "schemaVersion": "1.0.0",
  "state": [
    {
      "default": "",
      "id": "01d0c450-6c00-7000-8000-000000000240",
      "name": "error",
      "type": "string"
    }
  ],
  "title": "Sign in",
  "security": {
    "secure": true
  }
}
