    {
      "name": "from persian with era",
      "expr": "string(fromCalendar({\"era\": 0, \"year\": 1402, \"month\": 12, \"day\": 10}, \"persian\"))",
      "value": "2024-02-29",
      "type": "string",
      "program": "AQACBnN0cmluZwIMBANkYXkCCgAAAAAAAAADZXJhAgAAAAAAAAAABW1vbnRoAgwAAAAAAAAABHllYXICegUAAAAAAAAEB3BlcnNpYW4ADgQAAAQBAElbAAJJjwAB",
      "asm": [
        "0000 CONST 0 ; map[day:10 era:0 month:12 year:1402]",
        "0003 CONST 1 ; \"persian\"",
        "0006 CALL 91 2 ; fromCalendar",
        "0010 CALL 143 1 ; string"
      ]
    },
    {
      "name": "from ethiopic without era",
      "expr": "string(fromCalendar({\"year\": n, \"month\": 6, \"day\": 21}, \"ethiopic\"))",
      "value": "2024-02-29",
      "type": "string",
      "program": "AQAGBnN0cmluZwcEBHllYXIEAW4EBW1vbnRoAgYAAAAAAAAABANkYXkCFQAAAAAAAAAECGV0aGlvcGljAQFuIAQAAAYBAAQCAAQDAAQEAAQFAEcDAAQGAElbAAJJjwAB",
      "asm": [
        "0000 CONST 0 ; \"year\"",
        "0003 LOAD_ROOT 1 ; \"n\"",
        "0006 CONST 2 ; \"month\"",
        "0009 CONST 3 ; 6",
        "0012 CONST 4 ; \"day\"",
        "0015 CONST 5 ; 21",
        "0018 NEW_MAP 3",
        "0021 CONST 6 ; \"ethiopic\"",
        "0024 CALL 91 2 ; fromCalendar",
        "0028 CALL 143 1 ; string"
      ],
      "reads": [
        "n"
      ]
    },
    {
      "name": "from ethiopic Pagume leap",
      "expr": "string(fromCalendar({\"year\": 2015, \"month\": 13, \"day\": 6}, \"ethiopic\"))",
      "value": "2023-09-11",
      "type": "string",
      "program": "AQACBnN0cmluZwIMAwNkYXkCBgAAAAAAAAAFbW9udGgCDQAAAAAAAAAEeWVhcgLfBwAAAAAAAAQIZXRoaW9waWMADgQAAAQBAElbAAJJjwAB",
      "asm": [
        "0000 CONST 0 ; map[day:6 month:13 year:2015]",
        "0003 CONST 1 ; \"ethiopic\"",
        "0006 CALL 91 2 ; fromCalendar",
        "0010 CALL 143 1 ; string"
      ]
    },
    {
      "name": "round trip",
      "expr": "fromCalendar(toCalendar(day, \"persian\"), \"persian\") == day",
      "value": true,
      "type": "bool",
      "program": "AQACBGJvb2wCBANkYXkEB3BlcnNpYW4BA2RheRUGAAAEAQBJWgACBAEASVsAAgYAADU=",
      "asm": [
        "0000 LOAD_ROOT 0 ; \"day\"",
        "0003 CONST 1 ; \"persian\"",
        "0006 CALL 90 2 ; toCalendar",
        "0010 CONST 1 ; \"persian\"",
        "0013 CALL 91 2 ; fromCalendar",
        "0017 LOAD_ROOT 0 ; \"day\"",
        "0020 EQ"
      ],
      "reads": [
        "day"
      ]
    },
