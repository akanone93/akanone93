{
  "description": "The calendar group: toCalendar and fromCalendar (PXL-006, I18N-003). Expected values are Intl.DateTimeFormat's in the calendar; era is the index package l10n uses.",
  "env": {
    "roots": {
      "day": "date",
      "n": "int",
      "parts": "map<string,int>"
    }
  },
  "inputs": {
    "day": "2024-02-29",
    "n": 2016,
    "parts": {
      "day": 1,
      "month": 9,
      "year": 1445
    }
  },
  "cases": [
    {
      "name": "to ethiopic",
      "expr": "toCalendar(day, \"ethiopic\")",
      "value": {
        "era": 1,
        "year": 2016,
        "month": 6,
        "day": 21
      },
      "type": "map<string,int>",
      "program": "AQACD21hcDxzdHJpbmcsaW50PgIEA2RheQQIZXRoaW9waWMBA2RheQoGAAAEAQBJWgAC",
      "asm": [
        "0000 LOAD_ROOT 0 ; \"day\"",
        "0003 CONST 1 ; \"ethiopic\"",
        "0006 CALL 90 2 ; toCalendar"
      ],
      "reads": [
        "day"
      ]
    },
    {
      "name": "to umalqura",
      "expr": "toCalendar(day, \"islamic-umalqura\")",
      "value": {
        "era": 0,
        "year": 1445,
        "month": 8,
        "day": 19
      },
      "type": "map<string,int>",
      "program": "AQACD21hcDxzdHJpbmcsaW50PgIEA2RheQQQaXNsYW1pYy11bWFscXVyYQEDZGF5CgYAAAQBAElaAAI=",
      "asm": [
        "0000 LOAD_ROOT 0 ; \"day\"",
        "0003 CONST 1 ; \"islamic-umalqura\"",
        "0006 CALL 90 2 ; toCalendar"
      ],
      "reads": [
        "day"
      ]
    },
    {
      "name": "to persian",
      "expr": "toCalendar(day, \"persian\")",
      "value": {
        "era": 0,
        "year": 1402,
        "month": 12,
        "day": 10
