{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://plux.dev/schema/v1/canvas.schema.json",
  "title": "Plux canvas document",
  "description": "Editor-only layout of the Studio canvas: where plugin boxes and frames sit in an app, or where screens sit in a plugin (STU-032, STU-035, STU-050). It is versioned and snapshotted like any document and is never compiled into a bundle. File: `canvas.json` (app) or `plugins/<key>/canvas.json` (plugin).",
  "type": "object",
  "required": [
    "schemaVersion",
    "kind",
    "id"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "$ref": "common.schema.json#/$defs/schemaVersion"
    },
    "kind": {
      "const": "canvas"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/id"
    },
    "positions": {
      "type": "array",
      "description": "The top-left corner of each box: a plugin in an app canvas, a screen (page) in a plugin canvas. The number of entries is bounded by the limit canvas.positions.",
      "items": {
        "type": "object",
        "x-plux-type": "CanvasPosition",
        "required": [
          "id",
          "x",
          "y"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id",
            "description": "The id of the plugin or page the box shows."
          },
          "x": {
            "$ref": "#/$defs/worldUnit"
          },
          "y": {
            "$ref": "#/$defs/worldUnit"
          }
        },
        "patternProperties": {
          "^x-": true
        },
        "additionalProperties": false
      }
    },
    "frames": {
      "type": "array",
      "description": "Labelled groups of plugins (STU-035), for example \"Onboarding\" or \"Payments\". Only app canvases carry frames. The number of entries is bounded by the limit canvas.frames.",
      "items": {
        "type": "object",
        "x-plux-type": "CanvasFrame",
        "required": [
          "id",
          "label",
          "x",
          "y",
          "width",
          "height"
        ],
        "properties": {
          "id": {
            "$ref": "common.schema.json#/$defs/id"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "x": {
            "$ref": "#/$defs/worldUnit"
          },
          "y": {
            "$ref": "#/$defs/worldUnit"
          },
          "width": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "height": {
            "type": "number",
            "minimum": 1,
            "maximum": 1000000
          },
          "members": {
            "type": "array",
            "description": "The ids of the plugins in the frame. The number of entries is bounded by the limit canvas.frameMembers.",
            "items": {
              "$ref": "common.schema.json#/$defs/id"
            },
            "uniqueItems": true
          }
        },
        "patternProperties": {
          "^x-": true
        },
        "additionalProperties": false
      }
    }
  },
  "patternProperties": {
    "^x-": true
  },
  "additionalProperties": false,
  "$defs": {
    "worldUnit": {
      "type": "number",
      "minimum": -1000000,
      "maximum": 1000000,
      "description": "A coordinate in canvas world units."
    }
  }
}
