{
  "$schema": "../../json/registry/widget-descriptor.schema.json",
  "type": "PaymentCard",
  "id": 170,
  "layer": 2,
  "phase": "P5",
  "revision": 1,
  "revisions": [
    {
      "revision": 1,
      "runtime": "0.5.0"
    }
  ],
  "category": "commerce",
  "icon": "credit_card",
  "description": "A payment card: brand, masked number, expiry and holder; flipping shows the back.",
  "platforms": [
    "android",
    "ios"
  ],
  "cost": 90,
  "accessibility": {
    "role": "button",
    "interactive": true,
    "minTarget": true
  },
  "props": [
    {
      "name": "brand",
      "id": 1,
      "type": "CardBrand",
      "default": "other",
      "description": "The card network."
    },
    {
      "name": "maskedNumber",
      "id": 2,
      "type": "string",
      "required": true,
      "description": "The card number, masked."
    },
    {
      "name": "expiry",
      "id": 3,
      "type": "string",
      "required": true,
      "description": "The expiry, as printed."
    },
    {
      "name": "holder",
      "id": 4,
      "type": "string",
      "required": true,
      "description": "The holder's name."
    },
    {
      "name": "flipped",
      "id": 5,
      "type": "bool",
      "default": false,
      "description": "Whether the back is shown."
    },
    {
      "name": "backLabel",
      "id": 6,
      "type": "string?",
      "translatable": true,
      "description": "The text on the back."
    }
  ],
  "events": [
    {
      "name": "onFlip",
      "id": 1,
      "payload": "bool",
      "description": "Fires with the side the person asked for."
    }
  ]
}
