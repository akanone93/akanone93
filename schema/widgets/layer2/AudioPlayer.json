{
  "$schema": "../../json/registry/widget-descriptor.schema.json",
  "type": "AudioPlayer",
  "id": 204,
  "layer": 2,
  "phase": "P5",
  "revision": 1,
  "revisions": [
    {
      "revision": 1,
      "runtime": "0.5.0"
    }
  ],
  "category": "display",
  "icon": "headphones",
  "description": "Audio from an https address with play and pause and a progress bar. It never starts by itself under reduce motion.",
  "platforms": [
    "android",
    "ios"
  ],
  "cost": 1000,
  "accessibility": {
    "role": "group",
    "interactive": true,
    "minTarget": true
  },
  "package": "plux_player",
  "props": [
    {
      "name": "url",
      "id": 1,
      "type": "string",
      "required": true,
      "constraints": {
        "pattern": "^https://"
      },
      "description": "The https address of the audio."
    },
    {
      "name": "title",
      "id": 2,
      "type": "string?",
      "translatable": true,
      "description": "The title shown, and spoken for the player."
    },
    {
      "name": "autoplay",
      "id": 3,
      "type": "bool",
      "default": false,
      "description": "Whether it starts by itself; ignored under reduce motion."
    },
    {
      "name": "loop",
      "id": 4,
      "type": "bool",
      "default": false,
      "description": "Whether it starts again when it ends."
    },
    {
      "name": "playLabel",
      "id": 5,
      "type": "string",
      "default": "Play",
      "translatable": true,
      "description": "The play button's label."
    },
    {
      "name": "pauseLabel",
      "id": 6,
      "type": "string",
      "default": "Pause",
      "translatable": true,
      "description": "The pause button's label."
    },
    {
      "name": "positionLabel",
      "id": 7,
      "type": "string",
      "default": "Position",
      "translatable": true,
      "description": "The progress bar's label."
    }
  ],
  "events": [
    {
      "name": "onEnded",
      "id": 1,
      "description": "Fires when playback ends."
    },
    {
      "name": "onError",
      "id": 2,
      "description": "Fires when the audio cannot be played."
    }
  ]
}
