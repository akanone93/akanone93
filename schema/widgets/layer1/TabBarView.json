    },
    {
      "name": "viewportFraction",
      "id": 2,
      "type": "double",
      "default": 1.0,
      "flutter": "viewportFraction"
    }
  ],
  "events": [
    {
      "name": "onIndexChanged",
      "id": 1,
      "payload": "int"
    }
  ],
  "children": {
    "flutter": "children"
  },
  "excluded": [
