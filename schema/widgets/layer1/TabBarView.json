    }
  ],
  "flutter": {
    "library": "package:flutter/material.dart",
    "class": "TabBarView",
    "constructors": [
      ""
    ]
  },
  "category": "navigation",
  "icon": "view_carousel",
  "description": "Shows the child at `index`, and pages between children by swiping; `onIndexChanged` reports the page.",
  "platforms": [
    "android",
    "ios"
  ],
  "cost": 20,
  "accessibility": {
    "role": "group",
