      "id": 1,
      "required": true,
      "flutter": "child"
    },
    {
      "name": "background",
      "id": 2,
      "flutter": "background",
      "description": "Shown behind the child while it is swiped."
    },
    {
      "name": "secondaryBackground",
      "id": 3,
      "flutter": "secondaryBackground",
      "description": "Shown behind the child when it is swiped in the secondary direction; needs `background`."
    }
