diff --git a/studio/apps/web/src/styles/surfaces.css b/studio/apps/web/src/styles/surfaces.css
new file mode 100644
index 00000000..2c9f8c79
--- /dev/null
+++ b/studio/apps/web/src/styles/surfaces.css
@@ -0,0 +1,181 @@
+/* SPDX-FileCopyrightText: 2026 Plux contributors */
+/* SPDX-License-Identifier: AGPL-3.0-only */
+
+/*
+ * Studio's surfaces on top of shadcn's components (ADR-0103, amended 2026-10-31): a soft wash of colour behind the
+ * pages, elevation shadows for cards and popups, and frosted glass for everything that floats (the header, menus,
+ * popovers, selects, hover cards and dialogs). The components stay shadcn's; this file only styles their data-slots.
+ * The contrast theme, forced colours and reduced transparency get solid surfaces without blur.
+ */
+
+:root {
+  --link: var(--primary);
+  --elevation-1: 0 1px 2px oklch(0.25 0.04 272 / 5%), 0 2px 6px -2px oklch(0.25 0.05 272 / 8%);
+  --elevation-2: 0 1px 2px oklch(0.25 0.04 272 / 5%), 0 10px 24px -10px oklch(0.3 0.09 276 / 22%);
+  --elevation-3: 0 4px 10px -4px oklch(0.25 0.05 272 / 10%), 0 22px 48px -16px oklch(0.3 0.1 276 / 30%);
+  --glass-fill: color-mix(in oklch, var(--popover) 84%, transparent);
+  --glass-edge: color-mix(in oklch, var(--foreground) 9%, transparent);
+  --glass-blur: blur(20px) saturate(1.7);
+  --wash-1: oklch(0.7 0.17 276 / 24%);
+  --wash-2: oklch(0.74 0.16 305 / 18%);
+  --wash-3: oklch(0.8 0.12 190 / 18%);
+}
+
+[data-theme="dark"] {
+  --link: oklch(0.76 0.14 277);
+  --elevation-1: 0 1px 2px oklch(0 0 0 / 30%), 0 2px 8px -2px oklch(0 0 0 / 30%);
+  --elevation-2: 0 1px 2px oklch(0 0 0 / 30%), 0 12px 28px -10px oklch(0 0 0 / 55%);
+  --elevation-3: 0 4px 12px -4px oklch(0 0 0 / 40%), 0 24px 56px -16px oklch(0 0 0 / 65%);
+  --glass-fill: color-mix(in oklch, var(--popover) 80%, transparent);
+  --glass-edge: oklch(1 0 0 / 9%);
+  --wash-1: oklch(0.5 0.2 276 / 22%);
+  --wash-2: oklch(0.5 0.2 300 / 14%);
+  --wash-3: oklch(0.55 0.12 190 / 10%);
+}
+
+/* The page: a few soft pools of indigo, violet and teal under the content, fixed while it scrolls. */
+[data-slot="sidebar-inset"] {
+  background:
+    radial-gradient(60rem 36rem at 85% -10%, var(--wash-1), transparent 70%),
+    radial-gradient(48rem 32rem at -10% 30%, var(--wash-2), transparent 70%),
+    radial-gradient(52rem 30rem at 70% 110%, var(--wash-3), transparent 70%), var(--background);
+  background-attachment: fixed;
+}
+
+/* Cards lift off the page. */
+[data-slot="card"] {
+  box-shadow: var(--elevation-1);
+}
+
+/* What floats is frosted glass: the page shows through, blurred. */
+[data-slot="popover-content"],
+[data-slot="dropdown-menu-content"],
+[data-slot="select-content"],
+[data-slot="hover-card-content"],
+[data-slot="dialog-content"],
+[data-slot="alert-dialog-content"],
+[data-slot="sheet-content"] {
+  background-color: var(--glass-fill);
+  backdrop-filter: var(--glass-blur);
+  box-shadow:
+    0 0 0 1px var(--glass-edge),
+    var(--elevation-3);
+}
+
+/* The header stays at the top of the page, frosted over what scrolls under it. */
+.site-header {
+  background-color: color-mix(in oklch, var(--background) 70%, transparent);
+  backdrop-filter: var(--glass-blur);
+}
+
+/* The sidebar's own surface carries a hint of the same colour. */
+[data-slot="sidebar-wrapper"] {
+  background: radial-gradient(28rem 24rem at 0% 0%, var(--wash-1), transparent 70%), var(--sidebar);
+}
+
+[data-theme="contrast"] {
+  --link: oklch(0 0 0);
+  --glass-fill: var(--popover);
+  --glass-edge: var(--border);
+  --glass-blur: none;
+  --wash-1: transparent;
+  --wash-2: transparent;
+  --wash-3: transparent;
+}
+
+@media (prefers-reduced-transparency: reduce) {
+  :root {
+    --glass-fill: var(--popover);
+    --glass-blur: none;
+  }
+
+  .site-header {
+    background-color: var(--background);
+  }
+}
+
+@media (forced-colors: active) {
+  :root {
+    --glass-blur: none;
+  }
+}
+
+/* A link in running text or a table cell, written without classes, reads as a link in every theme. */
+@layer base {
+  a:not([class]) {
+    color: var(--link);
+    font-weight: 500;
+    text-underline-offset: 4px;
+  }
+
+  a:not([class]):hover,
+  a:not([class]):focus-visible {
+    text-decoration: underline;
+  }
+}
+
+/* The pages of an area, side by side: shadcn's tab strip, the current page raised. */
+.sub-nav {
+  display: inline-flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: calc(var(--spacing) * 1);
+  align-self: flex-start;
+  padding: calc(var(--spacing) * 1);
+  border-radius: var(--radius-lg);
+  background-color: var(--muted);
+}
+
+.sub-nav > a {
+  padding-block: calc(var(--spacing) * 1);
+  padding-inline: calc(var(--spacing) * 3);
+  border-radius: var(--radius-md);
+  color: var(--muted-foreground);
+  font-size: var(--text-sm);
+  font-weight: 500;
+  transition:
+    color var(--duration-fast) ease,
+    background-color var(--duration-fast) ease;
+}
+
+.sub-nav > a:hover {
+  color: var(--foreground);
+}
+
+.sub-nav > a[data-status="active"] {
+  color: var(--foreground);
+  background-color: var(--background);
+  box-shadow: var(--elevation-1);
+}
+
+/*
+ * The native controls a few dense editors keep (checkboxes, radios, ranges, file pickers) take the theme's primary
+ * colour and shadcn's sizes, so they read as part of the same set as the shadcn components beside them.
+ */
+@layer base {
+  input[type="checkbox"],
+  input[type="radio"],
+  input[type="range"] {
+    accent-color: var(--primary);
+  }
+
+  input[type="checkbox"],
+  input[type="radio"] {
+    inline-size: calc(var(--spacing) * 4);
+    block-size: calc(var(--spacing) * 4);
+    cursor: pointer;
+  }
+
+  input[type="file"]::file-selector-button {
+    margin-inline-end: calc(var(--spacing) * 3);
+    padding-block: calc(var(--spacing) * 1);
+    padding-inline: calc(var(--spacing) * 3);
+    border: 1px solid var(--border);
+    border-radius: var(--radius-md);
+    background-color: var(--background);
+    color: var(--foreground);
+    font-size: var(--text-sm);
+    font-weight: 500;
+    cursor: pointer;
+  }
+}
