@@ -0,0 +1,120 @@
+/* SPDX-FileCopyrightText: 2026 Plux contributors */
+/* SPDX-License-Identifier: AGPL-3.0-only */
+
+/*
+ * The app canvas (STU-030): the scene fills the window and the chrome floats over it as frosted glass panels (the
+ * `.glass` surface of surfaces.css), at the corners and sides, so the plugins stay visible, blurred, under every panel.
+ */
+
+.app-canvas {
+  background-color: var(--background);
+}
+
+/* The chrome: a top row, the side panels between, a bottom row. Only the panels take the pointer. */
+.canvas-chrome {
+  grid-template-rows: auto minmax(0, 1fr) auto;
+  gap: calc(var(--spacing) * 3);
+}
+
+.canvas-panel {
+  pointer-events: auto;
+  border-radius: var(--radius-xl);
+}
+
+/* The side panels stop short of the bottom row and scroll inside. */
+.canvas-middle > .canvas-panel {
+  max-block-size: 100%;
+}
+
+.canvas-inspector {
+  margin-inline-start: auto;
+}
+
+/* The pointer says what a press does: a hand for the hand tool or Space held, a closed hand while panning. */
+.app-canvas[data-tool="hand"] canvas,
+.app-canvas canvas[data-space] {
+  cursor: grab;
+}
+
+.app-canvas canvas[data-panning] {
+  cursor: grabbing;
+}
+
+/* The plugin's solid mark in its detail panel. */
+.canvas-plugin-icon {
+  display: inline-grid;
+  place-items: center;
+  flex-shrink: 0;
+  inline-size: calc(var(--spacing) * 9);
+  block-size: calc(var(--spacing) * 9);
+  border-radius: var(--radius-lg);
+  color: var(--primary-foreground);
+  background-color: var(--primary);
+  box-shadow:
+    inset 0 1px 0 0 oklch(1 0 0 / 25%),
+    var(--elevation-1);
+}
+
+/* A row of the plugins panel; the current one is marked like the sidebar's. */
+.canvas-layer {
+  color: var(--foreground);
+  transition: background-color var(--duration-fast) ease;
+}
+
+.canvas-layer:hover {
+  background-color: color-mix(in oklch, var(--foreground) 6%, transparent);
+}
+
+.canvas-layer:focus-visible {
+  outline: 2px solid var(--ring);
+  outline-offset: -2px;
+}
+
+.canvas-layer[aria-selected="true"] {
+  color: var(--accent-foreground);
+  background-color: var(--accent);
+}
+
+/* The state dot of a row: small and solid, in the status colours. */
+.canvas-layer-dot {
+  inline-size: calc(var(--spacing) * 2);
+  block-size: calc(var(--spacing) * 2);
+  flex-shrink: 0;
+  border-radius: 999px;
+  background-color: var(--color-success);
+}
+
+.canvas-layer-dot[data-state="warning"] {
+  background-color: var(--color-warning);
+}
+
+.canvas-layer-dot[data-state="danger"] {
+  background-color: var(--color-danger);
+}
+
+.canvas-layer-dot[data-state="archived"] {
+  background-color: var(--muted-foreground);
+}
+
+.canvas-layer[data-native] .canvas-layer-dot {
+  background-color: var(--chart-2);
+}
+
+/* The frames' edit buttons in the plugins panel read as rows. */
+.canvas-frames > button {
+  justify-content: flex-start;
+}
+
+/* The marquee: a rectangle in view pixels, placed by the page's variables (screen space has no writing direction). */
+.canvas-marquee {
+  position: absolute;
+  /* Pointer positions are physical in either direction, so the marquee is placed from the physical top left. */
+  inset: 0 auto auto 0;
+  inline-size: calc(var(--w) * 1px);
