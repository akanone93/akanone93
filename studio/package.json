{
  "name": "plux-studio",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "biome ci . && bun run typecheck && bun run test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p packages/ui && tsc -p apps/web && tsc -p apps/bff",
    "test": "bun test ./apps ./packages ./scripts ./lint",
    "dev": "bun run --filter @plux/web dev",
    "build": "bun run --filter @plux/web build",
    "size": "bun scripts/bundle-size.ts",
    "gen:theme": "bun scripts/gen-theme.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "2.5.15",
    "@bufbuild/protoc-gen-es": "2.16.0",
    "@lingui/format-po": "6.10.1",
    "@happy-dom/global-registrator": "21.0.4",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.3",
    "@types/bun": "1.4.2",
    "happy-dom": "21.0.4",
    "impeccable": "4.7.0",
    "typescript": "7.0.2"
  }
}
