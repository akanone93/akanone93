{
  "name": "plux-studio",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "biome ci . && bun run typecheck && bun test",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc -p tsconfig.json && tsc -p apps/web && tsc -p apps/bff",
    "test": "bun test",
    "dev": "bun run --filter @plux/web dev",
    "build": "bun run --filter @plux/web build",
    "size": "bun scripts/bundle-size.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/bun": "1.4.2",
    "typescript": "7.0.2"
  }
}
