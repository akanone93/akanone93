language js(typescript, jsx)

or {
  `$target.innerHTML = $_` as $n,
  `$target.outerHTML = $_` as $n,
  `$_.insertAdjacentHTML($...)` as $n,
  `document.write($...)` as $n,
  `document.writeln($...)` as $n,
  `new Function($...)` as $n
} where {
  register_diagnostic(span=$n, message="Studio never builds HTML or code from strings (studio-development 11.1, 11.2).", severity="error")
}
