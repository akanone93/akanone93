      "name": "loan.calculateSchedule",
      "inputSchema": "{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"description\":\"Loan terms.\",\"properties\":{\"annualRate\":{\"description\":\"Yearly interest rate as a fraction from 0 to 1, a decimal string.\",\"type\":\"string\"},\"months\":{\"description\":\"Term in months, 1 to 360.\",\"format\":\"uint32\",\"maximum\":360,\"minimum\":1,\"type\":\"integer\"},\"principal\":{\"description\":\"Amount borrowed, a decimal string, at least 1000.\",\"type\":\"string\"}},\"required\":[\"principal\",\"annualRate\",\"months\"],\"title\":\"Input\",\"type\":\"object\"}",
